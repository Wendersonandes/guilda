<%# locals: (parent_activity:, comment:) %>
<% is_persisted = comment.persisted? %>
<% url = is_persisted ? comment_path(comment.short_id) : activity_comments_path(parent_activity) %>
<% method = is_persisted ? :patch : :post %>
<% editor_controllers = feature_enabled?(:mentions) ? "comment-form mention" : "comment-form" %>
<% editor_actions = feature_enabled?(:mentions) ? "submit->mention#sync turbo:submit-end->comment-form#reset turbo:submit-end->mention#clear" : "turbo:submit-end->comment-form#reset" %>

<div class="comment_form_container bg-stone-50 border border-stone-border rounded-lg p-3 mt-3">
  <%= form_with(model: comment, url: url, method: method, class: "space-y-3", data: { controller: editor_controllers, action: editor_actions }) do |f| %>
    <% if comment.errors.any? %>
      <div class="text-xs text-red-500 font-medium">
        <%= comment.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <div>
      <%= f.hidden_field :text, data: { comment_form_target: "textarea", mention_target: "hiddenInput" } %>
      <div data-mention-target="editor"
           data-action="input->mention#sync blur->mention#sync"
           contenteditable="true"
           placeholder="<%= is_persisted ? t(".edit_placeholder") : t(".new_placeholder") %>"
           class="w-full p-2.5 text-sm text-charcoal bg-white rounded-lg border border-stone-300 focus:ring-1 focus:ring-charcoal focus:border-charcoal focus:outline-none min-h-[60px] max-h-[150px] overflow-y-auto empty:before:content-[attr(placeholder)] empty:before:text-zinc-400 empty:before:pointer-events-none empty:before:block">
        <%= render_editor_mentions(comment.activity_object) if is_persisted %>
      </div>
    </div>
    <div class="flex items-center gap-2">
      <%= f.submit is_persisted ? t(".update") : t(".comment"),
                   class: "px-3.5 py-1.5 text-xs font-semibold text-white bg-charcoal hover:bg-zinc-800 rounded-lg cursor-pointer transition-colors" %>
      
      <% if is_persisted || parent_activity.parent_id.present? %>
        <%= button_tag t(".cancel"),
                       type: "button",
                       class: "px-3.5 py-1.5 text-xs font-semibold text-zinc-600 bg-white border border-stone-300 rounded-lg hover:bg-stone-50 cursor-pointer transition-colors",
                       data: { action: "comment-form#cancel" } %>
      <% end %>
    </div>
  <% end %>
</div>
