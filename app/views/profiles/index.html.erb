<% content_for :no_sidebar, true %>
<%= content_for :title, "Artists & Suppliers" %>

<div class="max-w-6xl mx-auto space-y-8">
  <!-- Header -->
  <div class="text-center max-w-xl mx-auto space-y-2">
    <h1 class="text-3xl font-serif font-bold text-charcoal tracking-tight">Artists & Suppliers</h1>
    <p class="text-sm text-zinc-500">Discover curatorship, expography, design, project writing, and artistic production professionals to build your team.</p>
  </div>

  <!-- Search Bar -->
  <div class="max-w-md mx-auto">
    <%= form_with url: profiles_path, method: :get, class: "flex gap-2", data: { turbo_frame: "profiles_grid", turbo_action: "advance" } do |f| %>
      <%= f.text_field :q, value: params[:q], placeholder: "Search by name, location, keyword...", 
            class: "w-full rounded-lg border border-stone-300 px-3.5 py-2 text-sm bg-white text-charcoal placeholder-zinc-400 focus:outline-none focus:ring-1 focus:ring-charcoal focus:border-charcoal transition-shadow shadow-sm" %>
      <%= f.submit "Search", class: "bg-charcoal hover:bg-zinc-800 text-white px-4 py-2 rounded-lg text-sm font-semibold transition-colors cursor-pointer shadow-sm" %>
    <% end %>
  </div>

  <!-- Profiles Grid -->
  <%= turbo_frame_tag "profiles_grid" do %>
    <% if @profiles.any? %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-6">
        <% @profiles.each do |profile| %>
          <div class="bg-white rounded-lg border border-stone-border overflow-hidden flex flex-col justify-between hover:shadow-md transition-all duration-200">
            <div>
              <!-- Cover image or placeholder -->
              <% if profile.actor.cover_image.attached? %>
                <%= image_tag profile.actor.cover_image.variant(:thumb), class: "w-full h-24 object-cover border-b border-stone-border" %>
              <% else %>
                <div class="w-full h-24 bg-stone-50 border-b border-stone-border flex items-center justify-center text-zinc-300">
                  <i data-lucide="image" class="w-6 h-6"></i>
                </div>
              <% end %>

              <div class="p-5 pt-0 relative flex flex-col">
                <!-- Avatar shifted up -->
                <div class="-mt-8 w-16 h-16 rounded-full bg-white p-1 overflow-hidden border border-stone-border shadow-sm flex-shrink-0 mb-3">
                  <% if profile.actor.avatar.attached? %>
                    <%= image_tag profile.actor.avatar.variant(:thumb), class: "w-full h-full rounded-full object-cover" %>
                  <% else %>
                    <div class="w-full h-full rounded-full bg-stone-100 text-charcoal flex items-center justify-center text-lg font-bold">
                      <%= profile.name.first.upcase %>
                    </div>
                  <% end %>
                </div>

                <!-- Text info -->
                <div class="space-y-1">
                  <h2 class="text-base font-serif font-bold text-charcoal truncate">
                    <%= link_to profile.name, public_path_for(profile.actor), class: "hover:text-brand transition-colors", data: { turbo_frame: "_top" } %>
                  </h2>
                  
                  <% if profile.actor.description.present? %>
                    <p class="text-xs text-zinc-600 line-clamp-2 min-h-[2rem] leading-relaxed"><%= profile.actor.description %></p>
                  <% else %>
                    <p class="text-xs text-zinc-400 italic min-h-[2rem] leading-relaxed">No biography provided.</p>
                  <% end %>

                  <!-- Location & Website -->
                  <% if profile.city.present? || profile.state.present? || profile.website.present? %>
                    <div class="flex flex-wrap gap-x-3 gap-y-1 pt-1.5 text-[11px] font-medium text-zinc-500">
                      <% if profile.city.present? || profile.state.present? %>
                        <span class="flex items-center gap-1.5">
                          <i data-lucide="map-pin" class="w-3 h-3 text-zinc-400"></i>
                          <%= [profile.city, profile.state].reject(&:blank?).join(", ") %>
                        </span>
                      <% end %>
                      <% if profile.website.present? %>
                        <span class="flex items-center gap-1.5">
                          <i data-lucide="link" class="w-3 h-3 text-zinc-400"></i>
                          <%= link_to profile.website.sub(/\Ahttps?:\/\/(www\.)?/, ""), profile.website, target: "_blank", rel: "noopener", class: "text-brand hover:text-brand-hover hover:underline truncate max-w-[120px]" %>
                        </span>
                      <% end %>
                    </div>
                  <% end %>

                  <!-- Stats -->
                  <div class="flex gap-3 pt-1.5 text-[10px] text-zinc-400 font-medium">
                    <span class="flex items-center gap-1"><i data-lucide="file-text" class="w-3 h-3"></i> <%= profile.actor.authored_activities.posts.count %> posts</span>
                    <% if profile.actor.sent_active_contact_ids.any? %>
                      <span class="flex items-center gap-1"><i data-lucide="users" class="w-3 h-3"></i> <%= profile.actor.sent_active_contact_ids.size %> connections</span>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>

            <!-- Footer Action Panel -->
            <div class="p-5 pt-3 border-t border-stone-100 bg-stone-50/30 flex items-center justify-between">
              <%= link_to "View Profile", public_path_for(profile.actor), class: "text-xs font-semibold text-zinc-600 hover:text-charcoal transition-colors", data: { turbo_frame: "_top" } %>
              <%= render "shared/connection_button", actor: profile.actor %>
            </div>
          </div>
        <% end %>
      </div>

      <% if @pagy.pages > 1 %>
        <div class="mt-8 flex justify-center"><%== pagy_nav(@pagy) %></div>
      <% end %>
    <% else %>
      <div class="text-center text-zinc-500 py-16 bg-white rounded-lg border border-stone-border p-8 shadow-sm mt-6 max-w-md mx-auto">
        <div class="w-12 h-12 bg-stone-50 rounded-full flex items-center justify-center mx-auto mb-3 border border-stone-100">
          <i data-lucide="users-2" class="w-6 h-6 text-zinc-400"></i>
        </div>
        <h3 class="text-base font-semibold text-charcoal">No profiles found</h3>
        <p class="text-sm text-zinc-500 mt-1 max-w-sm mx-auto">Try refining your search terms or view all registered professionals.</p>
      </div>
    <% end %>
  <% end %>
</div>
