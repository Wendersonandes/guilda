<% content_for :no_sidebar, true %>
<%= content_for :title, t(".title") %>

<div class="space-y-6 max-w-6xl mx-auto">
  <!-- Header -->
  <div class="space-y-1.5">
    <h1 class="text-3xl font-serif font-bold text-charcoal tracking-tight"><%= t(".title") %></h1>
    <p class="text-sm text-zinc-600 max-w-2xl leading-relaxed"><%= t(".subtitle") %></p>
  </div>

  <!-- Search & Filter Panel -->
  <div class="w-full">
    <%= form_with url: profiles_path, method: :get,
                  html: {
                    class: "bg-white p-4 sm:p-5 rounded-lg border border-stone-border",
                    data: {
                      controller: "filter-form",
                      turbo_frame: "profiles_grid",
                      turbo_action: "advance"
                    }
                  } do |f| %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-3 items-end">
        <!-- Search Input -->
        <div class="lg:col-span-5 space-y-1.5">
          <%= f.label :q, class: "block text-xs font-semibold text-zinc-500 uppercase tracking-wider" do %>
            <span class="flex items-center gap-1.5"><i data-lucide="search" class="w-3.5 h-3.5 text-zinc-400"></i> <%= t(".search_label") %></span>
          <% end %>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-zinc-400">
              <i data-lucide="search" class="w-4 h-4"></i>
            </div>
            <%= f.text_field :q, value: params[:q],
                             placeholder: t(".search_placeholder"),
                             autocomplete: "off",
                             class: "w-full text-sm rounded-lg border border-stone-300 bg-white pl-9 pr-3.5 py-2 text-charcoal placeholder-zinc-400 focus:outline-none focus:ring-1 focus:ring-charcoal focus:border-charcoal font-medium transition-colors",
                             data: {
                               filter_form_target: "input",
                               action: "input->filter-form#debouncedSubmit keydown.enter->filter-form#submit"
                             } %>
          </div>
        </div>

        <!-- Occupation Select -->
        <div class="lg:col-span-3 space-y-1.5">
          <%= f.label :occupation, class: "block text-xs font-semibold text-zinc-500 uppercase tracking-wider" do %>
            <span class="flex items-center gap-1.5"><i data-lucide="briefcase" class="w-3.5 h-3.5 text-zinc-400"></i> <%= t(".category_label") %></span>
          <% end %>
          <%= f.select :occupation, options_for_select([[t(".all_categories"), ""]] + @occupations, params[:occupation]), {},
                       class: "w-full text-sm rounded-lg border border-stone-300 bg-white px-3.5 py-2 text-charcoal focus:outline-none focus:ring-1 focus:ring-charcoal focus:border-charcoal font-medium transition-colors cursor-pointer",
                       data: { action: "change->filter-form#submit" } %>
        </div>

        <!-- City Select -->
        <div class="lg:col-span-2 space-y-1.5">
          <%= f.label :city, class: "block text-xs font-semibold text-zinc-500 uppercase tracking-wider" do %>
            <span class="flex items-center gap-1.5"><i data-lucide="map-pin" class="w-3.5 h-3.5 text-zinc-400"></i> <%= t(".city_label") %></span>
          <% end %>
          <%= f.select :city, options_for_select([[t(".all_cities"), ""]] + @cities, params[:city]), {},
                       class: "w-full text-sm rounded-lg border border-stone-300 bg-white px-3.5 py-2 text-charcoal focus:outline-none focus:ring-1 focus:ring-charcoal focus:border-charcoal font-medium transition-colors cursor-pointer",
                       data: { action: "change->filter-form#submit" } %>
        </div>

        <!-- Availability Select -->
        <div class="lg:col-span-2 space-y-1.5">
          <%= f.label :availability, class: "block text-xs font-semibold text-zinc-500 uppercase tracking-wider" do %>
            <span class="flex items-center gap-1.5"><i data-lucide="clock" class="w-3.5 h-3.5 text-zinc-400"></i> <%= t(".availability_label") %></span>
          <% end %>
          <%= f.select :availability,
                       options_for_select([[t(".all_availabilities"), ""]] + Profile::FILTERABLE_AVAILABILITY_OPTIONS.map { |value, label| [label, value] }, params[:availability]),
                       {},
                       class: "w-full text-sm rounded-lg border border-stone-300 bg-white px-3.5 py-2 text-charcoal focus:outline-none focus:ring-1 focus:ring-charcoal focus:border-charcoal font-medium transition-colors cursor-pointer",
                       data: { action: "change->filter-form#submit" } %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Profiles Grid Frame -->
  <%= turbo_frame_tag "profiles_grid", data: { turbo_action: "advance" } do %>
    <% has_filters = params[:q].present? || params[:occupation].present? || params[:city].present? || params[:availability].present? %>

    <!-- Status & Active Filters Bar -->
    <div class="flex flex-wrap items-center justify-between gap-3 pt-1 pb-4">
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-sm font-semibold text-charcoal">
          <%= t(".results_count", count: @pagy.count) %>
        </span>

        <% if has_filters %>
          <span class="text-zinc-300">|</span>
          <span class="text-xs text-zinc-500">Filtros ativos:</span>
          <div class="flex flex-wrap items-center gap-1.5">
            <% if params[:q].present? %>
              <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-medium bg-stone-100 text-charcoal border border-stone-200">
                "<%= params[:q] %>"
                <%= link_to profiles_path(request.query_parameters.except(:q)), class: "text-zinc-400 hover:text-charcoal ml-0.5", aria: { label: "Remover filtro de busca" }, data: { turbo_action: "advance", turbo_frame: "_top" } do %>
                  <i data-lucide="x" class="w-3 h-3"></i>
                <% end %>
              </span>
            <% end %>
            <% if params[:occupation].present? %>
              <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-medium bg-stone-100 text-charcoal border border-stone-200">
                <%= params[:occupation] %>
                <%= link_to profiles_path(request.query_parameters.except(:occupation)), class: "text-zinc-400 hover:text-charcoal ml-0.5", aria: { label: "Remover filtro de categoria" }, data: { turbo_action: "advance", turbo_frame: "_top" } do %>
                  <i data-lucide="x" class="w-3 h-3"></i>
                <% end %>
              </span>
            <% end %>
            <% if params[:city].present? %>
              <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-medium bg-stone-100 text-charcoal border border-stone-200">
                <%= params[:city] %>
                <%= link_to profiles_path(request.query_parameters.except(:city)), class: "text-zinc-400 hover:text-charcoal ml-0.5", aria: { label: "Remover filtro de cidade" }, data: { turbo_action: "advance", turbo_frame: "_top" } do %>
                  <i data-lucide="x" class="w-3 h-3"></i>
                <% end %>
              </span>
            <% end %>
            <% if params[:availability].present? %>
              <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-medium bg-stone-100 text-charcoal border border-stone-200">
                <%= Profile::FILTERABLE_AVAILABILITY_OPTIONS[params[:availability]] || params[:availability].humanize %>
                <%= link_to profiles_path(request.query_parameters.except(:availability)), class: "text-zinc-400 hover:text-charcoal ml-0.5", aria: { label: "Remover filtro de disponibilidade" }, data: { turbo_action: "advance", turbo_frame: "_top" } do %>
                  <i data-lucide="x" class="w-3 h-3"></i>
                <% end %>
              </span>
            <% end %>
          </div>
        <% end %>
      </div>

      <% if has_filters %>
        <%= link_to profiles_path, class: "inline-flex items-center gap-1 text-xs font-semibold text-zinc-500 hover:text-charcoal transition-colors", data: { turbo_action: "advance", turbo_frame: "_top" } do %>
          <i data-lucide="rotate-ccw" class="w-3 h-3"></i>
          <span><%= t(".clear_filters") %></span>
        <% end %>
      <% end %>
    </div>

    <% if @profiles.any? %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        <% @profiles.each do |profile| %>
          <div class="bg-white rounded-lg border border-stone-border overflow-hidden flex flex-col justify-between hover:border-stone-400 hover:shadow-xs transition-all duration-150 group">
            <div>
              <!-- Cover image or subtle gallery pattern -->
              <% if profile.actor.cover_image.attached? %>
                <%= image_tag profile.actor.cover_image.variant(:thumb), class: "w-full h-20 object-cover border-b border-stone-border" %>
              <% else %>
                <div class="w-full h-14 bg-stone-100 border-b border-stone-border/80" aria-hidden="true"></div>
              <% end %>

              <div class="p-5 pt-0 relative flex flex-col">
                <!-- Avatar overlapping cover -->
                <div class="-mt-7 w-14 h-14 rounded-full bg-white p-0.5 overflow-hidden border border-stone-border flex-shrink-0 mb-3">
                  <%= link_to public_path_for(profile.actor), class: "block w-full h-full rounded-full overflow-hidden focus:outline-none focus:ring-2 focus:ring-charcoal", data: { turbo_frame: "_top" }, title: profile.name do %>
                    <% if profile.actor.avatar.attached? %>
                      <%= image_tag profile.actor.avatar.variant(:thumb), class: "w-full h-full rounded-full object-cover group-hover:scale-105 transition-transform duration-200" %>
                    <% else %>
                      <div class="w-full h-full rounded-full bg-stone-100 text-charcoal flex items-center justify-center text-base font-serif font-bold">
                        <%= profile.name.first.upcase %>
                      </div>
                    <% end %>
                  <% end %>
                </div>

                <!-- Text info -->
                <div class="space-y-2">
                  <div>
                    <h2 class="text-base font-serif font-bold text-charcoal tracking-tight truncate leading-tight">
                      <%= link_to profile.name, public_path_for(profile.actor), class: "hover:text-brand transition-colors", data: { turbo_frame: "_top" } %>
                    </h2>
                    <% if profile.organization.present? %>
                      <p class="text-xs text-zinc-500 truncate mt-0.5 font-medium"><%= profile.organization %></p>
                    <% end %>
                  </div>

                  <!-- Location & Availability -->
                  <% if profile.city.present? || profile.state.present? || profile.availability.present? %>
                    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-zinc-500">
                      <% if profile.city.present? || profile.state.present? %>
                        <span class="inline-flex items-center gap-1 font-medium">
                          <i data-lucide="map-pin" class="w-3.5 h-3.5 text-zinc-400 flex-shrink-0"></i>
                          <%= [profile.city, profile.state].reject(&:blank?).join(", ") %>
                        </span>
                      <% end %>
                      <% if profile.availability.present? %>
                        <span class="inline-flex items-center gap-1.5 font-medium <%= profile.unavailable? ? 'text-zinc-500' : 'text-emerald-700' %>">
                          <span class="w-1.5 h-1.5 rounded-full <%= profile.unavailable? ? 'bg-zinc-400' : 'bg-emerald-500' %>" aria-hidden="true"></span>
                          <%= profile.availability_label %>
                        </span>
                      <% end %>
                    </div>
                  <% end %>

                  <!-- Occupations (Clickable filter pills) -->
                  <% if profile.occupations.any? %>
                    <div class="flex flex-wrap items-center gap-1.5 pt-1">
                      <% profile.occupations.each do |occupation| %>
                        <%= link_to occupation.name, profiles_path(request.query_parameters.merge(occupation: occupation.name)),
                                    class: "inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-medium bg-stone-100 hover:bg-stone-200 text-zinc-800 border border-stone-200/70 transition-colors",
                                    data: { turbo_action: "advance", turbo_frame: "_top" },
                                    title: "Filtrar por #{occupation.name}" %>
                      <% end %>
                    </div>
                  <% end %>

                  <!-- Bio description -->
                  <% if profile.actor.description.present? %>
                    <p class="text-xs text-zinc-600 line-clamp-2 min-h-[2rem] leading-relaxed pt-1">
                      <%= truncate(strip_tags(profile.actor.description.to_s), length: 130) %>
                    </p>
                  <% else %>
                    <div class="min-h-[2rem]" aria-hidden="true"></div>
                  <% end %>
                </div>
              </div>
            </div>

            <!-- Footer Action Panel -->
            <div class="px-5 py-3 border-t border-stone-100 bg-stone-50/40 flex items-center justify-between gap-3">
              <div class="min-w-0">
                <% public_projects = profile.projects.select(&:visibility_public?) %>
                <% if public_projects.any? %>
                  <span class="inline-flex items-center gap-1.5 text-xs text-zinc-600 font-medium">
                    <i data-lucide="folder" class="w-3.5 h-3.5 text-zinc-400 flex-shrink-0"></i>
                    <span><%= public_projects.size %> <%= public_projects.size == 1 ? "projeto" : "projetos" %></span>
                  </span>
                <% elsif current_actor && current_actor.id == profile.actor.id %>
                  <span class="inline-flex items-center text-xs font-semibold text-brand bg-brand/10 px-2 py-0.5 rounded">
                    <%= t(".your_profile") %>
                  </span>
                <% end %>
              </div>

              <div class="flex items-center gap-2 flex-shrink-0">
                <% if current_actor && current_actor.id == profile.actor.id %>
                  <%= link_to t(".edit_profile"), edit_my_profile_path, class: "text-xs font-semibold text-zinc-700 hover:text-charcoal transition-colors px-2 py-1 rounded hover:bg-stone-200/60", data: { turbo_frame: "_top" } %>
                <% else %>
                  <%= link_to public_path_for(profile.actor), class: "inline-flex items-center gap-1 text-xs font-semibold text-zinc-600 hover:text-charcoal transition-colors group/link", data: { turbo_frame: "_top" } do %>
                    <span><%= t(".view_profile") %></span>
                    <i data-lucide="arrow-right" class="w-3.5 h-3.5 text-zinc-400 group-hover/link:text-charcoal transition-colors" aria-hidden="true"></i>
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <% if @pagy.pages > 1 %>
        <div class="mt-8 flex justify-center"><%== pagy_nav(@pagy) %></div>
      <% end %>
    <% else %>
      <div class="text-center text-zinc-500 py-16 bg-white rounded-lg border border-stone-border p-8 mt-6 max-w-md mx-auto">
        <div class="w-12 h-12 bg-stone-50 rounded-full flex items-center justify-center mx-auto mb-3 border border-stone-100">
          <i data-lucide="search-x" class="w-6 h-6 text-zinc-400"></i>
        </div>
        <h3 class="text-base font-semibold text-charcoal"><%= t(".empty_title") %></h3>
        <p class="text-sm text-zinc-500 mt-1 max-w-sm mx-auto"><%= t(".empty_subtitle") %></p>
        <% if has_filters %>
          <div class="mt-4">
            <%= link_to profiles_path, class: "inline-flex items-center gap-1.5 text-xs font-semibold bg-charcoal hover:bg-zinc-800 text-white px-4 py-2 rounded-lg transition-colors", data: { turbo_action: "advance", turbo_frame: "_top" } do %>
              <i data-lucide="rotate-ccw" class="w-3.5 h-3.5"></i>
              <span><%= t(".view_all") %></span>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
