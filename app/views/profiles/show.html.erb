<% content_for :no_sidebar, true %>
<%= content_for :title, @actor.name %>

<%
  has_projects = feature_enabled?(:projects)
  has_feed = feature_enabled?(:social_feed)
  has_tabs = has_projects && has_feed
  default_tab = has_projects ? "portfolio" : "activity"
  own_profile = @actor == current_actor
%>

<div class="grid grid-cols-1 lg:grid-cols-12 gap-x-8 gap-y-4 sm:gap-y-5 items-start">
  <!-- 1. Left Top: Visual Frame (Full-Bleed Cover + Avatar) -->
  <div class="lg:col-span-8 min-w-0">
    <div class="relative h-60 sm:h-72 lg:h-80 rounded-lg border border-stone-border overflow-hidden bg-stone-100">
      <% if @actor.cover_image.attached? %>
        <%= image_tag @actor.cover_image.variant(:banner), alt: "", fetchpriority: "high", decoding: "async", class: "w-full h-full object-cover block" %>
      <% else %>
        <!-- Gallery-inspired Subtle Neutral Banner -->
        <div class="w-full h-full bg-stone-100" aria-hidden="true"></div>
      <% end %>

      <!-- Avatar anchored on cover (Flat Gallery Rule: ring border instead of resting drop shadow) -->
      <div class="absolute bottom-3 left-3 sm:bottom-4 sm:left-5 w-20 h-20 sm:w-24 sm:h-24 rounded-full bg-white border-2 border-white ring-1 ring-stone-border flex-shrink-0 overflow-hidden">
        <% if @actor.avatar.attached? %>
          <%= image_tag @actor.avatar.variant(:medium), alt: @actor.name, fetchpriority: "high", decoding: "async", class: "w-full h-full rounded-full object-cover" %>
        <% else %>
          <div class="w-full h-full rounded-full bg-stone-100 text-charcoal flex items-center justify-center text-2xl sm:text-3xl font-serif font-bold" aria-hidden="true">
            <%= @actor.name.first.upcase %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- 2. Right Sidebar Column: Unified Profile Dossier, Guest Box & Suggestions -->
  <aside class="lg:col-span-4 lg:col-start-9 lg:row-start-1 lg:row-span-2 min-w-0">
    <%= render "shared/right_sidebar" %>
  </aside>

  <!-- 3. Left Bottom: Portfolio & Activity Stream -->
  <div class="lg:col-span-8 space-y-6 min-w-0" <%= tag.attributes(has_tabs ? { data: { controller: "tabs", tabs_default_tab_value: default_tab } } : {}) %>>
    <!-- Navigation / Header for Portfolio & Activity -->
    <% if has_tabs %>
      <!-- Tab Navigation (when both projects and feed are enabled) -->
      <div class="border-b border-stone-border flex flex-wrap items-center justify-between gap-3">
        <div class="flex gap-4 sm:gap-6 -mb-px" role="tablist" aria-label="<%= t('.tabs_aria_label') %>">
          <button type="button"
                  id="tab-portfolio"
                  role="tab"
                  aria-controls="panel-portfolio"
                  aria-selected="<%= default_tab == 'portfolio' ? 'true' : 'false' %>"
                  tabindex="<%= default_tab == 'portfolio' ? '0' : '-1' %>"
                  data-tabs-target="tab"
                  data-tab-name="portfolio"
                  data-action="click->tabs#change keydown->tabs#keydown"
                  class="min-h-11 pt-2 pb-3 text-sm font-medium border-b-2 transition-colors cursor-pointer focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-charcoal focus-visible:ring-offset-2 <%= default_tab == 'portfolio' ? 'border-charcoal text-charcoal font-semibold' : 'border-transparent text-muted hover:text-charcoal hover:border-stone-300' %> flex items-center gap-2">
            <span><%= t(".tab_portfolio") %></span>
            <% if @projects.present? %>
              <span class="text-xs px-2 py-0.5 rounded-full bg-stone-100 text-zinc-700 font-normal"><%= @projects.size %></span>
            <% end %>
          </button>
          <button type="button"
                  id="tab-activity"
                  role="tab"
                  aria-controls="panel-activity"
                  aria-selected="<%= default_tab == 'activity' ? 'true' : 'false' %>"
                  tabindex="<%= default_tab == 'activity' ? '0' : '-1' %>"
                  data-tabs-target="tab"
                  data-tab-name="activity"
                  data-action="click->tabs#change keydown->tabs#keydown"
                  class="min-h-11 pt-2 pb-3 text-sm font-medium border-b-2 transition-colors cursor-pointer focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-charcoal focus-visible:ring-offset-2 <%= default_tab == 'activity' ? 'border-charcoal text-charcoal font-semibold' : 'border-transparent text-muted hover:text-charcoal hover:border-stone-300' %> flex items-center gap-2">
            <span><%= t(".tab_activity") %></span>
          </button>
        </div>
        <% if own_profile %>
          <%= link_to new_my_project_path, class: "mb-2 shrink-0 min-h-11 sm:min-h-0 inline-flex items-center gap-1.5 text-xs bg-charcoal text-white hover:bg-zinc-800 font-medium px-3.5 py-2.5 sm:py-2 rounded-lg transition-colors focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-charcoal focus-visible:ring-offset-2" do %>
            <i data-lucide="plus" class="w-3.5 h-3.5" aria-hidden="true"></i>
            <span><%= t(".new_project") %></span>
          <% end %>
        <% end %>
      </div>
    <% elsif has_projects %>
      <!-- Dedicated Section Header (when feed is disabled, e.g. MVP focus on portfolio) -->
      <div class="flex flex-wrap items-center justify-between gap-3 pb-2.5 border-b border-stone-border">
        <div class="flex items-center gap-2">
          <h2 id="heading-portfolio" class="font-serif font-bold text-lg text-charcoal"><%= t(".tab_portfolio") %></h2>
          <% if @projects.present? %>
            <span class="text-xs px-2 py-0.5 rounded-full bg-stone-100 text-zinc-700 font-medium"><%= @projects.size %></span>
          <% end %>
        </div>
        <% if own_profile %>
          <%= link_to new_my_project_path, class: "shrink-0 min-h-11 sm:min-h-0 inline-flex items-center gap-1.5 text-xs bg-charcoal text-white hover:bg-zinc-800 font-medium px-3.5 py-2.5 sm:py-2 rounded-lg transition-colors focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-charcoal focus-visible:ring-offset-2" do %>
            <i data-lucide="plus" class="w-3.5 h-3.5" aria-hidden="true"></i>
            <span><%= t(".new_project") %></span>
          <% end %>
        <% end %>
      </div>
    <% elsif has_feed %>
      <!-- Dedicated Section Header (when only feed is enabled) -->
      <div class="flex items-center justify-between gap-3 pb-2.5 border-b border-stone-border">
        <h2 id="heading-activity" class="font-serif font-bold text-lg text-charcoal"><%= t(".tab_activity") %></h2>
      </div>
    <% end %>

    <!-- Section 1: Portfolio / Projects -->
    <% if has_projects %>
      <section id="panel-portfolio"
               <%= tag.attributes(has_tabs ? { role: "tabpanel", aria: { labelledby: "tab-portfolio" }, data: { tabs_target: "panel", tab_panel: "portfolio" } } : { aria: { labelledby: "heading-portfolio" } }) %>
               class="space-y-4">
        <% if @projects.present? %>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <% @projects.each_with_index do |project, index| %>
              <%= link_to project_path(project), class: "group bg-white rounded-lg border border-stone-border overflow-hidden hover:border-stone-400/80 hover:shadow-sm transition-all duration-200 flex flex-col focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-charcoal focus-visible:ring-offset-2" do %>
                <div class="aspect-[4/3] bg-stone-100 overflow-hidden relative">
                  <% cover = project.cover_or_first %>
                  <% if cover&.attached? %>
                    <%= image_tag cover.variant(:thumb), alt: "", loading: (index < 2 ? "eager" : "lazy"), decoding: "async", class: "w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-200" %>
                  <% else %>
                    <div class="w-full h-full flex flex-col items-center justify-center p-4 text-center bg-stone-50 text-zinc-600" aria-hidden="true">
                      <i data-lucide="image" class="w-6 h-6 stroke-1 text-zinc-400 mb-1" aria-hidden="true"></i>
                      <span class="text-xs font-serif italic text-zinc-600 line-clamp-1"><%= project.title %></span>
                    </div>
                  <% end %>

                  <% image_count = project.project_images.size %>
                  <% if image_count > 1 %>
                    <div class="absolute bottom-2.5 right-2.5 inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-charcoal/90 text-white text-xs font-medium">
                      <i data-lucide="images" class="w-3.5 h-3.5 text-zinc-200" aria-hidden="true"></i>
                      <span aria-hidden="true"><%= image_count %></span>
                      <span class="sr-only"><%= t(".image_count", count: image_count) %></span>
                    </div>
                  <% end %>
                </div>
                <div class="p-4 space-y-1.5 flex-1 flex flex-col justify-between">
                  <div>
                    <h3 class="font-serif font-bold text-charcoal text-base truncate group-hover:text-brand transition-colors"><%= project.title %></h3>
                    <% if project.about.present? %>
                      <p class="text-xs text-muted line-clamp-2 leading-relaxed mt-1"><%= truncate(project.about.to_plain_text, length: 120) %></p>
                    <% end %>
                  </div>
                  <% if own_profile %>
                    <%
                      badge_classes = if project.visibility_draft?
                        "bg-amber-50 text-amber-800 border-amber-200/80"
                      elsif project.visibility_private?
                        "bg-zinc-100 text-zinc-700 border-zinc-300"
                      else
                        "bg-stone-100 text-zinc-700 border-stone-200"
                      end
                    %>
                    <div class="pt-2 flex items-center justify-between text-xs">
                      <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full font-medium border <%= badge_classes %>">
                        <% if project.visibility_private? %>
                          <i data-lucide="lock" class="w-3 h-3" aria-hidden="true"></i>
                        <% end %>
                        <span><%= project.visibility_label %></span>
                      </span>
                    </div>
                  <% end %>
                </div>
              <% end %>
            <% end %>
          </div>
        <% else %>
          <!-- Empty State for Projects -->
          <div class="bg-white rounded-lg border border-stone-border p-8 sm:p-12 text-center space-y-3">
            <div class="w-12 h-12 bg-stone-50 rounded-full flex items-center justify-center mx-auto border border-stone-200/60 text-zinc-500" aria-hidden="true">
              <i data-lucide="briefcase" class="w-5 h-5" aria-hidden="true"></i>
            </div>
            <h3 class="text-base font-serif font-bold text-charcoal">
              <%= own_profile ? t(".no_projects_owner_title") : t(".no_projects_visitor_title") %>
            </h3>
            <p class="text-sm text-muted max-w-sm mx-auto leading-relaxed">
              <%= own_profile ? t(".no_projects_owner_subtitle") : t(".no_projects_visitor_subtitle") %>
            </p>
            <% if own_profile %>
              <div class="pt-2">
                <%= link_to new_my_project_path, class: "min-h-11 sm:min-h-0 inline-flex items-center gap-1.5 text-xs bg-charcoal text-white hover:bg-zinc-800 font-medium px-4 py-2.5 sm:py-2 rounded-lg transition-colors focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-charcoal focus-visible:ring-offset-2" do %>
                  <i data-lucide="plus" class="w-3.5 h-3.5" aria-hidden="true"></i>
                  <span><%= t(".no_projects_owner_cta") %></span>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>
      </section>
    <% end %>

    <!-- Section 2: Activity Stream / Posts -->
    <% if has_feed %>
      <section id="panel-activity"
               <%= tag.attributes(has_tabs ? { role: "tabpanel", aria: { labelledby: "tab-activity" }, data: { tabs_target: "panel", tab_panel: "activity" } } : { aria: { labelledby: "heading-activity" } }) %>
               class="space-y-4 <%= 'hidden' if has_tabs && default_tab != 'activity' %>">
        <% if @activities.any? %>
          <%= render partial: "shared/activity", collection: @activities, as: :activity %>
          <% if @pagy.pages > 1 %>
            <div class="mt-6 flex justify-center"><%== pagy_nav(@pagy) %></div>
          <% end %>
        <% else %>
          <div class="text-center text-muted py-12 bg-white rounded-lg border border-stone-border p-6">
            <div class="w-10 h-10 bg-stone-50 rounded-full flex items-center justify-center mx-auto mb-2.5 border border-stone-100" aria-hidden="true">
              <i data-lucide="message-square" class="w-5 h-5 text-zinc-500" aria-hidden="true"></i>
            </div>
            <h3 class="text-sm font-semibold text-charcoal"><%= t(".no_posts_title") %></h3>
            <p class="text-xs text-muted mt-1 max-w-xs mx-auto"><%= t(".no_posts_subtitle") %></p>
          </div>
        <% end %>
      </section>
    <% end %>
  </div>
</div>
