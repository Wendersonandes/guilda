<%= content_for :title, "Edit Profile" %>

<div class="flex items-center gap-2 mb-4">
  <%= link_to public_path_for(current_actor), class: "text-zinc-400 hover:text-charcoal transition-colors" do %>
    <i data-lucide="arrow-left" class="w-5 h-5"></i>
  <% end %>
  <span class="text-sm font-medium text-zinc-500">Back to Profile</span>
</div>

<h1 class="text-2xl font-serif font-bold text-charcoal tracking-tight mb-6">Edit Profile</h1>

<%= form_with model: @profile, url: my_profile_path, method: :patch, class: "bg-white rounded-lg border border-stone-border p-6 space-y-6" do |f| %>
  <% if @profile.errors.any? %>
    <div class="rounded-lg bg-red-50 p-4 text-sm text-red-600 border border-red-100 mb-6">
      <ul class="list-disc pl-5">
        <% @profile.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= f.fields_for :actor do |af| %>
    <%= af.hidden_field :id %>
    
    <div class="space-y-4">
      <h3 class="text-sm font-semibold text-charcoal border-b border-stone-100 pb-2">Basic Info</h3>
      
      <div class="space-y-1">
        <%= af.label :name, class: "block text-sm font-medium text-zinc-700" %>
        <%= af.text_field :name, class: "w-full rounded-lg border border-stone-300 px-3 py-2 text-sm bg-white text-charcoal placeholder-zinc-400 focus:outline-none focus:ring-1 focus:ring-charcoal focus:border-charcoal transition-shadow" %>
      </div>

      <div class="space-y-1">
        <%= af.label :email, class: "block text-sm font-medium text-zinc-700" %>
        <%= af.email_field :email, class: "w-full rounded-lg border border-stone-300 px-3 py-2 text-sm bg-white text-charcoal placeholder-zinc-400 focus:outline-none focus:ring-1 focus:ring-charcoal focus:border-charcoal transition-shadow" %>
      </div>

      <div class="space-y-1">
        <%= af.label :description, "Bio", class: "block text-sm font-medium text-zinc-700" %>
        <%= af.text_area :description, rows: 3, placeholder: "Tell people about yourself...", class: "w-full rounded-lg border border-stone-300 px-3 py-2 text-sm bg-white text-charcoal placeholder-zinc-400 focus:outline-none focus:ring-1 focus:ring-charcoal focus:border-charcoal transition-shadow" %>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
        <!-- Avatar Upload -->
        <div class="space-y-2">
          <%= af.label :avatar, class: "block text-sm font-medium text-zinc-700" %>
          <div class="flex items-center gap-3">
            <% if @profile.actor.avatar.attached? %>
              <%= image_tag @profile.actor.avatar.variant(:thumb), class: "w-12 h-12 rounded-full object-cover border border-stone-200" %>
            <% else %>
              <div class="w-12 h-12 rounded-full bg-stone-100 text-charcoal border border-stone-border flex items-center justify-center font-bold text-base">
                <%= @profile.name.first.upcase %>
              </div>
            <% end %>
            <div class="flex-1 min-w-0">
              <%= af.file_field :avatar, accept: "image/png,image/jpeg,image/webp", class: "w-full text-xs text-zinc-500 file:mr-2 file:py-1 file:px-2.5 file:rounded-md file:border file:border-stone-250 file:text-xs file:font-semibold file:bg-stone-50 file:text-zinc-700 hover:file:bg-stone-100 cursor-pointer" %>
            </div>
          </div>
        </div>

        <!-- Cover Image Upload -->
        <div class="space-y-2">
          <%= af.label :cover_image, "Cover Image", class: "block text-sm font-medium text-zinc-700" %>
          <div class="flex items-center gap-3">
            <% if @profile.actor.cover_image.attached? %>
              <%= image_tag @profile.actor.cover_image.variant(:thumb), class: "w-12 h-8 rounded object-cover border border-stone-200" %>
            <% else %>
              <div class="w-12 h-8 rounded bg-stone-50 border border-stone-200 flex items-center justify-center text-zinc-300">
                <i data-lucide="image" class="w-4 h-4"></i>
              </div>
            <% end %>
            <div class="flex-1 min-w-0">
              <%= af.file_field :cover_image, accept: "image/png,image/jpeg,image/webp", class: "w-full text-xs text-zinc-500 file:mr-2 file:py-1 file:px-2.5 file:rounded-md file:border file:border-stone-250 file:text-xs file:font-semibold file:bg-stone-50 file:text-zinc-700 hover:file:bg-stone-100 cursor-pointer" %>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <div class="border-t border-stone-100 pt-4 space-y-4">
    <h3 class="text-sm font-semibold text-charcoal flex items-center gap-1.5 pb-1">
      <i data-lucide="map-pin" class="w-4 h-4 text-zinc-400"></i>
      <span>Location</span>
    </h3>
    <div data-controller="location" class="grid grid-cols-2 gap-4">
      <div class="space-y-1">
        <%= f.label :country, "Country", class: "block text-xs font-medium text-zinc-500" %>
        <%= f.country_select :country, { only: ["BR"] }, {
          data: { location_target: "country", action: "change->location#countryChanged" },
          class: "w-full rounded-lg border border-stone-300 px-3 py-2 text-sm bg-white text-charcoal focus:outline-none focus:ring-1 focus:ring-charcoal focus:border-charcoal"
        } %>
      </div>
      <div class="space-y-1">
        <%= f.label :state, "State", class: "block text-xs font-medium text-zinc-500" %>
        <%= f.select :state, @states || [], { include_blank: "Select", selected: state_code_for(@profile.state) }, {
          data: { location_target: "state", action: "change->location#stateChanged" },
          class: "w-full rounded-lg border border-stone-300 px-3 py-2 text-sm bg-white text-charcoal focus:outline-none focus:ring-1 focus:ring-charcoal focus:border-charcoal"
        } %>
      </div>
      <div class="space-y-1">
        <%= f.label :city, "City", class: "block text-xs font-medium text-zinc-500" %>
        <%= f.select :city, @cities || [], { include_blank: "Select" }, {
          data: { location_target: "city" },
          class: "w-full rounded-lg border border-stone-300 px-3 py-2 text-sm bg-white text-charcoal focus:outline-none focus:ring-1 focus:ring-charcoal focus:border-charcoal"
        } %>
      </div>
      <div class="space-y-1">
        <%= f.label :zipcode, "Zip Code", class: "block text-xs font-medium text-zinc-500" %>
        <%= f.text_field :zipcode, class: "w-full rounded-lg border border-stone-300 px-3 py-2 text-sm bg-white text-charcoal placeholder-zinc-400 focus:outline-none focus:ring-1 focus:ring-charcoal focus:border-charcoal" %>
      </div>
      <div class="col-span-2 space-y-1">
        <%= f.label :address, "Address", class: "block text-xs font-medium text-zinc-500" %>
        <%= f.text_field :address, class: "w-full rounded-lg border border-stone-300 px-3 py-2 text-sm bg-white text-charcoal placeholder-zinc-400 focus:outline-none focus:ring-1 focus:ring-charcoal focus:border-charcoal" %>
      </div>
    </div>
  </div>

  <div class="border-t border-stone-100 pt-4 space-y-4" data-controller="occupations">
    <div class="flex items-center justify-between pb-1">
      <h3 class="text-sm font-semibold text-charcoal flex items-center gap-1.5">
        <i data-lucide="briefcase" class="w-4 h-4 text-zinc-400"></i>
        <span>Categorias Profissionais</span>
      </h3>
      <span class="text-xs text-zinc-500">Selecione até 3 áreas de atuação</span>
    </div>
    
    <div data-occupations-target="warning" class="hidden rounded-lg bg-red-50 p-3 text-sm text-red-600 border border-red-100 transition-all">
      Você já selecionou o limite máximo de 3 categorias.
    </div>

    <div class="flex flex-wrap gap-2">
      <% Profile::OCCUPATIONS.each do |occupation| %>
        <% name = occupation["name"] %>
        <% description = occupation["description"] %>
        <label class="relative inline-flex items-center cursor-pointer group" title="<%= description %>">
          <%= f.check_box :occupation_list, 
                { multiple: true, 
                  class: "peer sr-only",
                  data: { occupations_target: "checkbox", action: "change->occupations#toggle" }
                }, 
                name, nil %>
          
          <div class="px-3 py-1.5 text-sm font-medium rounded-full border border-stone-200 bg-white text-zinc-600 hover:bg-stone-50 peer-checked:bg-charcoal peer-checked:text-white peer-checked:border-charcoal peer-checked:hover:bg-zinc-800 transition-all whitespace-nowrap">
            <%= name %>
          </div>
        </label>
      <% end %>
    </div>
  </div>

  <div class="border-t border-stone-100 pt-4 space-y-4">
    <h3 class="text-sm font-semibold text-charcoal flex items-center gap-1.5 pb-1">
      <i data-lucide="clock" class="w-4 h-4 text-zinc-400"></i>
      <span>Disponibilidade</span>
    </h3>
    <div class="space-y-1">
      <%= f.label :availability, "Disponibilidade para contratação", class: "block text-xs font-medium text-zinc-500" %>
      <%= f.select :availability,
            options_for_select([
              ["Tempo integral (full_time)", "full_time"],
              ["Freelance (freelance)", "freelance"]
            ], @profile.availability),
            { include_blank: "Selecione a disponibilidade" },
            { class: "w-full rounded-lg border border-stone-300 px-3 py-2 text-sm bg-white text-charcoal focus:outline-none focus:ring-1 focus:ring-charcoal focus:border-charcoal" } %>
    </div>
  </div>

  <div class="border-t border-stone-100 pt-4 space-y-4">
    <h3 class="text-sm font-semibold text-charcoal flex items-center gap-1.5 pb-1">
      <i data-lucide="phone" class="w-4 h-4 text-zinc-400"></i>
      <span>Contact Info</span>
    </h3>
    <div class="grid grid-cols-2 gap-4">
      <div class="space-y-1">
        <%= f.label :phone, "Phone", class: "block text-xs font-medium text-zinc-500" %>
        <%= f.text_field :phone, class: "w-full rounded-lg border border-stone-300 px-3 py-2 text-sm bg-white text-charcoal placeholder-zinc-400 focus:outline-none focus:ring-1 focus:ring-charcoal focus:border-charcoal" %>
      </div>
      <div class="space-y-1">
        <%= f.label :mobile, "Mobile", class: "block text-xs font-medium text-zinc-500" %>
        <%= f.text_field :mobile, class: "w-full rounded-lg border border-stone-300 px-3 py-2 text-sm bg-white text-charcoal placeholder-zinc-400 focus:outline-none focus:ring-1 focus:ring-charcoal focus:border-charcoal" %>
      </div>
      <div class="col-span-2 space-y-1">
        <%= f.label :website, "Website", class: "block text-xs font-medium text-zinc-500" %>
        <%= f.text_field :website, placeholder: "https://example.com", class: "w-full rounded-lg border border-stone-300 px-3 py-2 text-sm bg-white text-charcoal placeholder-zinc-400 focus:outline-none focus:ring-1 focus:ring-charcoal focus:border-charcoal" %>
      </div>
      <div class="col-span-2 space-y-1">
        <%= f.label :organization, "Organization", class: "block text-xs font-medium text-zinc-500" %>
        <%= f.text_field :organization, class: "w-full rounded-lg border border-stone-300 px-3 py-2 text-sm bg-white text-charcoal placeholder-zinc-400 focus:outline-none focus:ring-1 focus:ring-charcoal focus:border-charcoal" %>
      </div>
    </div>
  </div>

  <div class="flex items-center justify-between border-t border-stone-100 pt-5">
    <%= link_to "Cancel", public_path_for(current_actor), class: "text-sm font-medium text-zinc-500 hover:text-charcoal transition-colors" %>
    <%= f.submit "Save changes", class: "bg-charcoal hover:bg-zinc-800 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors cursor-pointer" %>
  </div>
<% end %>
