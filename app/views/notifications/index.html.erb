<div class="max-w-2xl mx-auto space-y-6">
  <div class="flex items-center justify-between mb-2">
    <div class="flex items-center gap-2.5">
      <i data-lucide="bell" class="w-6 h-6 text-brand"></i>
      <h1 class="text-2xl font-serif font-bold text-charcoal tracking-tight">Notifications</h1>
    </div>
    
    <% if current_actor.notifications.unread.exists? %>
      <%= button_to mark_all_as_read_notifications_path, method: :post, class: "flex items-center gap-1.5 text-xs font-semibold bg-white hover:bg-stone-50 text-zinc-700 px-3.5 py-2 rounded-lg border border-stone-300 transition-colors cursor-pointer" do %>
        <i data-lucide="check-check" class="w-4 h-4"></i>
        <span>Mark all as read</span>
      <% end %>
    <% end %>
  </div>

  <div id="notifications_list_container">
    <%= render "notifications/list", notifications: @notifications, pagy: @pagy %>
  </div>
</div>
