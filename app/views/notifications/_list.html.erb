<div class="bg-white rounded-lg border border-stone-border overflow-hidden divide-y divide-stone-100">
  <% if notifications.any? %>
    <% notifications.each do |notification| %>
      <%= render "notifications/notification", notification: notification %>
    <% end %>
  <% else %>
    <div class="flex flex-col items-center justify-center py-16 text-center px-4">
      <div class="w-12 h-12 rounded-full bg-stone-100 flex items-center justify-center text-zinc-500 mb-3 border border-stone-200">
        <i data-lucide="bell-off" class="w-5 h-5"></i>
      </div>
      <p class="text-sm font-semibold text-charcoal mb-1"><%= t(".empty_title") %></p>
      <p class="text-xs text-zinc-500 max-w-[280px]"><%= t(".empty_subtitle") %></p>
    </div>
  <% end %>
</div>

<% if pagy.pages > 1 %>
  <div class="mt-6 flex justify-center">
    <%== pagy_nav(pagy) %>
  </div>
<% end %>
