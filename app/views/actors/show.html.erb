<%= content_for :title, @actor.name %>

<div class="max-w-2xl mx-auto space-y-6">
  <div class="bg-white rounded-lg border border-stone-border overflow-hidden">
    <% if @actor.cover_image.attached? %>
      <%= image_tag @actor.cover_image.variant(:thumb), class: "w-full h-44 object-cover" %>
    <% else %>
      <div class="w-full h-32 bg-stone-50 border-b border-stone-border flex items-center justify-center text-zinc-300">
        <i data-lucide="image" class="w-8 h-8"></i>
      </div>
    <% end %>
    <div class="p-6 relative flex flex-col sm:flex-row sm:items-start justify-between gap-4">
      <div class="flex flex-col sm:flex-row items-start gap-4">
        <div class="-mt-14 sm:-mt-16 w-20 h-20 rounded-full bg-white p-1 flex-shrink-0 overflow-hidden border border-stone-border shadow-sm">
          <% if @actor.avatar.attached? %>
            <%= image_tag @actor.avatar.variant(:thumb), class: "w-full h-full rounded-full object-cover" %>
          <% else %>
            <%
              is_group = @actor.actorable_type == "Group"
              avatar_rounded = is_group ? "rounded-lg" : "rounded-full"
              avatar_bg = is_group ? "bg-stone-200 text-charcoal border-stone-300" : "bg-stone-100 text-charcoal border-stone-border"
            %>
            <div class="w-full h-full <%= avatar_rounded %> <%= avatar_bg %> flex items-center justify-center text-2xl font-bold">
              <%= @actor.name.first.upcase %>
            </div>
          <% end %>
        </div>
        <div class="space-y-1.5">
          <h1 class="text-2xl font-serif font-bold text-charcoal tracking-tight leading-tight"><%= @actor.name %></h1>
          <% if @actor.description.present? %>
            <p class="text-sm text-zinc-600 mt-1 leading-relaxed"><%= @actor.description %></p>
          <% end %>

          <% if @actor.actorable.is_a?(Profile) && @actor.actorable.occupations.any? %>
            <div class="flex flex-wrap gap-1.5 mt-2.5">
              <% @actor.actorable.occupations.each do |occupation| %>
                <span class="inline-flex items-center px-1.5 py-0.5 rounded-md text-[10px] font-medium bg-stone-100 text-zinc-600 border border-stone-200">
                  <%= occupation.name %>
                </span>
              <% end %>
            </div>
          <% end %>

          <!-- Profile Specific Location / Website / Availability -->
          <% if @actor.actorable.is_a?(Profile) %>
            <% profile = @actor.actorable %>
            <% if profile.city.present? || profile.state.present? || profile.website.present? || profile.availability.present? %>
              <div class="flex flex-wrap items-center gap-x-4 gap-y-1.5 mt-2.5 text-xs font-medium text-zinc-500">
                <% if profile.availability.present? %>
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700 border border-emerald-200">
                    <i data-lucide="clock" class="w-3.5 h-3.5 text-emerald-600"></i>
                    <%= profile.availability_label %>
                  </span>
                <% end %>
                <% if profile.city.present? || profile.state.present? %>
                  <span class="flex items-center gap-1.5">
                    <i data-lucide="map-pin" class="w-3.5 h-3.5 text-zinc-400"></i>
                    <%= [profile.city, profile.state].reject(&:blank?).join(", ") %>
                  </span>
                <% end %>
                <% if profile.website.present? %>
                  <span class="flex items-center gap-1.5">
                    <i data-lucide="link" class="w-3.5 h-3.5 text-zinc-400"></i>
                    <%= link_to profile.website, profile.website, target: "_blank", rel: "noopener", class: "text-brand hover:text-brand-hover hover:underline" %>
                  </span>
                <% end %>
              </div>
            <% end %>
          <% end %>

          <% if feature_enabled?(:social_feed) || feature_enabled?(:contacts) %>
            <div class="flex gap-4 mt-3 text-xs font-medium text-zinc-400">
              <% if feature_enabled?(:social_feed) %>
                <span class="flex items-center gap-1"><i data-lucide="file-text" class="w-3.5 h-3.5"></i> <%= @actor.authored_activities.posts.count %> posts</span>
              <% end %>
              <% if feature_enabled?(:contacts) && @actor.sent_active_contact_ids.any? %>
                <span class="flex items-center gap-1"><i data-lucide="users" class="w-3.5 h-3.5"></i> <%= @actor.sent_active_contact_ids.size %> connections</span>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
      <%= render "shared/connection_button", actor: @actor %>
    </div>
  </div>

  <% if feature_enabled?(:social_feed) %>
    <div class="space-y-4">
      <% if @activities.any? %>
        <%= render partial: "shared/activity", collection: @activities, as: :activity %>
      <% else %>
        <div class="text-center text-zinc-500 py-16 bg-white rounded-lg border border-stone-border p-8 shadow-sm">
          <div class="w-12 h-12 bg-stone-50 rounded-full flex items-center justify-center mx-auto mb-3 border border-stone-100">
            <i data-lucide="message-square-off" class="w-6 h-6 text-zinc-400"></i>
          </div>
          <h3 class="text-base font-semibold text-charcoal">No posts yet</h3>
          <p class="text-sm text-zinc-500 mt-1 max-w-sm mx-auto">This profile has not shared any updates or posts yet.</p>
        </div>
      <% end %>
    </div>

    <% if @pagy.pages > 1 %>
      <div class="mt-6 flex justify-center"><%== pagy_nav(@pagy) %></div>
    <% end %>
  <% end %>
</div>
