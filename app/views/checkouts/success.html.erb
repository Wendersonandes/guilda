<% content_for :title, "Assinatura Confirmada — Guilda" %>

<div class="max-w-lg mx-auto my-12 p-8 bg-white border border-stone-border rounded-xl shadow-xs text-center space-y-6">
  <div class="w-16 h-16 bg-emerald-50 text-emerald-600 rounded-full flex items-center justify-center mx-auto border border-emerald-100">
    <i data-lucide="check-circle" class="w-8 h-8" aria-hidden="true"></i>
  </div>

  <div class="space-y-2">
    <h1 class="font-serif text-3xl font-bold text-charcoal">Seus 30 dias gratuitos começaram!</h1>
    <p class="text-sm text-zinc-600 leading-relaxed">
      Sua assinatura está ativa e você já tem acesso total para publicar seus projetos no portfólio e receber contatos diretos de quem contrata.
    </p>
  </div>

  <div class="pt-2 flex flex-col gap-3">
    <%= link_to new_my_project_path, class: "w-full min-h-11 inline-flex items-center justify-center gap-2 bg-brand hover:bg-brand-hover text-white px-5 py-2.5 rounded-lg font-medium text-sm transition-colors shadow-xs" do %>
      <i data-lucide="plus-circle" class="w-4 h-4" aria-hidden="true"></i>
      <span>Publicar meu primeiro projeto</span>
    <% end %>

    <div class="flex flex-col sm:flex-row justify-center gap-2 pt-1">
      <%= link_to edit_my_profile_path, class: "min-h-11 inline-flex items-center justify-center gap-2 bg-white hover:bg-stone-50 text-charcoal border border-stone-border px-4 py-2 rounded-lg font-medium text-xs transition-colors" do %>
        <i data-lucide="edit-3" class="w-3.5 h-3.5 text-zinc-400" aria-hidden="true"></i>
        <span>Completar bio e contatos</span>
      <% end %>

      <% if current_actor %>
        <%= link_to my_profile_path, class: "min-h-11 inline-flex items-center justify-center gap-2 bg-white hover:bg-stone-50 text-zinc-600 hover:text-charcoal border border-stone-border px-4 py-2 rounded-lg font-medium text-xs transition-colors" do %>
          <i data-lucide="user" class="w-3.5 h-3.5 text-zinc-400" aria-hidden="true"></i>
          <span>Visualizar meu perfil</span>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
