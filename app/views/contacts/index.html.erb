<% content_for :no_sidebar, true %>
<%= content_for :title, t(".title") %>

<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
  <!-- Main Column: Contacts List & Filters -->
  <div class="lg:col-span-8 space-y-6 min-w-0">
  <!-- Header -->
  <div class="space-y-1">
    <h1 class="text-2xl sm:text-3xl font-serif font-bold text-charcoal tracking-tight"><%= t(".title") %></h1>
    <p class="text-sm text-zinc-500 leading-relaxed"><%= t(".subtitle") %></p>
  </div>

  <!-- Mobile Pending Contact Requests (visible on < lg) -->
  <% if @pending_contacts.present? && @pending_contacts.any? %>
    <div class="lg:hidden bg-white rounded-lg border border-stone-border p-4">
      <%= render "shared/sidebar_pending_contacts", pending: @pending_contacts %>
    </div>
  <% end %>

  <!-- Search & Filter Box -->
  <div class="bg-white rounded-lg border border-stone-border p-4 sm:p-5">
    <%= form_with url: contacts_path, method: :get,
                  html: {
                    data: {
                      controller: "filter-form",
                      turbo_frame: "contacts_frame",
                      turbo_action: "advance"
                    }
                  } do |f| %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-3 items-end">
        <!-- Name Search (q) with debounce -->
        <div class="lg:col-span-5 space-y-1.5">
          <%= f.label :q, class: "block text-xs font-semibold text-zinc-500 uppercase tracking-wider" do %>
            <span class="flex items-center gap-1.5"><i data-lucide="search" aria-hidden="true" class="w-3.5 h-3.5 text-zinc-400"></i> <%= t(".search_label") %></span>
          <% end %>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-zinc-400" aria-hidden="true">
              <i data-lucide="search" aria-hidden="true" class="w-4 h-4"></i>
            </div>
            <%= f.text_field :q, value: params[:q],
                             placeholder: t(".search_placeholder"),
                             autocomplete: "off",
                             class: "w-full text-sm rounded-lg border border-stone-300 bg-white pl-9 pr-3.5 py-2 text-charcoal placeholder:text-zinc-500 focus:outline-none focus:ring-1 focus:ring-charcoal focus:border-charcoal font-medium transition-colors",
                             data: {
                               filter_form_target: "input",
                               action: "input->filter-form#debouncedSubmit keydown.enter->filter-form#submit"
                             } %>
          </div>
        </div>

        <!-- Occupation Select -->
        <div class="lg:col-span-4 space-y-1.5">
          <%= f.label :occupation, class: "block text-xs font-semibold text-zinc-500 uppercase tracking-wider" do %>
            <span class="flex items-center gap-1.5"><i data-lucide="briefcase" aria-hidden="true" class="w-3.5 h-3.5 text-zinc-400"></i> <%= t(".category_label") %></span>
          <% end %>
          <%= f.select :occupation, options_for_select([[t(".all_categories"), ""]] + @occupations, params[:occupation]), {},
                       class: "w-full text-sm rounded-lg border border-stone-300 bg-white px-3.5 py-2 text-charcoal focus:outline-none focus:ring-1 focus:ring-charcoal focus:border-charcoal font-medium transition-colors cursor-pointer",
                       data: { action: "change->filter-form#submit" } %>
        </div>

        <!-- City Select -->
        <div class="lg:col-span-3 space-y-1.5">
          <%= f.label :city, class: "block text-xs font-semibold text-zinc-500 uppercase tracking-wider" do %>
            <span class="flex items-center gap-1.5"><i data-lucide="map-pin" aria-hidden="true" class="w-3.5 h-3.5 text-zinc-400"></i> <%= t(".city_label") %></span>
          <% end %>
          <%= f.select :city, options_for_select([[t(".all_cities"), ""]] + @cities, params[:city]), {},
                       class: "w-full text-sm rounded-lg border border-stone-300 bg-white px-3.5 py-2 text-charcoal focus:outline-none focus:ring-1 focus:ring-charcoal focus:border-charcoal font-medium transition-colors cursor-pointer",
                       data: { action: "change->filter-form#submit" } %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Contacts Results Frame -->
  <%= turbo_frame_tag "contacts_frame", data: { turbo_action: "advance" } do %>
    <% has_filters = params[:q].present? || params[:occupation].present? || params[:city].present? %>
    <% results_count = @pagy.count %>

    <!-- Status & Active Filters Bar -->
    <div class="flex flex-wrap items-center justify-between gap-3 pb-3">
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-sm font-semibold text-charcoal" role="status" aria-live="polite">
          <%= t(has_filters ? ".filtered_results_count" : ".results_count", count: results_count) %>
        </span>

        <% if has_filters %>
          <span class="text-zinc-300" aria-hidden="true">|</span>
          <span class="text-xs text-zinc-500"><%= t(".active_filters") %></span>
          <div class="flex flex-wrap items-center gap-1.5">
            <% if params[:q].present? %>
              <%= render "shared/filter_chip", label: %("#{params[:q]}"), remove_label: "Remover busca",
                    href: contacts_path(request.query_parameters.except(:q)) %>
            <% end %>

            <% if params[:occupation].present? %>
              <%= render "shared/filter_chip", label: params[:occupation], remove_label: "Remover categoria",
                    href: contacts_path(request.query_parameters.except(:occupation)) %>
            <% end %>

            <% if params[:city].present? %>
              <%= render "shared/filter_chip", label: params[:city], remove_label: "Remover cidade",
                    href: contacts_path(request.query_parameters.except(:city)) %>
            <% end %>
          </div>
        <% end %>
      </div>

      <% if has_filters %>
        <%= link_to contacts_path, class: "text-xs font-medium text-zinc-500 hover:text-charcoal hover:underline transition-colors rounded focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-charcoal focus-visible:ring-offset-1", data: { turbo_action: "advance", turbo_frame: "_top" } do %>
          <span><%= t(".clear_filters") %></span>
        <% end %>
      <% end %>
    </div>

    <!-- Contacts List -->
    <% if @contacts.any? %>
      <div class="space-y-2">
        <% @contacts.each do |contact| %>
          <% receiver = contact.receiver %>
          <% profile = receiver.actorable.is_a?(Profile) ? receiver.actorable : nil %>
          <div class="flex items-center justify-between gap-3 rounded-lg border border-stone-border bg-white p-4 hover:border-stone-400 hover:bg-stone-50/70 transition-colors sm:px-5">
            <div class="flex items-center gap-3.5 min-w-0 flex-1">
              <!-- Avatar with photo support -->
              <div class="w-11 h-11 rounded-full bg-white flex-shrink-0 overflow-hidden border border-stone-border">
                <% if receiver.avatar.attached? %>
                  <%= image_tag receiver.avatar.variant(:thumb), alt: "", loading: "lazy", decoding: "async", class: "w-full h-full rounded-full object-cover" %>
                <% else %>
                  <div class="w-full h-full rounded-full bg-stone-100 text-charcoal flex items-center justify-center font-serif font-bold text-sm" aria-hidden="true">
                    <%= receiver.name.first.upcase %>
                  </div>
                <% end %>
              </div>

              <!-- Recognition Cues: Name, Logistics & Specialties -->
              <div class="flex flex-col min-w-0 flex-1">
                <!-- Line 1: Name + Logistics/Status -->
                <div class="flex flex-wrap items-center gap-x-2 gap-y-0.5">
                  <%= link_to receiver.name, public_path_for(receiver),
                              class: "font-serif font-bold text-charcoal text-base hover:text-brand transition-colors truncate rounded focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-charcoal focus-visible:ring-offset-1",
                              data: { turbo_frame: "_top" } %>

                  <% if contact.mutual? %>
                    <span class="inline-flex items-center gap-1 text-[10px] font-medium text-emerald-700 bg-emerald-50 border border-emerald-200/60 px-2 py-0.5 rounded-full" title="<%= t(".mutual_badge_title") %>">
                      <i data-lucide="arrow-left-right" class="w-3 h-3 text-emerald-600"></i>
                      <span><%= t(".mutual_badge") %></span>
                    </span>
                  <% end %>

                  <% if profile %>
                    <% if profile.city.present? || profile.state.present? %>
                      <span class="inline-flex items-center gap-1 text-xs text-zinc-500">
                        <i data-lucide="map-pin" aria-hidden="true" class="w-3.5 h-3.5 text-zinc-400 flex-shrink-0"></i>
                        <span><%= [profile.city, profile.state].reject(&:blank?).join(", ") %></span>
                      </span>
                    <% end %>

                    <% if (profile.city.present? || profile.state.present?) && profile.availability.present? %>
                      <span class="text-zinc-300 text-xs" aria-hidden="true">•</span>
                    <% end %>

                    <% if profile.availability.present? %>
                      <span class="inline-flex items-center gap-1.5 text-xs font-medium <%= profile.unavailable? ? 'text-zinc-600' : 'text-emerald-700' %>">
                        <span class="w-1.5 h-1.5 rounded-full <%= profile.unavailable? ? 'bg-zinc-500' : 'bg-emerald-500' %>" aria-hidden="true"></span>
                        <span><%= profile.availability_label %></span>
                      </span>
                    <% end %>
                  <% end %>
                </div>

                <!-- Line 2: Occupations (up to 3 + counter) -->
                <% if profile && profile.occupations.any? %>
                  <div class="flex flex-wrap items-center gap-1 mt-1">
                    <% profile.occupations.first(3).each do |occupation| %>
                      <span class="text-[10px] font-medium bg-stone-100 text-zinc-700 border border-stone-200/70 px-2 py-0.5 rounded-full">
                        <%= occupation.name %>
                      </span>
                    <% end %>
                    <% if profile.occupations.size > 3 %>
                      <span class="text-[10px] font-medium text-zinc-500 pl-0.5">
                        +<%= profile.occupations.size - 3 %>
                      </span>
                    <% end %>
                  </div>
                <% end %>
              </div>
            </div>

            <!-- Actions -->
            <div class="flex items-center gap-2 flex-shrink-0">
              <%= link_to public_path_for(receiver),
                          class: "hidden sm:inline-flex items-center gap-1 text-xs font-medium text-zinc-700 hover:text-charcoal hover:bg-stone-100 px-3 py-1.5 rounded-md border border-stone-300/80 transition-colors focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-charcoal focus-visible:ring-offset-1",
                          data: { turbo_frame: "_top" } do %>
                <span><%= t(".view_profile") %></span>
                <i data-lucide="arrow-right" aria-hidden="true" class="w-3.5 h-3.5 text-zinc-400"></i>
              <% end %>

              <%= button_to contact_path(contact),
                            method: :delete,
                            class: "min-h-11 sm:min-h-0 inline-flex items-center justify-center gap-1.5 text-xs font-medium text-zinc-600 hover:text-red-700 hover:bg-red-50 hover:border-red-200 border border-stone-300 bg-white px-3 py-2 sm:py-1.5 rounded-md transition-colors cursor-pointer group focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-charcoal focus-visible:ring-offset-1",
                            title: t(".remove"),
                            data: { turbo_confirm: t(".remove_confirm", name: receiver.name) } do %>
                <i data-lucide="user-minus" aria-hidden="true" class="w-3.5 h-3.5 text-zinc-400 group-hover:text-red-600 transition-colors"></i>
                <span><%= t(".remove") %></span>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <!-- Empty State -->
      <div class="text-center text-zinc-500 py-12 sm:py-16 bg-white rounded-lg border border-stone-border p-6 sm:p-8 space-y-3">
        <div class="w-12 h-12 bg-stone-50 rounded-full flex items-center justify-center mx-auto border border-stone-100 text-zinc-400" aria-hidden="true">
          <i data-lucide="<%= has_filters ? 'search' : 'users-2' %>" aria-hidden="true" class="w-6 h-6"></i>
        </div>
        <div class="space-y-1">
          <h2 class="text-base font-serif font-bold text-charcoal">
            <%= t(has_filters ? ".empty_title" : ".no_contacts_title") %>
          </h2>
          <p class="text-sm text-zinc-500 max-w-sm mx-auto leading-relaxed">
            <%= t(has_filters ? ".empty_subtitle" : ".no_contacts_subtitle") %>
          </p>
        </div>
        <div class="pt-2">
          <% if has_filters %>
            <%= link_to contacts_path, class: "inline-flex items-center gap-1.5 text-xs bg-stone-100 hover:bg-stone-200 text-charcoal font-medium px-4 py-2 rounded-lg transition-colors border border-stone-300/80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-charcoal focus-visible:ring-offset-1", data: { turbo_action: "advance", turbo_frame: "_top" } do %>
              <i data-lucide="x" aria-hidden="true" class="w-3.5 h-3.5"></i>
              <span><%= t(".clear_filters") %></span>
            <% end %>
          <% else %>
            <%= link_to profiles_path, class: "inline-flex items-center gap-1.5 text-xs bg-charcoal text-white hover:bg-zinc-800 font-medium px-4 py-2 rounded-lg transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-charcoal focus-visible:ring-offset-1", data: { turbo_action: "advance", turbo_frame: "_top" } do %>
              <i data-lucide="search" aria-hidden="true" class="w-3.5 h-3.5"></i>
              <span><%= t(".explore_profiles") %></span>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if @pagy.pages > 1 %>
      <div class="mt-6 flex justify-center"><%== pagy_nav(@pagy) %></div>
    <% end %>
  <% end %>
  </div>

  <!-- Right Sidebar Column: Contact Requests & Suggestions (Desktop) -->
  <aside class="hidden lg:block lg:col-span-4 min-w-0">
    <%= render "shared/right_sidebar" %>
  </aside>
</div>
