<% if feature_enabled?(:contacts) && current_actor && current_actor != actor %>
  <div class="flex-shrink-0" id="<%= dom_id(actor, :connection) %>">
    <% if current_actor.connected_with?(actor) %>
      <div class="inline-flex items-center gap-2">
        <% if current_actor.mutual_with?(actor) %>
          <span class="inline-flex items-center gap-1 text-[11px] font-medium text-emerald-700 bg-emerald-50 border border-emerald-200/60 px-2.5 py-1.5 rounded-md" title="<%= t(".mutual_title") %>">
            <i data-lucide="arrow-left-right" class="w-3 h-3 text-emerald-600"></i>
            <span><%= t(".mutual") %></span>
          </span>
        <% end %>
        <%= button_to contact_path(current_actor.contact_to(actor)), method: :delete, class: "inline-flex items-center gap-1.5 text-xs bg-white text-zinc-700 hover:text-red-600 hover:border-red-300 font-medium px-3.5 py-2 rounded-lg border border-stone-300 transition-colors cursor-pointer shadow-sm group" do %>
          <i data-lucide="user-check" class="w-3.5 h-3.5 group-hover:hidden"></i>
          <i data-lucide="user-minus" class="w-3.5 h-3.5 hidden group-hover:inline"></i>
          <span class="group-hover:hidden"><%= t(".following") %></span>
          <span class="hidden group-hover:inline"><%= t(".unfollow") %></span>
        <% end %>
      </div>
    <% else %>
      <% follows_me = current_actor.followed_by?(actor) %>
      <div class="inline-flex items-center gap-2">
        <% if follows_me %>
          <span class="text-[10px] text-zinc-400 font-medium bg-stone-100 px-2 py-1 rounded-md border border-stone-200">
            <%= t(".follows_you") %>
          </span>
        <% end %>
        <%= button_to contacts_path(actor_id: actor.slug, as: :follower), method: :post, class: "inline-flex items-center gap-1.5 text-xs bg-brand hover:bg-brand-hover text-white font-medium px-4 py-2 rounded-lg transition-colors cursor-pointer shadow-sm" do %>
          <i data-lucide="user-plus" class="w-3.5 h-3.5"></i>
          <span><%= t(follows_me ? ".follow_back" : ".follow") %></span>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
