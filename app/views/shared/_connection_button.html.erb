<% if feature_enabled?(:contacts) && current_actor && current_actor != actor %>
  <div class="flex-shrink-0" id="<%= dom_id(actor, :connection) %>">
    <% if current_actor.connected_with?(actor) %>
      <%= button_to contact_path(current_actor.contact_to(actor)), method: :delete, class: "inline-flex items-center gap-1.5 text-xs bg-white text-zinc-700 hover:text-red-600 hover:border-red-300 font-medium px-3.5 py-2 rounded-lg border border-stone-300 transition-colors cursor-pointer shadow-sm" do %>
        <i data-lucide="user-minus" class="w-3.5 h-3.5"></i>
        <span><%= t(".remove") %></span>
      <% end %>
    <% else %>
      <%= button_to contacts_path(actor_id: actor.slug, as: :friend), method: :post, class: "inline-flex items-center gap-1.5 text-xs bg-brand hover:bg-brand-hover text-white font-medium px-4 py-2 rounded-lg transition-colors cursor-pointer shadow-sm" do %>
        <i data-lucide="user-plus" class="w-3.5 h-3.5"></i>
        <span><%= t(".connect") %></span>
      <% end %>
    <% end %>
  </div>
<% end %>
