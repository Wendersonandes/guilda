<% if feature_enabled?(:contacts) && current_actor && current_actor != actor %>
  <% full_width = local_assigns.fetch(:full_width, true) %>
  <div class="<%= 'w-full' if full_width %> flex-shrink-0" id="<%= dom_id(actor, :connection) %>">
    <% if current_actor.connected_with?(actor) %>
      <% contact = current_actor.contact_to(actor) %>
      <div class="flex items-center gap-2 <%= 'w-full' if full_width %>">
        <% if current_actor.mutual_with?(actor) %>
          <span class="inline-flex items-center gap-1 text-[11px] font-medium text-emerald-700 bg-emerald-50 border border-emerald-200/60 px-2.5 py-2.5 rounded-lg flex-shrink-0" title="<%= t(".mutual_title") %>">
            <i data-lucide="arrow-left-right" class="w-3 h-3 text-emerald-600"></i>
            <span><%= t(".mutual") %></span>
          </span>
        <% end %>
        <%= button_to contact_path(contact),
                      method: :delete,
                      form_class: (full_width ? "w-full flex-1" : nil),
                      class: "inline-flex items-center justify-center gap-1.5 text-xs bg-charcoal hover:bg-red-600 text-white font-medium px-4 py-2.5 rounded-lg transition-colors cursor-pointer shadow-xs focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-offset-1 focus-visible:ring-charcoal group #{'w-full flex-1' if full_width}" do %>
          <i data-lucide="user-check" class="w-3.5 h-3.5 text-zinc-300 group-hover:hidden group-focus-visible:hidden"></i>
          <i data-lucide="user-minus" class="w-3.5 h-3.5 hidden group-hover:inline group-focus-visible:inline text-white"></i>
          <span class="group-hover:hidden group-focus-visible:hidden"><%= t(".following") %></span>
          <span class="hidden group-hover:inline group-focus-visible:inline"><%= t(".unfollow") %></span>
        <% end %>
      </div>
    <% else %>
      <% follows_me = current_actor.followed_by?(actor) %>
      <div class="flex items-center gap-2 <%= 'w-full' if full_width %>">
        <%= button_to contacts_path(actor_id: actor.slug, as: :follower),
                      method: :post,
                      form_class: (full_width ? "w-full" : nil),
                      class: "inline-flex items-center justify-center gap-1.5 text-xs bg-charcoal hover:bg-zinc-800 focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-offset-1 focus-visible:ring-charcoal text-white font-medium px-4 py-2.5 rounded-lg transition-colors cursor-pointer shadow-xs #{'w-full' if full_width}" do %>
          <i data-lucide="user-plus" class="w-3.5 h-3.5 text-zinc-300"></i>
          <span><%= t(follows_me ? ".follow_back" : ".follow") %></span>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
