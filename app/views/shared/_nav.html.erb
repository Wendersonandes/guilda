<nav class="bg-white border-b border-stone-border fixed top-0 left-0 right-0 z-50" data-controller="mobile-menu" aria-label="Global Navigation">
  <% if current_actor %>
    <%= turbo_stream_from current_actor, :notifications %>
  <% end %>
  <div class="container mx-auto px-5 flex items-center justify-between h-14">
    <div class="flex items-center gap-8">
      <%= link_to root_path, class: "flex items-center gap-2 font-bold text-base text-charcoal tracking-tight hover:opacity-90 transition-opacity" do %>
        <i data-lucide="activity" class="w-5 h-5 text-brand"></i>
        <span class="font-serif font-bold text-lg">Guilda</span>
      <% end %>
      
      <% if current_actor %>
        <div class="hidden sm:flex items-center gap-5">
          <%= link_to activities_path, class: "flex items-center gap-1.5 text-sm font-medium text-zinc-600 hover:text-brand transition-colors" do %>
            <i data-lucide="home" class="w-4 h-4"></i>
            <span>Home</span>
          <% end %>
          <%= link_to profiles_path, class: "flex items-center gap-1.5 text-sm font-medium text-zinc-600 hover:text-brand transition-colors" do %>
            <i data-lucide="search" class="w-4 h-4"></i>
            <span>Profiles</span>
          <% end %>
          <%= link_to contacts_path, class: "flex items-center gap-1.5 text-sm font-medium text-zinc-600 hover:text-brand transition-colors" do %>
            <i data-lucide="users" class="w-4 h-4"></i>
            <span>Contacts</span>
          <% end %>
          <%= link_to groups_path, class: "flex items-center gap-1.5 text-sm font-medium text-zinc-600 hover:text-brand transition-colors" do %>
            <i data-lucide="layers" class="w-4 h-4"></i>
            <span>Groups</span>
          <% end %>
          <% if current_actor.has_role?(:admin, Site.instance) %>
            <%= link_to admin_roles_path, class: "flex items-center gap-1.5 text-sm font-medium text-rose-600 hover:text-rose-700 transition-colors" do %>
              <i data-lucide="shield-alert" class="w-4 h-4"></i>
              <span>Admin</span>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>

    <!-- Desktop Menu -->
    <div class="hidden sm:flex items-center gap-5">
      <% if user_signed_in? %>
        <% if current_actor %>
          <%= link_to public_path_for(current_actor), class: "flex items-center gap-1.5 text-sm font-semibold text-charcoal hover:text-brand transition-colors" do %>
            <div class="w-6 h-6 rounded-full bg-stone-100 flex items-center justify-center text-charcoal text-xs font-bold border border-stone-border">
              <%= current_actor.name.first.upcase %>
            </div>
            <span class="max-w-[120px] truncate"><%= current_actor.name %></span>
          <% end %>
        <% end %>
        <% if current_actor %>
          <%= link_to notifications_path, class: "p-1.5 text-zinc-500 hover:text-brand transition-colors flex items-center mr-1", title: "Notifications" do %>
            <div class="relative">
              <i data-lucide="bell" class="w-4.5 h-4.5"></i>
              <%= render "shared/nav_notification_badge" %>
            </div>
          <% end %>
        <% end %>
        <%= link_to account_path, class: "flex items-center gap-1 text-sm text-zinc-500 hover:text-charcoal transition-colors" do %>
          <i data-lucide="settings" class="w-4 h-4"></i>
          <span>Account</span>
        <% end %>
        <%= button_to destroy_user_session_path, method: :delete, class: "flex items-center gap-1 text-sm text-zinc-500 hover:text-brand bg-transparent border-0 cursor-pointer transition-colors p-0 font-medium" do %>
          <i data-lucide="log-out" class="w-4 h-4"></i>
          <span>Sign out</span>
        <% end %>
      <% else %>
        <%= link_to new_user_session_path, class: "flex items-center gap-1 text-sm font-medium text-zinc-600 hover:text-brand transition-colors" do %>
          <i data-lucide="log-in" class="w-4 h-4"></i>
          <span>Sign in</span>
        <% end %>
        <%= link_to new_user_registration_path, class: "flex items-center gap-1.5 text-sm bg-brand hover:bg-brand-hover text-white px-3.5 py-1.5 rounded-lg font-medium transition-colors cursor-pointer" do %>
          <i data-lucide="user-plus" class="w-4 h-4"></i>
          <span>Sign up</span>
        <% end %>
      <% end %>
    </div>

    <!-- Mobile Menu Toggle Button -->
    <button type="button"
            data-action="click->mobile-menu#toggle"
            class="sm:hidden flex items-center justify-center w-9 h-9 rounded-lg hover:bg-stone-50 text-charcoal cursor-pointer transition-colors"
            aria-label="Toggle navigation menu">
      <i data-lucide="menu" class="w-5 h-5"></i>
    </button>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div data-mobile-menu-target="menu" class="hidden sm:hidden bg-white border-t border-stone-border px-5 py-3 space-y-2.5 shadow-md">
    <% if current_actor %>
      <%= link_to activities_path, class: "flex items-center gap-2 text-sm font-medium text-zinc-700 hover:text-brand py-1 transition-colors" do %>
        <i data-lucide="home" class="w-4 h-4"></i>
        <span>Home</span>
      <% end %>
      <%= link_to profiles_path, class: "flex items-center gap-2 text-sm font-medium text-zinc-700 hover:text-brand py-1 transition-colors" do %>
        <i data-lucide="search" class="w-4 h-4"></i>
        <span>Profiles</span>
      <% end %>
      <%= link_to contacts_path, class: "flex items-center gap-2 text-sm font-medium text-zinc-700 hover:text-brand py-1 transition-colors" do %>
        <i data-lucide="users" class="w-4 h-4"></i>
        <span>Contacts</span>
      <% end %>
      <%= link_to groups_path, class: "flex items-center gap-2 text-sm font-medium text-zinc-700 hover:text-brand py-1 transition-colors" do %>
        <i data-lucide="layers" class="w-4 h-4"></i>
        <span>Groups</span>
      <% end %>
      <% if current_actor.has_role?(:admin, Site.instance) %>
        <%= link_to admin_roles_path, class: "flex items-center gap-2 text-sm font-medium text-rose-600 hover:text-rose-700 py-1 transition-colors" do %>
          <i data-lucide="shield-alert" class="w-4 h-4"></i>
          <span>Admin Area</span>
        <% end %>
      <% end %>
      <%= link_to notifications_path, class: "flex items-center justify-between text-sm font-medium text-zinc-700 hover:text-brand py-1 transition-colors" do %>
        <div class="flex items-center gap-2">
          <i data-lucide="bell" class="w-4 h-4"></i>
          <span>Notifications</span>
        </div>
        <% unread_count = current_actor.notifications.unread.count %>
        <% if unread_count > 0 %>
          <span class="bg-brand text-white text-[10px] font-bold px-2 py-0.5 rounded-full">
            <%= unread_count %>
          </span>
        <% end %>
      <% end %>
      <hr class="border-stone-100">
    <% end %>
    
    <% if user_signed_in? %>
      <% if current_actor %>
        <%= link_to public_path_for(current_actor), class: "flex items-center gap-2 text-sm font-semibold text-charcoal hover:text-brand py-1 transition-colors" do %>
          <div class="w-6 h-6 rounded-full bg-stone-100 flex items-center justify-center text-charcoal text-xs font-bold border border-stone-border">
            <%= current_actor.name.first.upcase %>
          </div>
          <span><%= current_actor.name %></span>
        <% end %>
      <% end %>
      <%= link_to account_path, class: "flex items-center gap-2 text-sm text-zinc-650 hover:text-charcoal py-1 transition-colors" do %>
        <i data-lucide="settings" class="w-4 h-4"></i>
        <span>Account Settings</span>
      <% end %>
      <%= button_to destroy_user_session_path, method: :delete, class: "flex items-center gap-2 w-full text-left text-sm text-zinc-650 hover:text-brand bg-transparent border-0 cursor-pointer py-1 transition-colors font-medium" do %>
        <i data-lucide="log-out" class="w-4 h-4"></i>
        <span>Sign out</span>
      <% end %>
    <% else %>
      <%= link_to new_user_session_path, class: "flex items-center gap-2 text-sm font-medium text-zinc-700 hover:text-brand py-1 transition-colors" do %>
        <i data-lucide="log-in" class="w-4 h-4"></i>
        <span>Sign in</span>
      <% end %>
      <%= link_to new_user_registration_path, class: "flex items-center gap-2 text-sm font-semibold text-brand hover:text-brand-hover py-1 transition-colors" do %>
        <i data-lucide="user-plus" class="w-4 h-4"></i>
        <span>Sign up</span>
      <% end %>
    <% end %>
  </div>
</nav>
