<%# locals: (actor:) %>
<% profile = actor.actorable %>
<% own_profile = actor == current_actor %>
<% has_contact = actor.email.present? || profile.mobile.present? || profile.website.present? || profile.instagram.present? %>

<div class="bg-white rounded-lg border border-stone-border p-5 space-y-3.5">
  <div class="flex items-center justify-between pb-3 border-b border-stone-100">
    <h3 class="text-xs font-semibold uppercase tracking-wider text-zinc-500 flex items-center gap-1.5">
      <i data-lucide="contact-round" class="w-3.5 h-3.5 text-zinc-400"></i>
      <span><%= t(own_profile ? ".own_title" : ".title") %></span>
    </h3>
    <% if own_profile %>
      <%= link_to edit_my_profile_path, class: "text-[11px] font-medium text-zinc-400 hover:text-charcoal transition-colors", title: t(".edit_profile", default: "Editar perfil") do %>
        <span class="hover:underline"><%= t(".edit_short") %></span>
      <% end %>
    <% end %>
  </div>

  <% unless has_contact %>
    <div class="py-2 text-center space-y-2">
      <p class="text-xs text-zinc-500 leading-relaxed"><%= t(own_profile ? ".own_empty" : ".empty") %></p>
      <% if own_profile %>
        <%= link_to edit_my_profile_path, class: "inline-flex items-center gap-1 text-xs text-charcoal hover:text-brand font-medium underline transition-colors" do %>
          <i data-lucide="plus" class="w-3 h-3"></i>
          <span><%= t(".add_contacts") %></span>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <% if has_contact %>
    <ul class="divide-y divide-stone-100 -my-1 text-sm">
      <% if actor.email.present? %>
        <li class="py-2.5 flex items-center justify-between gap-3 group"
            data-controller="clipboard"
            data-clipboard-full-value="<%= actor.email %>">
          <div class="flex items-center gap-2.5 min-w-0 flex-1">
            <div class="w-7 h-7 rounded-md bg-stone-100 flex items-center justify-center text-zinc-500 flex-shrink-0 group-hover:text-charcoal transition-colors">
              <i data-lucide="mail" class="w-3.5 h-3.5"></i>
            </div>
            <div class="min-w-0 flex-1">
              <p class="text-[10px] uppercase font-semibold tracking-wider text-zinc-400 leading-none mb-0.5"><%= t(".email_label") %></p>
              <span data-clipboard-target="masked" class="text-xs font-medium text-zinc-800 truncate block select-all"><%= masked_email(actor.email) %></span>
            </div>
          </div>
          <div class="flex items-center gap-1.5 flex-shrink-0">
            <span data-clipboard-target="feedback" class="hidden text-[10px] font-semibold text-emerald-600"><%= t(".copied") %></span>
            <button type="button"
                    data-clipboard-target="button"
                    data-action="click->clipboard#copy"
                    title="<%= t(".copy_email") %>"
                    class="w-7 h-7 rounded-md flex items-center justify-center text-zinc-400 hover:text-charcoal hover:bg-stone-100 transition-colors cursor-pointer bg-transparent border-0 p-0">
              <i data-lucide="copy" class="w-3.5 h-3.5"></i>
            </button>
          </div>
        </li>
      <% end %>

      <% if profile.mobile.present? %>
        <%
          wa_message = if current_actor
            t(".whatsapp_message_from", name: actor.name, sender: current_actor.name)
          else
            t(".whatsapp_message", name: actor.name)
          end
        %>
        <li class="py-2.5 flex items-center justify-between gap-3 group">
          <div class="flex items-center gap-2.5 min-w-0 flex-1">
            <div class="w-7 h-7 rounded-md bg-stone-100 flex items-center justify-center text-zinc-500 flex-shrink-0 group-hover:text-charcoal transition-colors">
              <i data-lucide="smartphone" class="w-3.5 h-3.5"></i>
            </div>
            <div class="min-w-0 flex-1">
              <p class="text-[10px] uppercase font-semibold tracking-wider text-zinc-400 leading-none mb-0.5"><%= t(".phone_label") %></p>
              <span class="text-xs font-medium text-zinc-800 truncate block"><%= br_phone_display(profile.mobile) %></span>
            </div>
          </div>
          <% if (wa = whatsapp_url(profile.mobile, text: wa_message)) %>
            <%= link_to wa, target: "_blank", rel: "noopener", title: t(".whatsapp"), class: "inline-flex items-center gap-1 text-[11px] font-medium text-emerald-800 bg-emerald-50 hover:bg-emerald-100/80 border border-emerald-200/60 px-2 py-1 rounded-md transition-colors flex-shrink-0" do %>
              <i data-lucide="message-circle" class="w-3.5 h-3.5 text-emerald-600"></i>
              <span><%= t(".whatsapp") %></span>
            <% end %>
          <% end %>
        </li>
      <% end %>

      <% if profile.website.present? %>
        <% website_display = profile.website.sub(%r{\Ahttps?://(www\.)?}, "").chomp("/") %>
        <li class="py-2.5">
          <%= link_to profile.website, target: "_blank", rel: "noopener", class: "flex items-center justify-between gap-3 group/link -mx-1.5 px-1.5 py-0.5 rounded-md hover:bg-stone-50 transition-colors", title: t(".open_link") do %>
            <div class="flex items-center gap-2.5 min-w-0 flex-1">
              <div class="w-7 h-7 rounded-md bg-stone-100 flex items-center justify-center text-zinc-500 flex-shrink-0 group-hover/link:text-charcoal group-hover/link:bg-stone-200/60 transition-colors">
                <i data-lucide="globe" class="w-3.5 h-3.5"></i>
              </div>
              <div class="min-w-0 flex-1">
                <p class="text-[10px] uppercase font-semibold tracking-wider text-zinc-400 leading-none mb-0.5"><%= t(".website_label") %></p>
                <span class="text-xs font-medium text-zinc-800 group-hover/link:text-brand truncate block transition-colors"><%= website_display %></span>
              </div>
            </div>
            <div class="w-7 h-7 rounded-md flex items-center justify-center text-zinc-400 group-hover/link:text-charcoal transition-colors flex-shrink-0">
              <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
            </div>
          <% end %>
        </li>
      <% end %>

      <% if profile.instagram.present? %>
        <%
          handle = profile.instagram.sub(%r{\Ahttps?://(www\.)?instagram\.com/}i, "")
                                   .delete_prefix("@")
                                   .split(%r{[/?#]}).first
                                   .presence || profile.instagram
        %>
        <li class="py-2.5">
          <%= link_to instagram_url(profile.instagram), target: "_blank", rel: "noopener", class: "flex items-center justify-between gap-3 group/link -mx-1.5 px-1.5 py-0.5 rounded-md hover:bg-stone-50 transition-colors", title: t(".open_link") do %>
            <div class="flex items-center gap-2.5 min-w-0 flex-1">
              <div class="w-7 h-7 rounded-md bg-stone-100 flex items-center justify-center text-zinc-500 flex-shrink-0 group-hover/link:text-charcoal group-hover/link:bg-stone-200/60 transition-colors">
                <i data-lucide="instagram" class="w-3.5 h-3.5"></i>
              </div>
              <div class="min-w-0 flex-1">
                <p class="text-[10px] uppercase font-semibold tracking-wider text-zinc-400 leading-none mb-0.5"><%= t(".instagram_label") %></p>
                <span class="text-xs font-medium text-zinc-800 group-hover/link:text-brand truncate block transition-colors"><%= "@#{handle}" %></span>
              </div>
            </div>
            <div class="w-7 h-7 rounded-md flex items-center justify-center text-zinc-400 group-hover/link:text-charcoal transition-colors flex-shrink-0">
              <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
            </div>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
