<%# locals: (actor:) %>
<% profile = actor.actorable %>
<% has_contact = actor.email.present? || profile.mobile.present? || profile.website.present? || profile.instagram.present? %>
<div class="bg-white rounded-lg border border-stone-border p-5 space-y-4">
  <h3 class="text-sm font-semibold text-charcoal flex items-center gap-1.5">
    <i data-lucide="at-sign" class="w-4 h-4 text-brand"></i>
    <span><%= t(".title") %></span>
  </h3>

  <% unless has_contact %>
    <p class="text-sm text-zinc-500"><%= t(".empty") %></p>
  <% end %>

  <ul class="space-y-3 text-sm">
    <% if actor.email.present? %>
      <li class="flex items-center justify-between gap-2"
          data-controller="clipboard"
          data-clipboard-full-value="<%= actor.email %>">
        <div class="flex items-center gap-2 min-w-0">
          <i data-lucide="mail" class="w-4 h-4 text-zinc-400 flex-shrink-0"></i>
          <span data-clipboard-target="masked" class="truncate text-zinc-700"><%= masked_email(actor.email) %></span>
        </div>
        <div class="flex items-center gap-1.5 flex-shrink-0">
          <span data-clipboard-target="feedback" class="hidden text-[10px] font-semibold text-emerald-600"><%= t(".copied") %></span>
          <button type="button"
                  data-clipboard-target="button"
                  data-action="click->clipboard#copy"
                  title="<%= t(".copy_email") %>"
                  class="text-zinc-400 hover:text-brand transition-colors cursor-pointer bg-transparent border-0 p-0">
            <i data-lucide="copy" class="w-4 h-4"></i>
          </button>
        </div>
      </li>
    <% end %>

    <% if profile.mobile.present? %>
      <li class="flex items-center justify-between gap-2">
        <div class="flex items-center gap-2 min-w-0">
          <i data-lucide="smartphone" class="w-4 h-4 text-zinc-400 flex-shrink-0"></i>
          <span class="truncate text-zinc-700"><%= br_phone_display(profile.mobile) %></span>
        </div>
        <% if (wa = whatsapp_url(profile.mobile)) %>
          <%= link_to wa, target: "_blank", rel: "noopener", title: t(".whatsapp"), class: "flex items-center gap-1 text-xs font-semibold text-emerald-700 hover:text-emerald-800 transition-colors flex-shrink-0" do %>
            <i data-lucide="message-circle" class="w-4 h-4"></i>
            <span><%= t(".whatsapp") %></span>
          <% end %>
        <% end %>
      </li>
    <% end %>

    <% if profile.website.present? %>
      <li class="flex items-center gap-2 min-w-0">
        <i data-lucide="link" class="w-4 h-4 text-zinc-400 flex-shrink-0"></i>
        <%= link_to profile.website.sub(%r{\Ahttps?://(www\.)?}, ""), profile.website, target: "_blank", rel: "noopener", class: "truncate text-brand hover:text-brand-hover hover:underline" %>
      </li>
    <% end %>

    <% if profile.instagram.present? %>
      <li class="flex items-center gap-2 min-w-0">
        <i data-lucide="instagram" class="w-4 h-4 text-zinc-400 flex-shrink-0"></i>
        <%= link_to instagram_url(profile.instagram).sub(%r{\Ahttps?://(www\.)?}, ""), instagram_url(profile.instagram), target: "_blank", rel: "noopener", class: "truncate text-brand hover:text-brand-hover hover:underline" %>
      </li>
    <% end %>
  </ul>
</div>
