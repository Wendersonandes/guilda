<%# locals: () %>
<% return unless current_actor && current_actor.actorable.is_a?(Profile) %>
<% profile = current_actor.actorable %>
<% return unless profile.wizard_complete? && !profile.onboarding_completed? %>
<%
  default_role = profile.contractor? ? "contractor" : "professional"
  prof_checklist = profile.onboarding_checklist_for(:professional)
  cont_checklist = profile.onboarding_checklist_for(:contractor)
  active_checklist = default_role == "contractor" ? cont_checklist : prof_checklist
  checklists = { "professional" => prof_checklist, "contractor" => cont_checklist }
  form_context = (controller_name == "profiles" && action_name.in?(%w[edit update])) ||
                 (controller_name == "projects" && action_name.in?(%w[new create edit update]))
  circumference = 125.66
  active_ratio = active_checklist[:total_count].positive? ? (active_checklist[:completed_count].to_f / active_checklist[:total_count]) : 0
  active_dash_offset = (circumference * (1.0 - active_ratio)).round(2)
%>

<div data-controller="onboarding-widget"
     data-onboarding-widget-active-tab-value="<%= default_role %>"
     data-onboarding-widget-default-collapsed-value="true"
     data-onboarding-widget-force-collapsed-value="<%= form_context %>"
     data-onboarding-widget-actor-id-value="<%= current_actor.id %>"
     data-onboarding-widget-cool-down-days-value="3">

  <div id="onboarding_activation_card"
       role="region"
       aria-label="Lista de verificação de perfil"
       data-onboarding-widget-target="cardWrapper"
       class="hidden fixed bottom-5 right-5 z-40 w-[calc(100vw-2.5rem)] sm:w-[360px] transition-all duration-200">

  <!-- Expanded Floating Card (starts hidden by default) -->
  <div data-onboarding-widget-target="card"
       class="hidden bg-white rounded-xl border border-stone-border shadow-md overflow-hidden">
    <!-- Top Bar: Dismiss (X) + Role Tabs + Collapse (Chevron) -->
    <div class="flex items-center justify-between px-2.5 pt-2 border-b border-stone-200 bg-white gap-1">
      <button type="button"
              data-action="click->onboarding-widget#dismiss"
              aria-label="Fechar lista de verificação"
              title="Fechar"
              class="w-7 h-7 rounded-md flex items-center justify-center text-zinc-400 hover:text-charcoal hover:bg-stone-100 transition-colors cursor-pointer bg-transparent border-0 shrink-0 focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-charcoal">
        <i data-lucide="x" class="w-4 h-4" aria-hidden="true"></i>
      </button>

      <div role="tablist" aria-label="Tipo de perfil" class="flex items-center gap-3 -mb-px flex-1 justify-center">
        <button type="button"
                role="tab"
                id="onboarding-tab-professional"
                aria-controls="onboarding-panel-professional"
                aria-selected="<%= default_role == 'professional' ? 'true' : 'false' %>"
                data-onboarding-widget-target="tab"
                data-role="professional"
                data-action="click->onboarding-widget#switchTab"
                class="px-2 pt-1 pb-2.5 text-xs border-b-2 transition-colors cursor-pointer bg-transparent focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-charcoal rounded-t-sm <%= default_role == 'professional' ? 'border-charcoal text-charcoal font-semibold' : 'border-transparent text-zinc-500 hover:text-charcoal font-medium' %>">
          Sou Profissional
        </button>

        <button type="button"
                role="tab"
                id="onboarding-tab-contractor"
                aria-controls="onboarding-panel-contractor"
                aria-selected="<%= default_role == 'contractor' ? 'true' : 'false' %>"
                data-onboarding-widget-target="tab"
                data-role="contractor"
                data-action="click->onboarding-widget#switchTab"
                class="px-2 pt-1 pb-2.5 text-xs border-b-2 transition-colors cursor-pointer bg-transparent focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-charcoal rounded-t-sm <%= default_role == 'contractor' ? 'border-charcoal text-charcoal font-semibold' : 'border-transparent text-zinc-500 hover:text-charcoal font-medium' %>">
          Sou Contratante
        </button>
      </div>

      <button type="button"
              data-action="click->onboarding-widget#collapse"
              aria-label="Minimizar lista de verificação"
              title="Minimizar"
              class="w-7 h-7 rounded-md flex items-center justify-center text-zinc-400 hover:text-charcoal hover:bg-stone-100 transition-colors cursor-pointer bg-transparent border-0 shrink-0 focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-charcoal">
        <i data-lucide="chevron-down" class="w-4 h-4" aria-hidden="true"></i>
      </button>
    </div>

    <!-- Tab Panels -->
    <% checklists.each do |role_key, checklist| %>
      <%
        is_active = (role_key == default_role)
        ratio = checklist[:total_count].positive? ? (checklist[:completed_count].to_f / checklist[:total_count]) : 0
        dash_offset = (circumference * (1.0 - ratio)).round(2)
      %>
      <div id="onboarding-panel-<%= role_key %>"
           role="tabpanel"
           aria-labelledby="onboarding-tab-<%= role_key %>"
           data-onboarding-widget-target="panel"
           data-role="<%= role_key %>"
           data-fraction="<%= checklist[:completed_count] %>/<%= checklist[:total_count] %>"
           data-dash-offset="<%= dash_offset %>"
           class="<%= 'hidden' unless is_active %> max-h-[72vh] overflow-y-auto p-4 space-y-4">

        <!-- Circular Progress Ring & Summary -->
        <div class="flex items-center gap-3.5">
          <div class="relative w-12 h-12 shrink-0 flex items-center justify-center"
               role="progressbar"
               aria-valuenow="<%= checklist[:percentage] %>"
               aria-valuemin="0"
               aria-valuemax="100"
               aria-label="<%= checklist[:completed_count] %> de <%= checklist[:total_count] %> etapas concluídas">
            <svg class="w-12 h-12 -rotate-90" viewBox="0 0 48 48" aria-hidden="true">
              <circle cx="24" cy="24" r="20" fill="none" stroke="currentColor" stroke-width="3" class="text-stone-200" />
              <circle cx="24" cy="24" r="20" fill="none" stroke="currentColor" stroke-width="3"
                      stroke-linecap="round"
                      stroke-dasharray="<%= circumference %>"
                      stroke-dashoffset="<%= dash_offset %>"
                      class="text-brand transition-all duration-500 ease-out" />
            </svg>
            <span class="absolute text-xs font-bold text-charcoal tabular-nums">
              <%= checklist[:completed_count] %>/<%= checklist[:total_count] %>
            </span>
          </div>

          <div class="min-w-0 flex-1">
            <h2 class="text-sm font-semibold text-charcoal leading-snug">
              Lista de verificação de perfil
            </h2>
            <p class="text-xs text-zinc-600 leading-relaxed mt-0.5">
              <%= checklist[:subtitle] %>
            </p>
          </div>
        </div>

        <!-- Grouped Sections -->
        <% checklist[:sections].each do |section| %>
          <div class="space-y-1.5">
            <h3 class="text-[11px] font-semibold uppercase tracking-wider text-zinc-500 px-0.5">
              <%= section[:heading] %>
            </h3>

            <div class="divide-y divide-stone-200 rounded-xl border border-stone-200 bg-white overflow-hidden">
              <% section[:steps].each do |step| %>
                <% is_done = step[:completed] %>
                <%= link_to step[:url], class: "group flex items-center justify-between gap-3 px-3.5 py-2.5 hover:bg-stone-50 transition-colors focus-visible:outline-hidden focus-visible:bg-stone-50" do %>
                  <div class="flex items-center gap-2.5 min-w-0 flex-1">
                    <% if is_done %>
                      <span class="w-5 h-5 rounded-full bg-emerald-600 text-white flex items-center justify-center shrink-0">
                        <i data-lucide="check" class="w-3 h-3 stroke-[2.5]" aria-hidden="true"></i>
                      </span>
                    <% else %>
                      <span class="w-5 h-5 rounded-full border border-stone-300 bg-white group-hover:border-charcoal transition-colors shrink-0" aria-hidden="true"></span>
                    <% end %>
                    <span class="text-xs font-semibold <%= is_done ? 'text-zinc-600' : 'text-charcoal' %> truncate">
                      <%= step[:title] %>
                    </span>
                  </div>

                  <% unless is_done %>
                    <i data-lucide="chevron-right" class="w-4 h-4 text-zinc-400 group-hover:text-charcoal group-hover:translate-x-0.5 transition-all shrink-0" aria-hidden="true"></i>
                  <% end %>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>

        <!-- Account Upgrade Callout (PRO) -->
        <% if current_user && !current_user.subscribed? %>
          <div class="space-y-1.5 pt-0.5">
            <h3 class="text-[11px] font-semibold uppercase tracking-wider text-zinc-500 px-0.5">
              <%= role_key == "contractor" ? "Também presta serviços?" : "Conta Profissional" %>
            </h3>

            <button type="button"
                    data-action="click->onboarding-widget#openPricingModal"
                    class="w-full text-left group flex items-center justify-between gap-2.5 px-3.5 py-2.5 rounded-xl border border-stone-200 bg-white hover:border-charcoal hover:bg-stone-50 transition-all focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-charcoal cursor-pointer">
              <div class="flex items-center gap-2.5 min-w-0 flex-1">
                <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-brand text-white shrink-0">
                  PRO
                </span>
                <span class="text-xs font-semibold text-charcoal truncate">
                  <%= role_key == "contractor" ? "Conheça a Conta Profissional" : "Ativar Conta Profissional (30 dias grátis)" %>
                </span>
              </div>
              <i data-lucide="chevron-right" class="w-4 h-4 text-zinc-400 group-hover:text-charcoal group-hover:translate-x-0.5 transition-all shrink-0" aria-hidden="true"></i>
            </button>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- Minimized Card State (visible by default) -->
  <div data-onboarding-widget-target="pill"
       class="bg-white rounded-2xl border border-stone-border shadow-md hover:shadow-lg transition-all p-3.5 sm:p-4 text-left">
    <!-- Top action row: Dismiss (X) + Expand (Chevron Up) -->
    <div class="flex items-center justify-between -mt-1 -mx-1 mb-1.5">
      <button type="button"
              data-action="click->onboarding-widget#dismiss"
              aria-label="<%= t('common.close', default: 'Fechar') %>"
              title="<%= t('common.close', default: 'Fechar') %>"
              class="w-6 h-6 rounded-md flex items-center justify-center text-zinc-400 hover:text-charcoal hover:bg-stone-100 transition-colors cursor-pointer bg-transparent border-0 shrink-0 focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-charcoal">
        <i data-lucide="x" class="w-3.5 h-3.5" aria-hidden="true"></i>
      </button>

      <button type="button"
              data-action="click->onboarding-widget#expand"
              aria-label="<%= t('onboarding.expand', default: 'Expandir lista de verificação') %>"
              title="<%= t('onboarding.expand', default: 'Expandir') %>"
              class="w-6 h-6 rounded-md flex items-center justify-center text-zinc-400 hover:text-charcoal hover:bg-stone-100 transition-colors cursor-pointer bg-transparent border-0 shrink-0 focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-charcoal">
        <i data-lucide="chevron-up" class="w-4 h-4" aria-hidden="true"></i>
      </button>
    </div>

    <!-- Main clickable content -->
    <div data-action="click->onboarding-widget#expand"
         role="button"
         tabindex="0"
         aria-label="Abrir lista de verificação de perfil"
         class="flex items-center gap-3.5 cursor-pointer select-none group focus:outline-hidden">
      <!-- Circular Progress Ring -->
      <div class="relative w-12 h-12 shrink-0 flex items-center justify-center"
           role="progressbar"
           aria-valuenow="<%= active_checklist[:percentage] %>"
           aria-valuemin="0"
           aria-valuemax="100"
           aria-label="<%= active_checklist[:completed_count] %> de <%= active_checklist[:total_count] %> etapas concluídas">
        <svg class="w-12 h-12 -rotate-90" viewBox="0 0 48 48" aria-hidden="true">
          <circle cx="24" cy="24" r="20" fill="none" stroke="currentColor" stroke-width="3" class="text-stone-200" />
          <circle cx="24" cy="24" r="20" fill="none" stroke="currentColor" stroke-width="3"
                  stroke-linecap="round"
                  stroke-dasharray="<%= circumference %>"
                  stroke-dashoffset="<%= active_dash_offset %>"
                  data-onboarding-widget-target="pillCircle"
                  class="text-brand transition-all duration-500 ease-out" />
        </svg>
        <span data-onboarding-widget-target="pillFraction"
              class="absolute text-xs font-bold text-charcoal tabular-nums">
          <%= active_checklist[:completed_count] %>/<%= active_checklist[:total_count] %>
        </span>
      </div>

      <!-- Informative Text -->
      <div class="min-w-0 flex-1">
        <h2 class="text-sm font-semibold text-charcoal leading-snug group-hover:text-brand transition-colors">
          Lista de verificação de perfil
        </h2>
        <p class="text-xs text-zinc-500 leading-relaxed mt-0.5">
          Conclua a lista de verificação para aumentar a visibilidade do seu perfil na Guilda.
        </p>
      </div>
    </div>
  </div>
  </div>

  <!-- Pricing / Upgrade Modal -->
  <% if current_user && !current_user.subscribed? %>
    <div data-onboarding-widget-target="pricingModal"
         data-testid="onboarding-pricing-modal"
         role="dialog"
         aria-modal="true"
         aria-labelledby="onboarding-pricing-modal-title"
         class="hidden fixed inset-0 z-[60] flex items-center justify-center p-4 bg-charcoal/60 backdrop-blur-xs">
      <div class="bg-white rounded-xl border border-stone-border shadow-md max-w-2xl w-full max-h-[90vh] overflow-y-auto p-6 sm:p-7 space-y-5">
        <!-- Modal Header -->
        <div class="flex items-start justify-between gap-4">
          <div class="space-y-1.5">
            <span class="inline-flex items-center gap-1.5 text-[11px] font-medium tracking-wide text-zinc-800 bg-stone-100 border border-stone-200 px-2.5 py-0.5 rounded-full">
              <i data-lucide="sparkles" class="w-3 h-3 text-brand" aria-hidden="true"></i>
              <span>Conta Profissional</span>
            </span>
            <h2 id="onboarding-pricing-modal-title" class="font-serif text-xl sm:text-2xl font-bold text-charcoal">
              Valorize seu ofício e amplie seu alcance
            </h2>
            <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed">
              Um único trabalho fechado ou equipe montada pela plataforma já compensa com folga o valor da assinatura.
            </p>
          </div>
          <button type="button"
                  data-action="click->onboarding-widget#closePricingModal"
                  aria-label="<%= t('common.close', default: 'Fechar') %>"
                  class="w-11 h-11 -mr-2 -mt-2 rounded-lg flex items-center justify-center text-zinc-500 hover:text-charcoal hover:bg-stone-100 transition-colors cursor-pointer flex-shrink-0 focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-charcoal">
            <i data-lucide="x" class="w-5 h-5" aria-hidden="true"></i>
          </button>
        </div>

        <!-- Plans Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 items-stretch pt-1">
          <!-- Annual Plan (Recommended) -->
          <div class="p-5 bg-white border border-brand rounded-xl flex flex-col justify-between space-y-5 relative shadow-xs">
            <div class="absolute -top-2.5 left-4 bg-brand text-white text-[10px] uppercase tracking-wider px-2.5 py-0.5 rounded-full font-semibold">
              Melhor Custo-Benefício
            </div>
            <div class="space-y-3">
              <div>
                <div class="text-[11px] uppercase tracking-wider text-brand font-semibold">Assinatura Anual</div>
                <h3 class="font-serif text-lg font-bold text-charcoal">Profissional Anual</h3>
              </div>
              <div class="space-y-0.5">
                <div class="flex items-baseline gap-1">
                  <span class="font-serif text-3xl font-bold text-charcoal">R$ 300</span>
                  <span class="text-xs text-zinc-500">/ano</span>
                </div>
                <span class="text-[11px] text-brand font-medium block">Equivalente a R$ 25/mês (economize 2 meses)</span>
              </div>
              <ul class="space-y-1.5 pt-1 text-xs text-zinc-700">
                <li class="flex items-center gap-2">
                  <i data-lucide="check" class="w-3.5 h-3.5 text-brand shrink-0" aria-hidden="true"></i>
                  <span>Portfólio público permanente</span>
                </li>
                <li class="flex items-center gap-2">
                  <i data-lucide="check" class="w-3.5 h-3.5 text-brand shrink-0" aria-hidden="true"></i>
                  <span>Destaque contínuo nas buscas regionais</span>
                </li>
                <li class="flex items-center gap-2">
                  <i data-lucide="check" class="w-3.5 h-3.5 text-brand shrink-0" aria-hidden="true"></i>
                  <span>Link profissional limpo para propostas</span>
                </li>
              </ul>
            </div>

            <%= button_to checkout_path(plan: :annual), method: :post, data: { turbo: false }, class: "w-full min-h-11 inline-flex items-center justify-center gap-1.5 text-center bg-brand hover:bg-brand-hover text-white py-2.5 px-4 rounded-lg font-medium text-xs sm:text-sm transition-colors shadow-xs cursor-pointer focus:outline-none focus:ring-2 focus:ring-brand focus:ring-offset-2" do %>
              <span>Testar Plano Anual por 30 dias</span>
              <i data-lucide="arrow-right" class="w-3.5 h-3.5" aria-hidden="true"></i>
            <% end %>
          </div>

          <!-- Monthly Plan -->
          <div class="p-5 bg-white border border-stone-border rounded-xl flex flex-col justify-between space-y-5">
            <div class="space-y-3">
              <div>
                <div class="text-[11px] uppercase tracking-wider text-zinc-500 font-semibold">Assinatura Mensal</div>
                <h3 class="font-serif text-lg font-bold text-charcoal">Profissional Mensal</h3>
              </div>
              <div class="space-y-0.5">
                <div class="flex items-baseline gap-1">
                  <span class="font-serif text-3xl font-bold text-charcoal">R$ 30</span>
                  <span class="text-xs text-zinc-500">/mês</span>
                </div>
                <span class="text-[11px] text-zinc-500 block">Cobrança mês a mês sem fidelidade</span>
              </div>
              <ul class="space-y-1.5 pt-1 text-xs text-zinc-700">
                <li class="flex items-center gap-2">
                  <i data-lucide="check" class="w-3.5 h-3.5 text-zinc-500 shrink-0" aria-hidden="true"></i>
                  <span>Todas as ferramentas de portfólio</span>
                </li>
                <li class="flex items-center gap-2">
                  <i data-lucide="check" class="w-3.5 h-3.5 text-zinc-500 shrink-0" aria-hidden="true"></i>
                  <span>Presença no diretório de busca</span>
                </li>
                <li class="flex items-center gap-2">
                  <i data-lucide="check" class="w-3.5 h-3.5 text-zinc-500 shrink-0" aria-hidden="true"></i>
                  <span>Canais de contato direto disponíveis</span>
                </li>
              </ul>
            </div>

            <%= button_to checkout_path(plan: :monthly), method: :post, data: { turbo: false }, class: "w-full min-h-11 inline-flex items-center justify-center gap-1.5 text-center bg-charcoal hover:bg-zinc-800 text-white py-2.5 px-4 rounded-lg font-medium text-xs sm:text-sm transition-colors cursor-pointer focus:outline-none focus:ring-2 focus:ring-charcoal focus:ring-offset-2" do %>
              <span>Testar Plano Mensal por 30 dias</span>
              <i data-lucide="arrow-right" class="w-3.5 h-3.5" aria-hidden="true"></i>
            <% end %>
          </div>
        </div>

        <!-- Modal Footer -->
        <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-3 border-t border-stone-200 text-xs text-zinc-500">
          <span>A primeira cobrança acontece apenas a partir do 31º dia. Cancele quando quiser.</span>
          <button type="button"
                  data-action="click->onboarding-widget#closePricingModal"
                  class="min-h-10 sm:min-h-9 inline-flex items-center font-medium text-xs text-zinc-600 hover:text-charcoal transition-colors cursor-pointer py-2 px-3 rounded-lg focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-charcoal">
            Continuar na conta gratuita
          </button>
        </div>
      </div>
    </div>
  <% end %>
</div>
