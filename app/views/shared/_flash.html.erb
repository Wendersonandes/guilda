<% flash.each do |type, message| %>
  <% Array(message).each do |msg| %>
    <% next if msg.blank? %>
    <%
      is_alert = type.to_s.in?(%w[alert error])
      bg_class = is_alert ? "bg-red-50 border-red-200/80 text-red-800" : "bg-emerald-50 border-emerald-200/80 text-emerald-800"
      icon_name = is_alert ? "alert-circle" : "check-circle-2"
      icon_color = is_alert ? "text-red-600" : "text-emerald-600"
      close_hover = is_alert ? "hover:bg-red-100 text-red-500 hover:text-red-700" : "hover:bg-emerald-100 text-emerald-500 hover:text-emerald-700"
    %>
    <div data-controller="flash"
         data-flash-timeout-value="4000"
         data-action="mouseenter->flash#pause mouseleave->flash#resume"
         class="flex items-center justify-between gap-3 <%= bg_class %> border px-4 py-3 rounded-lg text-sm font-medium mb-5 shadow-sm transition-all duration-300 ease-out"
         role="alert">
      <div class="flex items-center gap-2.5 min-w-0">
        <i data-lucide="<%= icon_name %>" class="w-4 h-4 <%= icon_color %> flex-shrink-0"></i>
        <span class="break-words"><%= msg %></span>
      </div>
      <button type="button"
              data-action="flash#dismiss"
              class="p-1 -mr-1 rounded-md transition-colors cursor-pointer <%= close_hover %> flex-shrink-0"
              aria-label="<%= t('common.close', default: 'Fechar') %>">
        <i data-lucide="x" class="w-3.5 h-3.5"></i>
      </button>
    </div>
  <% end %>
<% end %>
