<% actor ||= (defined?(current_actor) ? current_actor : nil) %>
<div id="nav_notification_badge" class="contents">
  <% if actor %>
    <% count = actor.notifications.unread.count %>
    <% if count > 0 %>
      <span class="absolute -top-1.5 -right-1.5 flex h-3.5 w-3.5 items-center justify-center rounded-full bg-brand text-[8px] font-bold text-white ring-1 ring-white">
        <%= count %>
      </span>
    <% end %>
  <% end %>
</div>
