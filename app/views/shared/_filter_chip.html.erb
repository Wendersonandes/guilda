<%# locals: (label:, href:, remove_label:) %>
<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-medium bg-stone-100 text-charcoal border border-stone-200">
  <%= label %>
  <%= link_to href,
              class: "inline-flex items-center justify-center text-zinc-500 hover:text-charcoal ml-0.5 rounded-full focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-charcoal",
              aria: { label: remove_label },
              data: { turbo_action: "advance", turbo_frame: "_top" } do %>
    <i data-lucide="x" aria-hidden="true" class="w-3 h-3"></i>
  <% end %>
</span>
