<div class="divide-y divide-stone-100" id="sidebar_suggestions">
  <% if current_actor %>
    <% current_actor.suggestions(3).each do |contact| %>
      <div class="flex items-center justify-between py-3 first:pt-0 last:pb-0 gap-2" id="<%= dom_id(contact.receiver, :suggestion) %>">
        <div class="flex items-center gap-2 min-w-0 flex-1">
          <div class="w-8 h-8 rounded-full bg-stone-100 flex items-center justify-center text-charcoal text-xs font-bold border border-stone-border flex-shrink-0">
            <%= contact.receiver.name.first.upcase %>
          </div>
          <div class="flex flex-col min-w-0">
            <%= link_to contact.receiver.name, public_path_for(contact.receiver), data: { turbo_frame: "_top" }, class: "text-xs font-semibold text-charcoal hover:text-brand hover:underline truncate leading-tight transition-colors" %>
            <span class="text-[9px] text-zinc-400 truncate uppercase tracking-wider mt-0.5">Suggested</span>
          </div>
        </div>
        <%= button_to contacts_path(actor_id: contact.receiver.slug, as: :friend), method: :post, form_class: "flex-shrink-0", class: "flex items-center gap-1 text-[11px] bg-white text-brand hover:bg-brand hover:text-white font-semibold px-2 py-1 rounded-md border border-stone-300 transition-all cursor-pointer" do %>
          <i data-lucide="user-plus" class="w-3 h-3 flex-shrink-0"></i>
          <span>Connect</span>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
