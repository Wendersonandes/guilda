<div class="divide-y divide-stone-100" id="sidebar_suggestions">
  <% if current_actor %>
    <% current_actor.suggestions(3).each do |contact| %>
      <% receiver = contact.receiver %>
      <% receiver_profile = receiver.actorable.is_a?(Profile) ? receiver.actorable : nil %>
      <div class="flex items-center justify-between py-3 first:pt-0 last:pb-0 gap-2" id="<%= dom_id(receiver, :suggestion) %>">
        <div class="flex items-center gap-2.5 min-w-0 flex-1">
          <% if receiver.avatar.attached? %>
            <%= image_tag receiver.avatar.variant(:thumb), alt: receiver.name, class: "w-8 h-8 rounded-full object-cover border border-stone-border flex-shrink-0" %>
          <% else %>
            <div class="w-8 h-8 rounded-full bg-stone-100 flex items-center justify-center text-charcoal text-xs font-bold border border-stone-border flex-shrink-0">
              <%= receiver.name.first.upcase %>
            </div>
          <% end %>

          <div class="flex flex-col min-w-0">
            <%= link_to receiver.name, public_path_for(receiver), data: { turbo_frame: "_top" }, class: "text-xs font-semibold text-charcoal hover:text-brand hover:underline truncate leading-tight transition-colors" %>
            <%
              subtitle_parts = []
              if receiver_profile
                subtitle_parts << receiver_profile.occupations.first&.name
                loc = [receiver_profile.city, receiver_profile.state].reject(&:blank?).join(", ")
                subtitle_parts << loc if loc.present?
              end
              subtitle = subtitle_parts.compact.join(" • ").presence || t(".suggested")
            %>
            <span class="text-[10px] text-zinc-500 truncate mt-0.5 leading-tight font-medium" title="<%= subtitle %>">
              <%= subtitle %>
            </span>
          </div>
        </div>

        <%= button_to contacts_path(actor_id: receiver.slug, as: :follower),
                      method: :post,
                      form_class: "flex-shrink-0",
                      class: "flex items-center gap-1 text-[11px] bg-white text-brand hover:bg-brand hover:text-white font-semibold px-2 py-1 rounded-md border border-stone-300 transition-all cursor-pointer" do %>
          <i data-lucide="user-plus" class="w-3 h-3 flex-shrink-0" aria-hidden="true"></i>
          <span><%= t(".follow", default: t(".connect")) %></span>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
