<%= tag.div id: dom_id(activity), class: "bg-white rounded-lg border border-stone-border p-5 hover:shadow-sm transition-all duration-200" do %>
  <div class="flex items-start gap-4">
    <!-- Avatar -->
    <%
      is_group = activity.author.actorable_type == "Group"
      avatar_rounded = is_group ? "rounded-lg" : "rounded-full"
      avatar_bg = is_group ? "bg-stone-200 text-charcoal border-stone-300" : "bg-stone-100 text-charcoal border-stone-border"
    %>
    <% if activity.author.avatar&.attached? %>
      <%= image_tag activity.author.avatar.variant(:thumb), class: "w-10 h-10 #{avatar_rounded} object-cover border border-stone-100 flex-shrink-0" %>
    <% else %>
      <div class="w-10 h-10 <%= avatar_rounded %> <%= avatar_bg %> flex items-center justify-center text-sm font-bold border flex-shrink-0">
        <%= activity.author.name.first.upcase %>
      </div>
    <% end %>

    <!-- Content -->
    <div class="flex-1 min-w-0">
      <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-zinc-500 mb-2">
        <%= link_to activity.author.name, public_path_for(activity.author), class: "font-semibold text-charcoal hover:text-brand transition-colors" %>
        <span class="text-stone-300">&middot;</span>
        <%= link_to activity_path(activity), class: "text-xs text-zinc-400 hover:text-brand transition-colors" do %>
          <%= time_ago_in_words(activity.created_at) %> ago
        <% end %>
        <% if activity.represented_author? && activity.user_author %>
          <span class="text-[10px] font-medium bg-stone-100 text-zinc-500 px-1.5 py-0.5 rounded flex items-center gap-1 border border-stone-200">
            <i data-lucide="shield-check" class="w-3 h-3 text-zinc-400"></i>
            <span>via <%= activity.user_author.email %></span>
          </span>
        <% end %>
      </div>

      <% activity.activity_objects.each do |ao| %>
        <div class="text-charcoal space-y-1">
          <% if ao.title.present? %>
            <h3 class="font-serif font-bold text-charcoal text-lg leading-tight"><%= ao.title %></h3>
          <% end %>
          <% if (rendered_text = render_with_mentions(ao)).present? %>
            <p class="text-sm leading-relaxed text-zinc-700 whitespace-pre-line"><%= rendered_text %></p>
          <% end %>
        </div>
      <% end %>

      <% if activity.activity_objects.empty? && (desc = activity_description(activity)) %>
        <p class="text-sm leading-relaxed text-zinc-700"><%= desc %></p>
      <% end %>

      <div class="flex items-center justify-between mt-4 pt-3 border-t border-stone-150 text-sm text-zinc-500">
        <%= render "shared/activity_actions", activity: activity %>
        <% if activity.parent.present? %>
          <div class="flex items-center gap-1 text-xs text-zinc-400 ml-auto">
            <i data-lucide="corner-down-right" class="w-3.5 h-3.5"></i>
            <span>in reply to <%= link_to activity.parent.author.name, activity_path(activity.parent), class: "font-medium text-zinc-500 hover:text-brand hover:underline" %></span>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
