<% group ||= @group %>

<div class="bg-white rounded-lg border border-stone-border overflow-hidden">
  <% if group.actor.cover_image.attached? %>
    <%= image_tag group.actor.cover_image.variant(:thumb), class: "w-full h-44 object-cover" %>
  <% else %>
    <div class="w-full h-32 bg-stone-50 border-b border-stone-border flex items-center justify-center text-zinc-300">
      <i data-lucide="image" class="w-8 h-8"></i>
    </div>
  <% end %>
  <div class="p-6 -mt-10 sm:-mt-12 relative">
    <div class="flex items-start gap-4">
      <div class="w-20 h-20 bg-white rounded-lg p-1 flex-shrink-0 border border-stone-border overflow-hidden shadow-sm">
        <% if group.actor.avatar.attached? %>
          <%= image_tag group.actor.avatar.variant(:thumb), class: "w-full h-full rounded-lg object-cover" %>
        <% else %>
          <div class="w-full h-full rounded-lg bg-stone-200 text-charcoal flex items-center justify-center font-bold text-2xl border border-stone-300">
            <%= group.name.first.upcase %>
          </div>
        <% end %>
      </div>
      
      <div class="flex-1 min-w-0 pt-10 sm:pt-12">
        <div class="flex flex-wrap items-center gap-2">
          <h1 class="text-2xl font-serif font-bold text-charcoal tracking-tight truncate"><%= group.name %></h1>
          <span class="text-[10px] font-semibold px-2 py-0.5 rounded-md inline-flex items-center gap-1 bg-stone-100 text-zinc-700 border border-stone-200">
            <i data-lucide="<%= group.public_group? ? 'globe' : 'lock' %>" class="w-2.5 h-2.5 text-zinc-400"></i>
            <span><%= group.public_group? ? "Public" : "Private" %></span>
          </span>
        </div>
        
        <% if group.description.present? %>
          <p class="text-sm text-zinc-650 mt-2 leading-relaxed"><%= group.description %></p>
        <% end %>
        
        <div class="flex gap-4 mt-3 text-xs text-zinc-400 font-medium">
          <span class="flex items-center gap-1"><i data-lucide="file-text" class="w-3.5 h-3.5"></i> <%= group.actor.authored_activities.posts.count %> posts</span>
          <span class="flex items-center gap-1"><i data-lucide="users" class="w-3.5 h-3.5"></i> <%= group.actor.sent_contacts.active.count %> members</span>
        </div>

        <% if current_actor && (current_actor == group.actor || current_actor.can?(:update, :group, group.actor)) %>
          <div class="mt-4 flex items-center gap-3 pt-3 border-t border-stone-100">
            <%= link_to edit_group_path(group), class: "inline-flex items-center gap-1 text-xs bg-white hover:bg-stone-50 text-zinc-700 font-semibold px-3 py-1.5 rounded-lg border border-stone-300 transition-colors shadow-sm cursor-pointer" do %>
              <i data-lucide="settings" class="w-3.5 h-3.5"></i>
              <span>Edit Group</span>
            <% end %>
            <% if current_actor && (current_actor == group.actor || current_actor.can?(:destroy, :group, group.actor)) %>
              <%= button_to group_path(group), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this group?" }, class: "inline-flex items-center gap-1 text-xs bg-white hover:bg-stone-50 text-red-650 hover:text-red-700 border border-stone-300 px-3 py-1.5 rounded-lg font-medium transition-colors cursor-pointer" do %>
                <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                <span>Delete</span>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
