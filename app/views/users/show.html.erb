<%= content_for :title, t(".title") %>

<h1 class="text-2xl font-serif font-bold text-charcoal tracking-tight mb-6"><%= t(".title") %></h1>

<div class="bg-white rounded-lg border border-stone-border divide-y divide-stone-100 overflow-hidden shadow-sm">
  <!-- Email Setting -->
  <div class="p-5 flex items-center justify-between hover:bg-stone-50/50 transition-colors">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-lg bg-stone-50 flex items-center justify-center text-zinc-500 border border-stone-200">
        <i data-lucide="mail" class="w-5 h-5"></i>
      </div>
      <div>
        <h3 class="text-sm font-semibold text-charcoal"><%= t(".email") %></h3>
        <p class="text-sm text-zinc-500 mt-0.5"><%= current_user.email %></p>
      </div>
    </div>
    <%= link_to edit_account_path, class: "flex items-center gap-1 text-xs bg-white text-zinc-700 hover:bg-stone-50 font-semibold px-3 py-1.5 rounded-lg border border-stone-300 transition-colors shadow-sm cursor-pointer" do %>
      <i data-lucide="edit-3" class="w-3.5 h-3.5"></i>
      <span><%= t(".edit") %></span>
    <% end %>
  </div>

  <!-- Profile Setting -->
  <% if current_actor %>
    <div class="p-5 flex items-center justify-between hover:bg-stone-50/50 transition-colors">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-lg bg-stone-50 flex items-center justify-center text-zinc-500 border border-stone-200">
          <i data-lucide="user" class="w-5 h-5"></i>
        </div>
        <div>
          <h3 class="text-sm font-semibold text-charcoal"><%= t(".public_profile") %></h3>
          <p class="text-sm text-zinc-500 mt-0.5"><%= current_actor.name %></p>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <%= link_to public_path_for(current_actor), class: "flex items-center gap-1 text-xs bg-white text-zinc-700 hover:bg-stone-50 font-semibold px-3 py-1.5 rounded-lg border border-stone-300 transition-colors shadow-sm cursor-pointer" do %>
          <i data-lucide="eye" class="w-3.5 h-3.5"></i>
          <span><%= t(".view") %></span>
        <% end %>
        <%= link_to edit_my_profile_path, class: "flex items-center gap-1 text-xs bg-white text-zinc-700 hover:bg-stone-50 font-semibold px-3 py-1.5 rounded-lg border border-stone-300 transition-colors shadow-sm cursor-pointer" do %>
          <i data-lucide="edit-3" class="w-3.5 h-3.5"></i>
          <span><%= t(".edit") %></span>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Subscription Setting -->
  <div class="p-5 flex items-center justify-between hover:bg-stone-50/50 transition-colors">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-lg bg-stone-50 flex items-center justify-center text-zinc-500 border border-stone-200">
        <i data-lucide="credit-card" class="w-5 h-5"></i>
      </div>
      <div>
        <h3 class="text-sm font-semibold text-charcoal">Assinatura</h3>
        <p class="text-sm text-zinc-500 mt-0.5">
          <% if current_user.subscribed? %>
            <span class="inline-flex items-center gap-1.5 text-emerald-700 font-medium text-xs bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-200">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
              Assinatura Ativa
            </span>
          <% elsif current_user.subscription&.on_trial? %>
            <span class="inline-flex items-center gap-1.5 text-amber-700 font-medium text-xs bg-amber-50 px-2 py-0.5 rounded-full border border-amber-200">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
              Período de Teste
            </span>
          <% else %>
            <span class="text-xs text-zinc-500">Nenhum plano ativo</span>
          <% end %>
        </p>
      </div>
    </div>
    <div class="flex items-center gap-2">
      <% if current_user.payment_processor&.processor_id.present? %>
        <%= button_to billing_portal_path, method: :post, data: { turbo: false }, class: "flex items-center gap-1 text-xs bg-white text-zinc-700 hover:bg-stone-50 font-semibold px-3 py-1.5 rounded-lg border border-stone-300 transition-colors shadow-sm cursor-pointer" do %>
          <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
          <span>Gerenciar assinatura</span>
        <% end %>
      <% else %>
        <%= link_to root_path(anchor: "pricing"), class: "flex items-center gap-1 text-xs bg-brand text-white hover:bg-brand-hover font-semibold px-3 py-1.5 rounded-lg transition-colors shadow-sm cursor-pointer" do %>
          <i data-lucide="sparkles" class="w-3.5 h-3.5"></i>
          <span>Ver planos</span>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
