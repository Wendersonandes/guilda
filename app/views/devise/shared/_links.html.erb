<div class="mt-6 flex flex-col items-center gap-3 text-sm">
  <div class="w-full flex items-center gap-3 text-zinc-400 text-xs uppercase tracking-wider">
    <span class="flex-1 border-t border-stone-200"></span>
    <span><%= t("auth.shared.links.or") %></span>
    <span class="flex-1 border-t border-stone-200"></span>
  </div>

  <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-1.5">
    <%- if controller_name != 'sessions' %>
      <%= link_to t("auth.shared.links.sign_in"), new_session_path(resource_name), class: "text-brand hover:text-brand-hover font-medium transition-colors" %>
    <% end %>

    <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
      <%= link_to t("auth.shared.links.sign_up"), new_registration_path(resource_name), class: "text-brand hover:text-brand-hover font-medium transition-colors" %>
    <% end %>

    <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
      <%= link_to t("auth.shared.links.forgot_password"), new_password_path(resource_name), class: "text-zinc-500 hover:text-charcoal transition-colors" %>
    <% end %>

    <%- if devise_mapping.confirmable? && controller_name != 'confirmations' %>
      <%= link_to t("auth.shared.links.resend_confirmation"), new_confirmation_path(resource_name), class: "text-zinc-500 hover:text-charcoal transition-colors" %>
    <% end %>

    <%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
      <%= link_to t("auth.shared.links.resend_unlock"), new_unlock_path(resource_name), class: "text-zinc-500 hover:text-charcoal transition-colors" %>
    <% end %>

    <%- if devise_mapping.omniauthable? %>
      <%- resource_class.omniauth_providers.each do |provider| %>
        <%= button_to t("auth.shared.links.omniauth", provider: OmniAuth::Utils.camelize(provider)), omniauth_authorize_path(resource_name, provider), data: { turbo: false }, class: "text-brand hover:text-brand-hover font-medium bg-transparent border-0 cursor-pointer transition-colors" %>
      <% end %>
    <% end %>
  </div>
</div>
