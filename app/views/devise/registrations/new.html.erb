<%
  is_contractor = (params[:intent] == "contractor" || params[:plan] == "none")
  current_intent = is_contractor ? "contractor" : "professional"
  active_plan = is_contractor ? nil : (selected_plan || Plan.find("annual"))
%>

<div class="max-w-md mx-auto my-8 space-y-6"
     data-controller="signup-intent"
     data-signup-intent-selected-plan-value="<%= active_plan&.id || 'annual' %>"
     data-signup-intent-intent-value="<%= current_intent %>">

  <!-- Multi-Step Journey Indicator (Signup Skill: Continuity & Effort Clarity) -->
  <nav aria-label="Etapas do cadastro" class="flex items-center justify-center gap-2 text-xs font-medium text-zinc-500">
    <span class="inline-flex items-center gap-1.5 text-brand font-semibold">
      <span class="w-5 h-5 rounded-full bg-brand text-white inline-flex items-center justify-center text-[11px] font-bold">1</span>
      <span>Conta</span>
    </span>
    <span class="w-6 h-px bg-stone-300" aria-hidden="true"></span>
    <span class="inline-flex items-center gap-1.5 text-zinc-400">
      <span class="w-5 h-5 rounded-full bg-stone-100 text-zinc-400 border border-stone-200 inline-flex items-center justify-center text-[11px] font-bold">2</span>
      <span>Perfil</span>
    </span>
    <span class="w-6 h-px bg-stone-300" aria-hidden="true"></span>
    <span class="inline-flex items-center gap-1.5 text-zinc-400">
      <span class="w-5 h-5 rounded-full bg-stone-100 text-zinc-400 border border-stone-200 inline-flex items-center justify-center text-[11px] font-bold">3</span>
      <span data-signup-intent-target="submitNote" class="<%= 'hidden' if is_contractor %>">Ativação (30 dias grátis)</span>
      <span class="<%= 'hidden' unless is_contractor %>">Explorar Catálogo</span>
    </span>
  </nav>

  <div class="text-center">
    <div class="w-12 h-12 bg-stone-100 text-brand rounded-full flex items-center justify-center mx-auto mb-3 border border-stone-border shadow-xs">
      <i data-lucide="user-plus" class="w-6 h-6" aria-hidden="true"></i>
    </div>
    <h1 class="text-2xl font-serif font-bold text-charcoal tracking-tight"><%= t("auth.registrations.new.title") %></h1>
    <p class="text-sm text-zinc-500 mt-1">
      Junte-se à comunidade técnica de trabalhadores e prestadores de serviço da cultura.
    </p>
  </div>

  <div class="bg-white rounded-xl border border-stone-border p-6 space-y-5 shadow-xs">
    <!-- Intent Selector (Professional vs Contractor) -->
    <div class="space-y-1.5">
      <span class="block text-xs font-semibold uppercase tracking-wider text-zinc-500">Como você usará a Guilda?</span>
      <div class="grid grid-cols-2 p-1 bg-stone-100 rounded-lg gap-1 border border-stone-200" role="tablist" aria-label="Modalidade de conta">
        <a href="<%= url_for(intent: :professional, plan: (active_plan&.id || :annual)) %>"
           role="tab"
           aria-selected="<%= !is_contractor %>"
           data-signup-intent-target="tabProfessional"
           data-action="click->signup-intent#selectProfessional"
           class="flex items-center justify-center gap-1.5 py-2 px-3 rounded-md text-xs font-semibold transition-all cursor-pointer <%= !is_contractor ? 'bg-charcoal text-white shadow-xs' : 'text-zinc-600 hover:text-charcoal bg-transparent' %>">
          <i data-lucide="briefcase" class="w-3.5 h-3.5 shrink-0" aria-hidden="true"></i>
          <span><%= t("auth.registrations.new.tab_professional") %></span>
        </a>

        <a href="<%= url_for(intent: :contractor, plan: :none) %>"
           role="tab"
           aria-selected="<%= is_contractor %>"
           data-signup-intent-target="tabContractor"
           data-action="click->signup-intent#selectContractor"
           class="flex items-center justify-center gap-1.5 py-2 px-3 rounded-md text-xs font-semibold transition-all cursor-pointer <%= is_contractor ? 'bg-charcoal text-white shadow-xs' : 'text-zinc-600 hover:text-charcoal bg-transparent' %>">
          <i data-lucide="search" class="w-3.5 h-3.5 shrink-0" aria-hidden="true"></i>
          <span><%= t("auth.registrations.new.tab_contractor") %></span>
        </a>
      </div>
    </div>

    <!-- Professional Value Proposition Card -->
    <div data-signup-intent-target="panelProfessional"
         class="p-4 rounded-lg bg-stone-50 border border-stone-200 space-y-3 <%= 'hidden' if is_contractor %>">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold text-charcoal flex items-center gap-1.5">
          <i data-lucide="sparkles" class="w-4 h-4 text-brand" aria-hidden="true"></i>
          <span>Vantagens da Conta Profissional</span>
        </span>
        <span class="text-[11px] font-semibold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded-full">
          30 dias grátis • R$ 0 hoje
        </span>
      </div>

      <ul class="text-xs text-zinc-600 space-y-1.5 leading-relaxed">
        <li class="flex items-start gap-1.5">
          <i data-lucide="check" class="w-3.5 h-3.5 text-emerald-600 shrink-0 mt-0.5" aria-hidden="true"></i>
          <span>Destaque nas buscas de profissionais por cidade e até 3 especialidades.</span>
        </li>
        <li class="flex items-start gap-1.5">
          <i data-lucide="check" class="w-3.5 h-3.5 text-emerald-600 shrink-0 mt-0.5" aria-hidden="true"></i>
          <span>Portfólio técnico com ficha técnica e galeria de imagens para comprovar seu ofício.</span>
        </li>
        <li class="flex items-start gap-1.5">
          <i data-lucide="check" class="w-3.5 h-3.5 text-emerald-600 shrink-0 mt-0.5" aria-hidden="true"></i>
          <span>Botão de contato direto no WhatsApp e redes sem taxa de intermediação.</span>
        </li>
      </ul>

      <!-- Plan Switcher -->
      <div class="pt-2 border-t border-stone-200">
        <span class="block text-[11px] font-semibold uppercase tracking-wider text-zinc-500 mb-2">
          Escolha o plano para o término do período de teste:
        </span>
        <div class="grid grid-cols-2 gap-2" role="radiogroup" aria-label="Escolha o plano de assinatura">
          <% annual_plan = Plan.find("annual") %>
          <% monthly_plan = Plan.find("monthly") %>
          <% current_plan_id = active_plan&.id || "annual" %>

          <button type="button"
                  data-signup-intent-target="planOption"
                  data-plan-id="annual"
                  data-action="click->signup-intent#choosePlan"
                  class="relative flex flex-col p-2.5 rounded-lg border text-left transition-colors bg-white cursor-pointer <%= current_plan_id == 'annual' ? 'border-brand ring-1 ring-brand' : 'border-stone-200 hover:border-stone-300' %>">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-charcoal">Anual</span>
              <i data-lucide="check" data-check-icon class="w-3.5 h-3.5 text-brand shrink-0 <%= 'hidden' unless current_plan_id == 'annual' %>" aria-hidden="true"></i>
            </div>
            <span class="text-[11px] text-zinc-600 mt-0.5">R$ 300/ano <span class="text-brand font-medium">(R$ 25/mês)</span></span>
            <span class="text-[10px] text-emerald-700 font-medium mt-1">Economia de R$ 60</span>
          </button>

          <button type="button"
                  data-signup-intent-target="planOption"
                  data-plan-id="monthly"
                  data-action="click->signup-intent#choosePlan"
                  class="relative flex flex-col p-2.5 rounded-lg border text-left transition-colors bg-white cursor-pointer <%= current_plan_id == 'monthly' ? 'border-brand ring-1 ring-brand' : 'border-stone-200 hover:border-stone-300' %>">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-charcoal">Mensal</span>
              <i data-lucide="check" data-check-icon class="w-3.5 h-3.5 text-brand shrink-0 <%= 'hidden' unless current_plan_id == 'monthly' %>" aria-hidden="true"></i>
            </div>
            <span class="text-[11px] text-zinc-600 mt-0.5">R$ 30/mês</span>
            <span class="text-[10px] text-zinc-500 mt-1">Sem fidelidade</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Contractor Value Proposition Card -->
    <div data-signup-intent-target="panelContractor"
         class="p-4 rounded-lg bg-stone-50 border border-stone-200 space-y-2.5 <%= 'hidden' unless is_contractor %>">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold text-charcoal flex items-center gap-1.5">
          <i data-lucide="users" class="w-4 h-4 text-brand" aria-hidden="true"></i>
          <span>Acesso Contratante</span>
        </span>
        <span class="text-[11px] font-semibold text-zinc-700 bg-white border border-stone-200 px-2 py-0.5 rounded-full">
          100% Gratuito
        </span>
      </div>

      <ul class="text-xs text-zinc-600 space-y-1.5 leading-relaxed">
        <li class="flex items-start gap-1.5">
          <i data-lucide="check" class="w-3.5 h-3.5 text-emerald-600 shrink-0 mt-0.5" aria-hidden="true"></i>
          <span>Pesquisa completa de profissionais por especialidade, estado, cidade e disponibilidade.</span>
        </li>
        <li class="flex items-start gap-1.5">
          <i data-lucide="check" class="w-3.5 h-3.5 text-emerald-600 shrink-0 mt-0.5" aria-hidden="true"></i>
          <span>Contato direto em 1 clique com profissionais no WhatsApp e redes para cotações.</span>
        </li>
        <li class="flex items-start gap-1.5">
          <i data-lucide="check" class="w-3.5 h-3.5 text-emerald-600 shrink-0 mt-0.5" aria-hidden="true"></i>
          <span>Siga e organize sua rede de talentos de confiança para suas próximas produções.</span>
        </li>
      </ul>
    </div>

    <!-- 1-Click Fast Track: Google OAuth -->
    <%= render "devise/shared/omniauth_buttons", text: "Cadastrar com o Google", plan: (is_contractor ? "none" : (active_plan&.id || "annual")) %>

    <!-- Email & Password Form -->
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= hidden_field_tag :plan, (is_contractor ? "none" : (active_plan&.id || "annual")), data: { signup_intent_target: "planInput" } %>

      <div class="space-y-4">
        <div class="space-y-1">
          <label for="user_profile_name" data-signup-intent-target="nameLabel" class="block text-sm font-medium text-zinc-700">
            <%= is_contractor ? t("auth.registrations.new.display_name_contractor") : t("auth.registrations.new.display_name") %>
          </label>
          <%= f.text_field :profile_name,
                autofocus: true,
                autocomplete: "name",
                placeholder: (is_contractor ? t("auth.registrations.new.display_name_placeholder_contractor") : t("auth.registrations.new.display_name_placeholder")),
                data: { signup_intent_target: "nameInput" },
                class: "w-full min-h-11 rounded-lg border border-stone-300 px-3 py-2 text-sm bg-white text-charcoal placeholder-zinc-400 focus:outline-none focus:ring-1 focus:ring-charcoal focus:border-charcoal transition-shadow" %>
        </div>

        <div class="space-y-1">
          <%= f.label :email, class: "block text-sm font-medium text-zinc-700" %>
          <%= f.email_field :email,
                autocomplete: "email",
                placeholder: t("auth.registrations.new.email_placeholder"),
                class: "w-full min-h-11 rounded-lg border border-stone-300 px-3 py-2 text-sm bg-white text-charcoal placeholder-zinc-400 focus:outline-none focus:ring-1 focus:ring-charcoal focus:border-charcoal transition-shadow" %>
        </div>

        <div class="space-y-1" data-controller="password-visibility">
          <div class="flex items-center justify-between">
            <%= f.label :password, class: "block text-sm font-medium text-zinc-700" %>
            <% if @minimum_password_length %>
              <span class="text-[11px] text-zinc-400"><%= t("auth.registrations.new.password_minimum", count: @minimum_password_length) %></span>
            <% end %>
          </div>
          <div class="relative">
            <%= f.password_field :password,
                  autocomplete: "new-password",
                  placeholder: "••••••••",
                  data: { password_visibility_target: "input" },
                  class: "w-full min-h-11 rounded-lg border border-stone-300 pl-3 pr-10 py-2 text-sm bg-white text-charcoal placeholder-zinc-400 focus:outline-none focus:ring-1 focus:ring-charcoal focus:border-charcoal transition-shadow" %>
            <button type="button"
                    data-action="click->password-visibility#toggle"
                    aria-label="Ver senha"
                    title="Ver senha"
                    class="absolute inset-y-0 right-0 pr-3 flex items-center text-zinc-400 hover:text-zinc-600 cursor-pointer transition-colors bg-transparent border-0">
              <i data-lucide="eye" data-password-visibility-target="icon" class="w-4 h-4" aria-hidden="true"></i>
            </button>
          </div>
        </div>

        <%= f.submit (is_contractor ? t("auth.registrations.new.submit_contractor") : t("auth.registrations.new.submit_with_plan")),
              data: { signup_intent_target: "submitButton" },
              class: "w-full min-h-11 bg-charcoal hover:bg-zinc-800 text-white rounded-lg px-4 py-2.5 text-sm font-medium transition-colors cursor-pointer mt-2" %>

        <p data-signup-intent-target="submitNote" class="text-[11px] text-center text-zinc-500 <%= 'hidden' if is_contractor %>">
          Após configurar seu perfil, você ativará seus 30 dias gratuitos no ambiente seguro do Stripe. Cancele quando quiser antes do fim do período sem nenhuma cobrança.
        </p>
      </div>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</div>
