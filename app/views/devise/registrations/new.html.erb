<%
  is_contractor = (params[:intent] == "contractor" || params[:plan] == "none")
  current_intent = is_contractor ? "contractor" : "professional"
  active_plan = is_contractor ? nil : (selected_plan || Plan.find("annual"))
%>

<div class="max-w-md mx-auto my-8 space-y-6"
     data-controller="signup-intent"
     data-signup-intent-selected-plan-value="<%= active_plan&.id || 'annual' %>"
     data-signup-intent-intent-value="<%= current_intent %>">

  <div class="text-center space-y-1">
    <h1 class="text-2xl font-serif font-bold text-charcoal tracking-tight"><%= t("auth.registrations.new.title") %></h1>
    <p class="text-sm text-zinc-500">
      <%= t("auth.registrations.new.subtitle") %>
    </p>
  </div>

  <div class="bg-white rounded-xl border border-stone-border p-6 space-y-5 shadow-xs">
    <!-- Intent Selector (Professional vs Contractor) -->
    <div class="space-y-1.5">
      <span class="block text-xs font-semibold uppercase tracking-wider text-zinc-500">Como você usará a Guilda?</span>
      <div class="grid grid-cols-2 p-1 bg-stone-100 rounded-lg gap-1 border border-stone-200" role="tablist" aria-label="Modalidade de conta">
        <button type="button"
                role="tab"
                aria-selected="<%= !is_contractor %>"
                data-signup-intent-target="tabProfessional"
                data-action="click->signup-intent#selectProfessional"
                class="flex items-center justify-center gap-1.5 py-2 px-3 rounded-md text-xs font-semibold transition-all cursor-pointer <%= !is_contractor ? 'bg-charcoal text-white shadow-xs' : 'text-zinc-600 hover:text-charcoal bg-transparent' %>">
          <i data-lucide="briefcase" class="w-3.5 h-3.5 shrink-0" aria-hidden="true"></i>
          <span><%= t("auth.registrations.new.tab_professional") %></span>
        </button>

        <button type="button"
                role="tab"
                aria-selected="<%= is_contractor %>"
                data-signup-intent-target="tabContractor"
                data-action="click->signup-intent#selectContractor"
                class="flex items-center justify-center gap-1.5 py-2 px-3 rounded-md text-xs font-semibold transition-all cursor-pointer <%= is_contractor ? 'bg-charcoal text-white shadow-xs' : 'text-zinc-600 hover:text-charcoal bg-transparent' %>">
          <i data-lucide="search" class="w-3.5 h-3.5 shrink-0" aria-hidden="true"></i>
          <span><%= t("auth.registrations.new.tab_contractor") %></span>
        </button>
      </div>
    </div>

    <!-- Professional Value Proposition Card -->
    <div data-signup-intent-target="panelProfessional"
         class="p-4 rounded-lg bg-stone-50 border border-stone-200 space-y-3 <%= 'hidden' if is_contractor %>">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold text-charcoal flex items-center gap-1.5">
          <i data-lucide="sparkles" class="w-4 h-4 text-brand" aria-hidden="true"></i>
          <span>Vantagens da Conta Profissional</span>
        </span>
        <span class="text-[11px] font-semibold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded-full">
          30 dias grátis • R$ 0 hoje
        </span>
      </div>

      <ul class="text-xs text-zinc-600 space-y-1.5 leading-relaxed">
        <li class="flex items-start gap-1.5">
          <i data-lucide="check" class="w-3.5 h-3.5 text-emerald-600 shrink-0 mt-0.5" aria-hidden="true"></i>
          <span>Destaque nas buscas por profissionais.</span>
        </li>
        <li class="flex items-start gap-1.5">
          <i data-lucide="check" class="w-3.5 h-3.5 text-emerald-600 shrink-0 mt-0.5" aria-hidden="true"></i>
          <span>Apresente seu portfólio com galeria de imagens.</span>
        </li>
        <li class="flex items-start gap-1.5">
          <i data-lucide="check" class="w-3.5 h-3.5 text-emerald-600 shrink-0 mt-0.5" aria-hidden="true"></i>
          <span>Contato direto: sem taxa de intermediação.</span>
        </li>
      </ul>

      <!-- Plan Switcher -->
      <div class="pt-2 border-t border-stone-200">
        <span class="block text-[11px] font-semibold uppercase tracking-wider text-zinc-500 mb-2">
          Escolha o plano para o término do período de teste:
        </span>
        <div class="grid grid-cols-2 gap-2" role="radiogroup" aria-label="Escolha o plano de assinatura">
          <% annual_plan = Plan.find("annual") %>
          <% monthly_plan = Plan.find("monthly") %>
          <% current_plan_id = active_plan&.id || "annual" %>

          <button type="button"
                  role="radio"
                  aria-checked="<%= current_plan_id == 'annual' %>"
                  data-signup-intent-target="planOption planAnnual"
                  data-plan-id="annual"
                  data-action="click->signup-intent#selectAnnual"
                  class="relative flex flex-col p-2.5 rounded-lg border text-left transition-colors bg-white cursor-pointer <%= current_plan_id == 'annual' ? 'border-brand ring-1 ring-brand' : 'border-stone-200 hover:border-stone-300' %>">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-charcoal">Anual</span>
              <span data-check-icon data-signup-intent-target="checkAnnual" class="<%= 'hidden' unless current_plan_id == 'annual' %>">
                <i data-lucide="check" class="w-3.5 h-3.5 text-brand shrink-0" aria-hidden="true"></i>
              </span>
            </div>
            <span class="text-[11px] text-zinc-600 mt-0.5">R$ 300/ano <span class="text-brand font-medium">(R$ 25/mês)</span></span>
            <span class="text-[10px] text-emerald-700 font-medium mt-1">Economia de R$ 60</span>
          </button>

          <button type="button"
                  role="radio"
                  aria-checked="<%= current_plan_id == 'monthly' %>"
                  data-signup-intent-target="planOption planMonthly"
                  data-plan-id="monthly"
                  data-action="click->signup-intent#selectMonthly"
                  class="relative flex flex-col p-2.5 rounded-lg border text-left transition-colors bg-white cursor-pointer <%= current_plan_id == 'monthly' ? 'border-brand ring-1 ring-brand' : 'border-stone-200 hover:border-stone-300' %>">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-charcoal">Mensal</span>
              <span data-check-icon data-signup-intent-target="checkMonthly" class="<%= 'hidden' unless current_plan_id == 'monthly' %>">
                <i data-lucide="check" class="w-3.5 h-3.5 text-brand shrink-0" aria-hidden="true"></i>
              </span>
            </div>
            <span class="text-[11px] text-zinc-600 mt-0.5">R$ 30/mês</span>
            <span class="text-[10px] text-zinc-500 mt-1">Sem fidelidade</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Contractor Value Proposition Card -->
    <div data-signup-intent-target="panelContractor"
         class="p-4 rounded-lg bg-stone-50 border border-stone-200 space-y-2.5 <%= 'hidden' unless is_contractor %>">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold text-charcoal flex items-center gap-1.5">
          <i data-lucide="users" class="w-4 h-4 text-brand" aria-hidden="true"></i>
          <span>Acesso Contratante</span>
        </span>
        <span class="text-[11px] font-semibold text-zinc-700 bg-white border border-stone-200 px-2 py-0.5 rounded-full">
          100% Gratuito
        </span>
      </div>

      <ul class="text-xs text-zinc-600 space-y-1.5 leading-relaxed">
        <li class="flex items-start gap-1.5">
          <i data-lucide="check" class="w-3.5 h-3.5 text-emerald-600 shrink-0 mt-0.5" aria-hidden="true"></i>
          <span>Pesquisa completa de profissionais por especialidade, estado, cidade e disponibilidade.</span>
        </li>
        <li class="flex items-start gap-1.5">
          <i data-lucide="check" class="w-3.5 h-3.5 text-emerald-600 shrink-0 mt-0.5" aria-hidden="true"></i>
          <span>Contato direto em 1 clique com profissionais no WhatsApp e redes para cotações.</span>
        </li>
        <li class="flex items-start gap-1.5">
          <i data-lucide="check" class="w-3.5 h-3.5 text-emerald-600 shrink-0 mt-0.5" aria-hidden="true"></i>
          <span>Siga e organize sua rede de talentos de confiança para suas próximas produções.</span>
        </li>
      </ul>
    </div>

    <!-- 1-Click Fast Track: Google OAuth -->
    <%= render "devise/shared/omniauth_buttons",
               text: "Cadastrar com o Google",
               plan: (is_contractor ? "none" : (active_plan&.id || "annual")),
               intent: current_intent %>

    <p data-signup-intent-target="submitNote" class="text-[11px] text-center text-zinc-500 <%= 'hidden' if is_contractor %>">
      Após configurar seu perfil, você ativará seus 30 dias gratuitos no ambiente seguro do Stripe. Cancele quando quiser antes do fim do período sem nenhuma cobrança.
    </p>

    <% if Flipper.enabled?(:password_authentication) %>
      <!-- Development & Test Fallback Form -->
      <details class="pt-2 text-xs border-t border-stone-100">
        <summary class="cursor-pointer text-zinc-400 hover:text-zinc-600 py-1 select-none text-center">
          Ou cadastrar com e-mail e senha (ambiente local/testes)
        </summary>
        <div class="pt-3">
          <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
            <%= render "devise/shared/error_messages", resource: resource %>
            <%= hidden_field_tag :plan, (is_contractor ? "none" : (active_plan&.id || "annual")), data: { signup_intent_target: "planInput" } %>
            <%= hidden_field_tag :intent, current_intent, data: { signup_intent_target: "intentInput" } %>

            <div class="space-y-3">
              <div>
                <%= f.label :profile_name, "Nome do Perfil", class: "block font-medium text-zinc-700 mb-1" %>
                <%= f.text_field :profile_name, placeholder: "Seu nome ou nome artístico", class: "w-full rounded-lg border border-stone-300 px-3 py-2 text-xs bg-white text-charcoal" %>
              </div>
              <div>
                <%= f.label :email, "E-mail", class: "block font-medium text-zinc-700 mb-1" %>
                <%= f.email_field :email, placeholder: "seu@email.com", class: "w-full rounded-lg border border-stone-300 px-3 py-2 text-xs bg-white text-charcoal" %>
              </div>
              <div>
                <%= f.label :password, "Senha", class: "block font-medium text-zinc-700 mb-1" %>
                <%= f.password_field :password, placeholder: "••••••••", class: "w-full rounded-lg border border-stone-300 px-3 py-2 text-xs bg-white text-charcoal" %>
              </div>
              <%= f.submit "Criar conta com senha", class: "w-full bg-charcoal hover:bg-zinc-800 text-white rounded-lg py-2 text-xs font-medium cursor-pointer shadow-xs" %>
            </div>
          <% end %>
        </div>
      </details>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</div>
