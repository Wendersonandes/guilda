<%# locals: (project:, images:, preview: false) %>
<% profile = project.profile %>
<% actor = profile&.actor %>

<article class="bg-white rounded-xl border border-stone-border overflow-hidden">
  <!-- 1. Hero / Cover Image -->
  <% if preview %>
    <div data-project-preview-target="coverContainer" class="hidden w-full max-h-[500px] overflow-hidden bg-stone-100 flex items-center justify-center border-b border-stone-border"></div>
    <div data-project-preview-target="coverPlaceholder" class="w-full aspect-[16/9] max-h-[380px] bg-stone-50 border-b border-stone-border flex flex-col items-center justify-center text-zinc-300 gap-2">
      <i data-lucide="image" class="w-10 h-10 stroke-1 text-zinc-300"></i>
      <span class="text-xs font-medium text-zinc-400">A capa do projeto aparecerá aqui</span>
    </div>
  <% else %>
    <% cover = project.cover_or_first %>
    <% if cover&.attached? %>
      <div class="w-full max-h-[520px] overflow-hidden bg-stone-100 flex items-center justify-center border-b border-stone-border">
        <%= image_tag cover.variant(:large), class: "w-full h-full max-h-[520px] object-cover" %>
      </div>
    <% end %>
  <% end %>

  <!-- 2. Integrated Content Surface: Byline, Title, Narrative & Gallery -->
  <div class="p-6 sm:p-8 space-y-6">
    <!-- Header Block: Author Byline & Project Title -->
    <div class="space-y-3">
      <!-- Author Byline -->
      <div class="flex items-center gap-3">
        <% if actor %>
          <div class="w-9 h-9 rounded-full bg-stone-100 border border-stone-border overflow-hidden flex-shrink-0 flex items-center justify-center">
            <% if actor.avatar.attached? %>
              <%= image_tag actor.avatar.variant(:thumb), class: "w-full h-full rounded-full object-cover" %>
            <% else %>
              <span class="font-serif font-bold text-xs text-charcoal"><%= actor.name.first.upcase %></span>
            <% end %>
          </div>
        <% end %>
        <div class="min-w-0">
          <p class="text-xs font-medium text-charcoal truncate">
            <% if preview || actor.nil? %>
              <span class="font-semibold text-charcoal"><%= profile&.name || "Seu Nome" %></span>
            <% else %>
              <%= link_to actor.name, public_path_for(actor), class: "font-semibold text-charcoal hover:text-brand transition-colors", data: { turbo_frame: "_top" } %>
            <% end %>
          </p>
          <% if profile && (profile.city.present? || profile.state.present?) %>
            <p class="text-[11px] text-zinc-500 flex items-center gap-1">
              <i data-lucide="map-pin" class="w-3 h-3 text-zinc-400"></i>
              <span><%= [profile.city, profile.state].reject(&:blank?).join(", ") %></span>
            </p>
          <% end %>
        </div>
      </div>

      <!-- Project Title -->
      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-serif font-bold text-charcoal tracking-tight leading-tight">
        <span data-project-preview-target="titleText" class="<%= "text-zinc-300" if project.title.blank? %>">
          <%= project.title.presence || t("projects.show.untitled") %>
        </span>
      </h1>
    </div>

    <!-- Narrative Section: Flows directly below Title without bureaucratic headers -->
    <div data-project-preview-target="aboutSection" class="pt-5 border-t border-stone-100 <%= "hidden" if project.about.to_plain_text.blank? %>">
      <div data-project-preview-target="about" class="lexxy-content text-sm sm:text-base text-zinc-700 leading-relaxed max-w-prose">
        <%= project.about if project.about.to_plain_text.present? %>
      </div>
    </div>

    <!-- Gallery Section: Unified as generous visual plates -->
    <div data-project-preview-target="gallerySection" class="pt-6 border-t border-stone-100 space-y-4 <%= "hidden" if images.blank? %>">
      <div class="flex items-center justify-between">
        <h2 class="text-xs font-semibold uppercase tracking-wider text-zinc-500 flex items-center gap-2">
          <i data-lucide="images" class="w-4 h-4 text-zinc-400"></i>
          <span><%= t("projects.show.images") %></span>
        </h2>
        <% if images.present? %>
          <span class="text-xs text-zinc-400 font-medium">
            <%= t("projects.show.gallery_count", count: images.size) %>
          </span>
        <% end %>
      </div>

      <div data-project-preview-target="gallery" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <% images.each do |image| %>
          <% if preview %>
            <%= image_tag image.image.variant(:thumb), class: "w-full aspect-[4/3] object-cover rounded-lg border border-stone-border" %>
          <% else %>
            <a href="<%= rails_blob_path(image.image, disposition: "inline") %>" target="_blank" rel="noopener" class="group relative block w-full aspect-[4/3] bg-stone-100 rounded-lg overflow-hidden border border-stone-border hover:border-stone-400 transition-colors" title="<%= t("projects.show.zoom_image") %>">
              <%= image_tag image.image.variant(:thumb), class: "w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-200" %>
              <div class="absolute inset-0 bg-charcoal/0 group-hover:bg-charcoal/20 transition-colors flex items-center justify-center opacity-0 group-hover:opacity-100">
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-charcoal/80 text-white text-xs font-medium">
                  <i data-lucide="zoom-in" class="w-3.5 h-3.5"></i>
                  <span><%= t("projects.show.zoom_image") %></span>
                </span>
              </div>
            </a>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</article>
