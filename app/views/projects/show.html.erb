<% content_for :no_sidebar, true %>
<%= content_for :title, @project.title %>

<div class="max-w-4xl mx-auto space-y-6">
  <!-- Top Context Navigation & Owner Actions -->
  <div class="flex flex-wrap items-center justify-between gap-3 pb-1">
    <div>
      <%= link_to public_path_for(@project.profile.actor), class: "inline-flex items-center gap-2 min-h-11 px-2.5 py-2 -ml-2.5 rounded-lg text-xs sm:text-sm font-medium text-zinc-600 hover:text-charcoal transition-colors group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-charcoal focus-visible:ring-offset-1" do %>
        <i data-lucide="arrow-left" aria-hidden="true" class="w-4 h-4 text-zinc-400 group-hover:text-charcoal transition-colors"></i>
        <span><%= t("projects.show.back_to_profile", name: @project.profile.name) %></span>
      <% end %>
    </div>

    <% if current_actor && current_actor == @project.profile.actor %>
      <div class="flex items-center gap-2.5">
        <% badge_classes = case @project.visibility
           when "draft"
             "bg-amber-50 text-amber-800 border border-amber-200/80"
           when "private"
             "bg-stone-100 text-zinc-700 border border-stone-200"
           else # public
             "bg-emerald-50 text-emerald-800 border border-emerald-200/80"
           end %>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= badge_classes %>">
          <%= @project.visibility_label %>
        </span>
        <%= link_to edit_my_project_path(@project), class: "inline-flex items-center gap-1.5 text-xs bg-white hover:bg-stone-50 text-charcoal font-medium min-h-9 px-3 py-1.5 rounded-lg border border-stone-300 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-charcoal focus-visible:ring-offset-1" do %>
          <i data-lucide="edit-3" aria-hidden="true" class="w-3.5 h-3.5 text-zinc-500"></i>
          <span><%= t("my.projects.index.edit", default: "Editar") %></span>
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- Unified Project Article -->
  <%= render "projects/project", project: @project, images: @images %>

  <!-- Author contact CTA -->
  <div class="bg-white rounded-xl border border-stone-border p-5 sm:p-6 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4">
    <div class="min-w-0">
      <p class="text-sm font-semibold text-charcoal"><%= t("projects.show.interested_in_work") %></p>
      <p class="text-xs text-zinc-500 mt-0.5"><%= t("projects.show.contact_author", name: @project.profile.name) %></p>
    </div>

    <%= link_to public_path_for(@project.profile.actor), class: "inline-flex items-center justify-center gap-1.5 text-xs font-semibold bg-charcoal text-white hover:bg-zinc-800 min-h-11 px-4 py-2.5 rounded-lg transition-colors flex-shrink-0 w-full sm:w-auto focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-charcoal focus-visible:ring-offset-1" do %>
      <span><%= t("projects.show.view_profile_and_contacts") %></span>
      <i data-lucide="arrow-right" aria-hidden="true" class="w-3.5 h-3.5"></i>
    <% end %>
  </div>
</div>
