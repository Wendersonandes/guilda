<div data-controller="occupations"
     data-occupations-counter-template-value="<%= t("profile_steps.occupation.counter", default: "%{count} de 3 selecionadas") %>"
     class="space-y-4">
  <%= hidden_field_tag "profile[occupation_list][]", "" %>

  <!-- Moldura em Tom Claro / Fieldset Well -->
  <div class="p-5 sm:p-6 rounded-xl bg-stone-50 border border-stone-200/90 space-y-4">
    <!-- Frame Header -->
    <div class="flex flex-wrap items-center justify-between gap-2 border-b border-stone-200/80 pb-3">
      <h2 id="occupations_section_heading" class="text-xs font-semibold uppercase tracking-wider text-charcoal flex items-center gap-1.5">
        <i data-lucide="briefcase" aria-hidden="true" class="w-4 h-4 text-brand"></i>
        <span><%= t("profile_steps.occupation.title", default: "Categorias Profissionais") %></span>
      </h2>
      <div class="flex items-center gap-2">
        <span id="occupations_counter" data-occupations-target="counter" class="text-xs font-bold text-charcoal bg-white border border-stone-200 px-2.5 py-0.5 rounded-full shadow-2xs">
          <%= t("profile_steps.occupation.counter", count: @profile.occupation_list.size, default: "#{@profile.occupation_list.size} de 3 selecionadas") %>
        </span>
        <span id="occupations_limit_hint" class="text-xs text-zinc-500 font-medium">
          <%= t("profile_steps.occupation.limit_hint", default: "Selecione entre 1 e 3 áreas") %>
        </span>
      </div>
    </div>

    <div data-occupations-target="warning" role="alert" aria-live="assertive" class="hidden rounded-lg bg-red-50 p-3 text-sm text-red-600 border border-red-100 transition-all">
      <%= t("profile_steps.occupation.limit_warning", default: "Você já selecionou o limite máximo de 3 categorias.") %>
    </div>

    <% if @profile.errors[:occupation_list].any? %>
      <div role="alert" class="rounded-lg bg-red-50 p-3 text-sm text-red-600 border border-red-100">
        <%= @profile.errors[:occupation_list].first %>
      </div>
    <% end %>

    <!-- Pills Grid -->
    <div role="group"
         aria-labelledby="occupations_section_heading"
         aria-describedby="occupations_limit_hint"
         class="flex flex-wrap gap-2 pt-1">
      <% Profile::OCCUPATIONS.each do |occupation| %>
        <% name = occupation["name"] %>
        <% description = occupation["description"] %>
        <label class="relative inline-flex items-center cursor-pointer group transition-opacity" title="<%= description %>">
          <%= f.check_box :occupation_list,
                { multiple: true,
                  class: "peer sr-only",
                  data: { occupations_target: "checkbox", action: "change->occupations#toggle" }
                },
                name, nil %>

          <div class="min-h-11 sm:min-h-0 flex items-center px-3.5 py-2 sm:py-1.5 text-sm font-medium rounded-full border border-stone-200 bg-white text-zinc-700 hover:border-charcoal hover:bg-white peer-checked:bg-charcoal peer-checked:text-white peer-checked:border-charcoal peer-checked:hover:bg-zinc-800 group-has-[:checked]:bg-charcoal group-has-[:checked]:text-white group-has-[:checked]:border-charcoal group-has-[:checked]:hover:bg-zinc-800 peer-focus-visible:ring-2 peer-focus-visible:ring-charcoal peer-focus-visible:ring-offset-1 transition-all whitespace-nowrap shadow-2xs">
            <%= name %>
          </div>
        </label>
      <% end %>
    </div>

    <!-- Micro-context footer -->
    <div class="flex items-start gap-2 pt-2 border-t border-stone-200/70 text-xs text-zinc-500 leading-relaxed">
      <i data-lucide="sparkles" class="w-3.5 h-3.5 text-brand shrink-0 mt-0.5" aria-hidden="true"></i>
      <span>Essas categorias destacam você no diretório e conectam seu dossiê a editais e contratações do seu segmento.</span>
    </div>
  </div>
</div>
