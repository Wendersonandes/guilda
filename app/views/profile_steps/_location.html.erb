<div data-controller="location"
     data-location-select-text-value="<%= t(".select") %>"
     data-location-loading-text-value="<%= t(".loading_cities") %>"
     data-location-error-text-value="<%= t(".error_cities") %>"
     class="space-y-4">
  <%= f.hidden_field :country, value: @profile.country.presence || "BR", data: { location_target: "country" } %>

  <!-- Moldura em Tom Claro / Fieldset Well -->
  <div class="p-5 sm:p-6 rounded-xl bg-stone-50 border border-stone-200/90 space-y-4">
    <!-- Frame Header -->
    <div class="flex items-center justify-between gap-2 border-b border-stone-200/80 pb-3">
      <span class="text-xs font-semibold uppercase tracking-wider text-charcoal flex items-center gap-1.5">
        <i data-lucide="map-pin" class="w-4 h-4 text-brand" aria-hidden="true"></i>
        <span>Sua Base Regional</span>
      </span>
      <span class="text-[11px] text-zinc-500 font-medium">
        Visível no perfil público
      </span>
    </div>

    <!-- Dropdowns Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="space-y-1.5">
        <%= f.label :state, t(".state"), class: "block text-xs font-semibold text-zinc-700" %>
        <%= f.select :state, @states || [], { include_blank: t(".select"), selected: state_code_for(@profile.state) }, {
          autocomplete: "address-level1",
          aria: { invalid: @profile.errors[:state].any? },
          data: { location_target: "state", action: "change->location#stateChanged" },
          class: "w-full min-h-11 rounded-lg border #{ @profile.errors[:state].any? ? 'border-red-400 focus:ring-red-400' : 'border-stone-300 focus:ring-charcoal focus:border-charcoal' } px-3 py-2.5 text-sm bg-white text-charcoal focus:outline-none focus:ring-1 transition-shadow"
        } %>
        <% if @profile.errors[:state].any? %>
          <p class="text-xs text-red-500 mt-1"><%= @profile.errors[:state].first %></p>
        <% end %>
      </div>

      <div class="space-y-1.5">
        <%= f.label :city, t(".city"), class: "block text-xs font-semibold text-zinc-700" %>
        <%= f.select :city, @cities || [], { include_blank: t(".select") }, {
          autocomplete: "address-level2",
          aria: { invalid: @profile.errors[:city].any? },
          data: { location_target: "city" },
          class: "w-full min-h-11 rounded-lg border #{ @profile.errors[:city].any? ? 'border-red-400 focus:ring-red-400' : 'border-stone-300 focus:ring-charcoal focus:border-charcoal' } px-3 py-2.5 text-sm bg-white text-charcoal focus:outline-none focus:ring-1 transition-shadow"
        } %>
        <% if @profile.errors[:city].any? %>
          <p class="text-xs text-red-500 mt-1"><%= @profile.errors[:city].first %></p>
        <% end %>
      </div>
    </div>

    <!-- Micro-context footer -->
    <div class="flex items-start gap-2 pt-2 border-t border-stone-200/70 text-xs text-zinc-500 leading-relaxed">
      <i data-lucide="info" class="w-3.5 h-3.5 text-zinc-400 shrink-0 mt-0.5" aria-hidden="true"></i>
      <span>Produtores, diretores e contratantes filtram profissionais por estado e município para projetos e editais locais.</span>
    </div>
  </div>
</div>
