<% content_for :no_sidebar, true %>
<%= content_for :title, "Completar Perfil" %>
<% active_plan = selected_plan %>

<div class="max-w-2xl mx-auto py-8 space-y-6">
  <%= turbo_frame_tag "wizard_frame", data: { turbo_action: "advance" } do %>
    <div class="space-y-6">
      <% if active_plan %>
        <!-- Multi-Step Journey Indicator (Continuity from Signup Screen) -->
        <nav aria-label="Etapas do cadastro" class="flex items-center justify-center gap-2 text-xs font-medium text-zinc-500 mb-2">
          <span class="inline-flex items-center gap-1.5 text-zinc-400">
            <span class="w-5 h-5 rounded-full bg-emerald-50 text-emerald-600 border border-emerald-200 inline-flex items-center justify-center text-[10px] font-bold">
              <i data-lucide="check" class="w-3 h-3" aria-hidden="true"></i>
            </span>
            <span>Conta</span>
          </span>
          <span class="w-6 h-px bg-stone-300" aria-hidden="true"></span>
          <span class="inline-flex items-center gap-1.5 text-brand font-semibold">
            <span class="w-5 h-5 rounded-full bg-brand text-white inline-flex items-center justify-center text-[11px] font-bold">2</span>
            <span>Perfil</span>
          </span>
          <span class="w-6 h-px bg-stone-300" aria-hidden="true"></span>
          <span class="inline-flex items-center gap-1.5 text-zinc-400">
            <span class="w-5 h-5 rounded-full bg-stone-100 text-zinc-400 border border-stone-200 inline-flex items-center justify-center text-[11px] font-bold">3</span>
            <span>Ativação (30 dias grátis)</span>
          </span>
        </nav>

        <div class="flex flex-wrap items-center justify-between gap-2 px-4 py-3 rounded-lg bg-stone-50 border border-stone-200 text-xs text-zinc-700">
          <div class="flex items-center gap-2">
            <i data-lucide="sparkles" class="w-4 h-4 text-brand shrink-0" aria-hidden="true"></i>
            <span>Plano selecionado: <strong class="text-charcoal"><%= active_plan.name %></strong> (30 dias grátis)</span>
          </div>
          <span class="text-zinc-500 font-medium">Próximo passo: ativação segura no Stripe</span>
        </div>
      <% end %>

      <div>
        <h1 class="text-2xl font-serif font-bold text-charcoal tracking-tight mb-1">Completar Perfil</h1>
        <p class="text-sm text-zinc-500">
          <% if step == :location %>
            Preencha sua localização para que contratantes e colegas encontrem você facilmente.
          <% else %>
            Defina seu campo de atuação na cultura. Selecione entre 1 e 3 categorias profissionais.
          <% end %>
        </p>
      </div>

      <!-- Stepper / Tabs -->
      <div class="border-b border-stone-200">
        <nav class="-mb-px flex space-x-8" aria-label="Progress">
          <%# Step 1: Localização %>
          <% is_location_active = (step == :location) %>
          <% is_location_allowed = @profile.allowed_step?(:location) %>
          <% location_classes = "pb-4 text-sm font-medium border-b-2 transition-all flex items-center gap-2 " %>
          <% if is_location_active %>
            <% location_classes += "border-brand text-brand" %>
          <% else %>
            <% location_classes += "border-transparent text-zinc-500 hover:text-zinc-700 hover:border-zinc-300" %>
          <% end %>

          <% if is_location_allowed && !is_location_active %>
            <button type="submit" form="wizard_form" name="target_step" value="location" class="<%= location_classes %> bg-transparent border-0 cursor-pointer text-left">
              <span class="flex items-center justify-center w-5 h-5 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-600 border border-emerald-200">
                <i data-lucide="check" class="w-3 h-3" aria-hidden="true"></i>
              </span>
              <span>Localização</span>
            </button>
          <% else %>
            <div class="<%= location_classes %> cursor-default">
              <span class="flex items-center justify-center w-5 h-5 rounded-full text-[10px] font-bold <%= is_location_active ? 'bg-brand text-white' : 'bg-zinc-100 text-zinc-400 border border-stone-200' %>">
                1
              </span>
              <span>Localização</span>
            </div>
          <% end %>

          <%# Step 2: Categoria Profissional %>
          <% is_occupation_active = (step == :occupation) %>
          <% is_occupation_allowed = @profile.allowed_step?(:occupation) %>
          <% occupation_classes = "pb-4 text-sm font-medium border-b-2 transition-all flex items-center gap-2 " %>
          <% if is_occupation_active %>
            <% occupation_classes += "border-brand text-brand" %>
          <% else %>
            <% occupation_classes += "border-transparent text-zinc-500 hover:text-zinc-700 hover:border-zinc-300" %>
          <% end %>

          <% if is_occupation_allowed && !is_occupation_active %>
            <button type="submit" form="wizard_form" name="target_step" value="occupation" class="<%= occupation_classes %> bg-transparent border-0 cursor-pointer text-left">
              <span class="flex items-center justify-center w-5 h-5 rounded-full text-[10px] font-bold bg-stone-100 text-zinc-700 border border-stone-200">
                2
              </span>
              <span>Categoria Profissional</span>
            </button>
          <% else %>
            <div class="<%= occupation_classes %> <%= is_occupation_allowed ? 'cursor-default' : 'cursor-not-allowed opacity-50' %>">
              <span class="flex items-center justify-center w-5 h-5 rounded-full text-[10px] font-bold <%= is_occupation_active ? 'bg-brand text-white' : 'bg-zinc-100 text-zinc-400 border border-stone-200' %>">
                2
              </span>
              <span>Categoria Profissional</span>
            </div>
          <% end %>
        </nav>
      </div>

      <div class="bg-white rounded-lg border border-stone-border p-6 space-y-6">
        <%= form_with(
          model: @profile,
          url: wizard_path,
          method: :put,
          id: "wizard_form",
          class: "space-y-6"
        ) do |f| %>
          
          <%= render partial: "profile_steps/#{step}", locals: { f: f } %>
          
          <div class="flex items-center justify-between border-t border-stone-100 pt-5 mt-6">
            <% if step == Profile::FORM_STEPS.keys.first %>
              <div></div>
            <% else %>
              <%= f.button type: "submit", name: "wizard_action", value: "back", class: "min-h-11 sm:min-h-0 inline-flex items-center text-sm font-medium text-zinc-500 hover:text-charcoal transition-colors focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-charcoal focus-visible:ring-offset-1 rounded-md px-1 cursor-pointer bg-transparent border-0" do %>
                <span>Voltar</span>
              <% end %>
            <% end %>
            
            <% final_label = active_plan ? "Finalizar e ir para o checkout" : "Finalizar" %>
            <%= f.submit step == Profile::FORM_STEPS.keys.last ? final_label : "Continuar",
                         data: step == Profile::FORM_STEPS.keys.last ? { turbo: false } : {},
                         class: "min-h-11 sm:min-h-0 inline-flex items-center justify-center bg-charcoal hover:bg-zinc-800 text-white px-5 py-2.5 rounded-lg text-sm font-medium transition-colors cursor-pointer ml-auto focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-charcoal focus-visible:ring-offset-1" %>
          </div>
        <% end %>

        <% if step == :occupation %>
          <!-- Contractor / Client Quick Exit (Signup CRO: Avoid trapping clients in technical categories) -->
          <div class="pt-2 text-center border-t border-stone-100">
            <%= button_to wizard_path,
                          method: :put,
                          params: { wizard_action: "skip_occupations" },
                          form: { data: { turbo_frame: "_top" } },
                          data: { turbo_frame: "_top" },
                          form_class: "inline",
                          class: "text-xs text-zinc-500 hover:text-brand transition-colors bg-transparent border-0 cursor-pointer p-0 underline" do %>
              Não presto serviços — quero apenas buscar e contratar profissionais
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
