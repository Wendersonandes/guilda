<% content_for :no_sidebar, true %>
<% content_for :title, "Guilda — Rede e Diretório de Profissionais da Cultura" %>

<div class="py-8 sm:py-16 space-y-16 sm:space-y-24">
  
  <!-- Hero Section -->
  <section class="text-center space-y-6 pt-4">
    <h1 class="font-serif text-4xl sm:text-6xl text-charcoal font-bold tracking-tight leading-tight max-w-4xl mx-auto">
      Para quem constrói a cultura nacional com as próprias mãos
    </h1>
    
    <p class="text-base sm:text-xl text-zinc-600 max-w-2xl mx-auto font-sans leading-relaxed">
      A plataforma de portfólio e conexão para trabalhadores e prestadores de serviço da cultura no Brasil. Apresente seu ofício com seriedade, seja encontrado por contratantes de todo o país e crie estratégias para se remunerar melhor.
    </p>

    <div class="flex flex-col sm:flex-row justify-center items-center gap-3 pt-4">
      <%= link_to new_user_registration_path, class: "w-full sm:w-auto min-h-11 inline-flex items-center justify-center gap-2 bg-brand hover:bg-brand-hover text-white px-6 py-3 rounded-lg font-medium transition-colors shadow-xs text-base cursor-pointer focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2" do %>
        <i data-lucide="user-plus" class="w-5 h-5" aria-hidden="true"></i>
        <span>Cadastrar meu portfólio</span>
      <% end %>
      <%= link_to profiles_path, class: "w-full sm:w-auto min-h-11 inline-flex items-center justify-center gap-2 bg-white hover:bg-stone-50 text-charcoal border border-stone-border px-6 py-3 rounded-lg font-medium transition-colors text-base cursor-pointer focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2" do %>
        <i data-lucide="search" class="w-5 h-5" aria-hidden="true"></i>
        <span>Explorar profissionais</span>
      <% end %>
    </div>

    <p class="text-xs text-zinc-500 font-sans">
      30 dias de teste gratuito para prestadores • Acesso livre e gratuito para quem contrata
    </p>
  </section>

  <!-- Stats Grid -->
  <section class="border-y border-stone-border py-8 bg-white/50 rounded-xl">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center divide-y md:divide-y-0 md:divide-x divide-stone-border">
      <div class="space-y-1 py-4 md:py-0">
        <div class="font-serif text-3xl sm:text-4xl font-bold text-charcoal">9+</div>
        <div class="text-xs uppercase tracking-widest text-zinc-500 font-semibold">Categorias Ativas</div>
      </div>
      <div class="space-y-1 py-4 md:py-0">
        <div class="font-serif text-3xl sm:text-4xl font-bold text-charcoal">
          <%= @profiles_count > 0 ? @profiles_count : "Nacional" %>
        </div>
        <div class="text-xs uppercase tracking-widest text-zinc-500 font-semibold">
          <%= @profiles_count > 0 ? "Profissionais no Diretório" : "Alcance em Todo o País" %>
        </div>
      </div>
      <div class="space-y-1 py-4 md:py-0">
        <div class="font-serif text-3xl sm:text-4xl font-bold text-charcoal">100%</div>
        <div class="text-xs uppercase tracking-widest text-zinc-500 font-semibold">Foco na Produção Cultural</div>
      </div>
    </div>
  </section>

  <!-- Two-Column Audiences -->
  <section class="grid grid-cols-1 md:grid-cols-2 gap-8 sm:gap-12">
    <!-- Trabalhadores & Prestadores de Serviço (Foco Principal) -->
    <div class="p-8 bg-white border border-stone-border rounded-xl flex flex-col justify-between space-y-6">
      <div class="space-y-4">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-charcoal">Apresente seu ofício com o rigor que ele merece</h2>
        <p class="text-sm sm:text-base text-zinc-600 leading-relaxed">
          As ferramentas de portfólio da Guilda foram desenhadas para valorizar a atuação prática de quem realiza a cultura. Organize suas entregas técnicas com padrão editorial de galeria e seja encontrado por quem tem projetos e orçamentos para executar.
        </p>
        <ul class="space-y-2.5 pt-2">
          <li class="flex items-start gap-2.5 text-sm text-zinc-700">
            <i data-lucide="check" class="w-4 h-4 text-zinc-500 mt-0.5 shrink-0" aria-hidden="true"></i>
            <span>Dossiê visual estruturado que destaca seu papel técnico e o escopo de cada entrega</span>
          </li>
          <li class="flex items-start gap-2.5 text-sm text-zinc-700">
            <i data-lucide="check" class="w-4 h-4 text-zinc-500 mt-0.5 shrink-0" aria-hidden="true"></i>
            <span>Presença no diretório nacional filtrado por cidade, estado e especialidade</span>
          </li>
          <li class="flex items-start gap-2.5 text-sm text-zinc-700">
            <i data-lucide="check" class="w-4 h-4 text-zinc-500 mt-0.5 shrink-0" aria-hidden="true"></i>
            <span>Canais diretos de contato (WhatsApp com mensagem personalizada, e-mail e telefone)</span>
          </li>
          <li class="flex items-start gap-2.5 text-sm text-zinc-700">
            <i data-lucide="check" class="w-4 h-4 text-zinc-500 mt-0.5 shrink-0" aria-hidden="true"></i>
            <span>30 dias gratuitos para montar seu portfólio e experimentar sem compromisso</span>
          </li>
        </ul>
      </div>
      <div class="pt-4">
        <%= link_to new_user_registration_path(plan: :trial), class: "min-h-11 inline-flex items-center gap-1.5 text-sm font-semibold text-brand hover:text-brand-hover transition-colors group focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2 rounded" do %>
          <span>Criar portfólio (30 dias grátis)</span>
          <i data-lucide="arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform" aria-hidden="true"></i>
        <% end %>
      </div>
    </div>

    <!-- Artistas, Produtores & Contratantes -->
    <div class="p-8 bg-white border border-stone-border rounded-xl flex flex-col justify-between space-y-6">
      <div class="space-y-4">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-charcoal">Monte equipes técnicas qualificadas em poucos cliques</h2>
        <p class="text-sm sm:text-base text-zinc-600 leading-relaxed">
          Artistas, produtores executivos, curadores, coletivos e instituições culturais encontram fornecedores especializados com histórico comprovado para viabilizar espetáculos, livros, exposições e editais públicos.
        </p>
        <ul class="space-y-2.5 pt-2">
          <li class="flex items-start gap-2.5 text-sm text-zinc-700">
            <i data-lucide="check" class="w-4 h-4 text-zinc-500 mt-0.5 shrink-0" aria-hidden="true"></i>
            <span>Acesso livre e 100% gratuito para pesquisar e contatar profissionais</span>
          </li>
          <li class="flex items-start gap-2.5 text-sm text-zinc-700">
            <i data-lucide="check" class="w-4 h-4 text-zinc-500 mt-0.5 shrink-0" aria-hidden="true"></i>
            <span>Busca especializada por localização geográfica (cidade/estado) e disponibilidade</span>
          </li>
          <li class="flex items-start gap-2.5 text-sm text-zinc-700">
            <i data-lucide="check" class="w-4 h-4 text-zinc-500 mt-0.5 shrink-0" aria-hidden="true"></i>
            <span>Histórico visual e técnico de projetos reais executados antes de fechar a contratação</span>
          </li>
          <li class="flex items-start gap-2.5 text-sm text-zinc-700">
            <i data-lucide="check" class="w-4 h-4 text-zinc-500 mt-0.5 shrink-0" aria-hidden="true"></i>
            <span>Contato sem intermediários: converse diretamente com quem vai executar o serviço</span>
          </li>
        </ul>
      </div>
      <div class="pt-4">
        <%= link_to profiles_path, class: "min-h-11 inline-flex items-center gap-1.5 text-sm font-semibold text-brand hover:text-brand-hover transition-colors group focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2 rounded" do %>
          <span>Buscar prestadores de serviço</span>
          <i data-lucide="arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform" aria-hidden="true"></i>
        <% end %>
      </div>
    </div>
  </section>

  <!-- Occupations Grid -->
  <section class="space-y-8">
    <div class="text-center space-y-3">
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-charcoal">Encontre o profissional exato para o seu projeto</h2>
      <p class="text-sm sm:text-base text-zinc-500 max-w-xl mx-auto">
        A Guilda reúne quem planeja, estrutura, monta e viabiliza a realização cultural em todo o Brasil.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <% (@occupations || []).each do |occupation| %>
        <% icon_name = occupation["icon"] || "star" %>
        <%= link_to profiles_path(occupation: occupation["name"]), class: "p-6 bg-white border border-stone-border rounded-xl hover:border-zinc-400 hover:shadow-xs transition-all duration-200 flex flex-col gap-4 group focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2" do %>
          <div class="w-10 h-10 rounded-lg bg-gallery flex items-center justify-center text-charcoal group-hover:text-brand shrink-0 transition-colors">
            <i data-lucide="<%= icon_name %>" class="w-5 h-5" aria-hidden="true"></i>
          </div>
          <div class="space-y-2">
            <h3 class="font-serif font-bold text-lg text-charcoal group-hover:text-brand transition-colors"><%= occupation["name"] %></h3>
            <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed"><%= occupation["description"] %></p>
          </div>
        <% end %>
      <% end %>
    </div>
  </section>

  <!-- Real Use Cases -->
  <section class="p-8 sm:p-12 bg-white border border-stone-border rounded-xl space-y-8">
    <div class="space-y-3">
      <h2 class="font-serif text-3xl font-bold text-charcoal">Feito para a rotina prática de quem produz cultura</h2>
      <p class="text-sm sm:text-base text-zinc-600 max-w-2xl leading-relaxed">
        Cada espetáculo, livro, filme, exposição ou festival depende de profissionais técnicos comprometidos. Conheça as situações mais comuns resolvidas na plataforma:
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-2 divide-y md:divide-y-0 md:divide-x divide-stone-border">
      <div class="space-y-2 md:pr-4 py-4 md:py-0">
        <h3 class="font-serif font-bold text-base text-charcoal">Circulação e equipes regionais</h3>
        <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed">
          Companhias, artistas ou produtoras com projetos aprovados para circular em outro estado contratam montadores, técnicos de som e luz, expógrafos e produtores locais de confiança, economizando diárias e logística.
        </p>
      </div>
      <div class="space-y-2 md:px-6 py-4 md:py-0">
        <h3 class="font-serif font-bold text-base text-charcoal">Editais e prestação de contas</h3>
        <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed">
          Artistas e coletivos contratam especialistas para elaboração de propostas em editais (Rouanet, ProAC, PNAB, LPG), organização contábil, prestação de contas rigorosa e emissão rápida de Cartas de Anuência.
        </p>
      </div>
      <div class="space-y-2 md:pl-6 py-4 md:py-0">
        <h3 class="font-serif font-bold text-base text-charcoal">Serviços técnicos e conservação</h3>
        <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed">
          Contratação de diagramação e revisão editorial, finalização audiovisual, conservação e restauração de patrimônio, transporte especializado de acervo (Fine Art) e registro fotográfico de alta fidelidade.
        </p>
      </div>
    </div>
  </section>

  <!-- Pricing Section (CRO / Transparency) -->
  <section id="pricing" class="space-y-8">
    <div class="text-center space-y-3">
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-charcoal">Investimento transparente para valorizar seu ofício</h2>
      <p class="text-sm sm:text-base text-zinc-600 max-w-xl mx-auto leading-relaxed">
        Um único trabalho fechado ou equipe montada pela plataforma já compensa com folga o valor da assinatura.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto items-stretch">
      <!-- Card 1: Teste Gratuito -->
      <div class="p-8 bg-white border border-stone-border rounded-xl flex flex-col justify-between space-y-6">
        <div class="space-y-4">
          <div class="text-xs uppercase tracking-wider text-zinc-500 font-semibold">Avaliação Sem Risco</div>
          <h3 class="font-serif text-2xl font-bold text-charcoal">Teste de 30 Dias</h3>
          <div class="space-y-1">
            <span class="font-serif text-4xl font-bold text-charcoal">R$ 0</span>
            <span class="text-xs text-zinc-500 block">por 30 dias completos</span>
          </div>
          <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed">
            Monte seu perfil e publique seus projetos para testar na prática a presença no diretório e o compartilhamento do seu dossiê.
          </p>
          <ul class="space-y-2 pt-2 text-xs sm:text-sm text-zinc-700">
            <li class="flex items-center gap-2">
              <i data-lucide="check" class="w-4 h-4 text-zinc-500 shrink-0" aria-hidden="true"></i>
              <span>Publicação de projetos no portfólio</span>
            </li>
            <li class="flex items-center gap-2">
              <i data-lucide="check" class="w-4 h-4 text-zinc-500 shrink-0" aria-hidden="true"></i>
              <span>Listagem ativa no diretório de busca</span>
            </li>
            <li class="flex items-center gap-2">
              <i data-lucide="check" class="w-4 h-4 text-zinc-500 shrink-0" aria-hidden="true"></i>
              <span>Canais de contato direto disponíveis</span>
            </li>
          </ul>
        </div>
        <div>
          <% if user_signed_in? %>
            <%= link_to account_path, class: "w-full min-h-11 inline-flex items-center justify-center text-center bg-white hover:bg-stone-50 text-charcoal border border-stone-border py-2.5 px-4 rounded-lg font-medium text-sm transition-colors cursor-pointer" do %>
              Minha conta
            <% end %>
          <% else %>
            <%= link_to new_user_registration_path(plan: :trial), class: "w-full min-h-11 inline-flex items-center justify-center text-center bg-white hover:bg-stone-50 text-charcoal border border-stone-border py-2.5 px-4 rounded-lg font-medium text-sm transition-colors cursor-pointer focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2" do %>
              Começar 30 dias grátis
            <% end %>
          <% end %>
        </div>
      </div>

      <!-- Card 2: Plano Anual (Destaque) -->
      <div class="p-8 bg-white border-2 border-brand rounded-xl flex flex-col justify-between space-y-6 relative shadow-xs">
        <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-brand text-white text-[11px] uppercase tracking-wider px-3 py-0.5 rounded-full font-semibold whitespace-nowrap">
          Melhor Custo-Benefício
        </div>
        <div class="space-y-4">
          <div class="text-xs uppercase tracking-wider text-brand font-semibold">Assinatura Anual</div>
          <h3 class="font-serif text-2xl font-bold text-charcoal">Profissional Anual</h3>
          <div class="space-y-1">
            <div class="flex items-baseline gap-1">
              <span class="font-serif text-4xl font-bold text-charcoal">R$ 300</span>
              <span class="text-xs text-zinc-500">/ano</span>
            </div>
            <span class="text-xs text-brand font-medium block">Equivalente a R$ 25/mês (economize 2 meses)</span>
          </div>
          <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed">
            Para o profissional que quer manter sua presença ativa o ano inteiro, ser encontrado a cada novo edital e posicionar seu ofício com estabilidade.
          </p>
          <ul class="space-y-2 pt-2 text-xs sm:text-sm text-zinc-700">
            <li class="flex items-center gap-2">
              <i data-lucide="check" class="w-4 h-4 text-brand shrink-0" aria-hidden="true"></i>
              <span>Portfólio público permanente</span>
            </li>
            <li class="flex items-center gap-2">
              <i data-lucide="check" class="w-4 h-4 text-brand shrink-0" aria-hidden="true"></i>
              <span>Destaque contínuo nas buscas regionais</span>
            </li>
            <li class="flex items-center gap-2">
              <i data-lucide="check" class="w-4 h-4 text-brand shrink-0" aria-hidden="true"></i>
              <span>Link profissional limpo para propostas</span>
            </li>
            <li class="flex items-center gap-2">
              <i data-lucide="check" class="w-4 h-4 text-brand shrink-0" aria-hidden="true"></i>
              <span>Inicia somente após os 30 dias grátis</span>
            </li>
          </ul>
        </div>
        <div>
          <% if user_signed_in? %>
            <%= button_to checkout_path(plan: :annual), method: :post, data: { turbo: false }, class: "w-full min-h-11 inline-flex items-center justify-center text-center bg-brand hover:bg-brand-hover text-white py-2.5 px-4 rounded-lg font-medium text-sm transition-colors shadow-xs cursor-pointer focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2" do %>
              Assinar Plano Anual (30 dias grátis)
            <% end %>
          <% else %>
            <%= link_to new_user_registration_path(plan: :annual), class: "w-full min-h-11 inline-flex items-center justify-center text-center bg-brand hover:bg-brand-hover text-white py-2.5 px-4 rounded-lg font-medium text-sm transition-colors shadow-xs cursor-pointer focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2" do %>
              Cadastrar com 30 dias grátis
            <% end %>
          <% end %>
        </div>
      </div>

      <!-- Card 3: Plano Mensal -->
      <div class="p-8 bg-white border border-stone-border rounded-xl flex flex-col justify-between space-y-6">
        <div class="space-y-4">
          <div class="text-xs uppercase tracking-wider text-zinc-500 font-semibold">Assinatura Mensal</div>
          <h3 class="font-serif text-2xl font-bold text-charcoal">Profissional Mensal</h3>
          <div class="space-y-1">
            <div class="flex items-baseline gap-1">
              <span class="font-serif text-4xl font-bold text-charcoal">R$ 30</span>
              <span class="text-xs text-zinc-500">/mês</span>
            </div>
            <span class="text-xs text-zinc-500 block">Cobrança mês a mês sem fidelidade</span>
          </div>
          <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed">
            Flexibilidade para quem prefere acompanhar o investimento mensalmente e manter as ferramentas ativas conforme a demanda de projetos.
          </p>
          <ul class="space-y-2 pt-2 text-xs sm:text-sm text-zinc-700">
            <li class="flex items-center gap-2">
              <i data-lucide="check" class="w-4 h-4 text-zinc-500 shrink-0" aria-hidden="true"></i>
              <span>Todas as ferramentas de portfólio</span>
            </li>
            <li class="flex items-center gap-2">
              <i data-lucide="check" class="w-4 h-4 text-zinc-500 shrink-0" aria-hidden="true"></i>
              <span>Presença no diretório de busca</span>
            </li>
            <li class="flex items-center gap-2">
              <i data-lucide="check" class="w-4 h-4 text-zinc-500 shrink-0" aria-hidden="true"></i>
              <span>Inicia somente após os 30 dias grátis</span>
            </li>
          </ul>
        </div>
        <div>
          <% if user_signed_in? %>
            <%= button_to checkout_path(plan: :monthly), method: :post, data: { turbo: false }, class: "w-full min-h-11 inline-flex items-center justify-center text-center bg-white hover:bg-stone-50 text-charcoal border border-stone-border py-2.5 px-4 rounded-lg font-medium text-sm transition-colors cursor-pointer focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2" do %>
              Assinar Plano Mensal
            <% end %>
          <% else %>
            <%= link_to new_user_registration_path(plan: :monthly), class: "w-full min-h-11 inline-flex items-center justify-center text-center bg-white hover:bg-stone-50 text-charcoal border border-stone-border py-2.5 px-4 rounded-lg font-medium text-sm transition-colors cursor-pointer focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2" do %>
              Escolher plano mensal
            <% end %>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Free for Clients Banner -->
    <div class="max-w-5xl mx-auto p-4 sm:p-6 bg-white/70 border border-stone-border rounded-xl flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
      <div class="space-y-1">
        <h3 class="font-serif font-bold text-base text-charcoal">Você é artista, produtor ou contratante em busca de profissionais?</h3>
        <p class="text-xs sm:text-sm text-zinc-600">
          A busca, visualização de portfólios e o contato direto com prestadores de serviço são 100% gratuitos para sempre.
        </p>
      </div>
      <%= link_to profiles_path, class: "shrink-0 min-h-11 inline-flex items-center gap-2 text-sm font-semibold text-brand hover:text-brand-hover transition-colors focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2 rounded" do %>
        <span>Explorar diretório de profissionais</span>
        <i data-lucide="arrow-right" class="w-4 h-4" aria-hidden="true"></i>
      <% end %>
    </div>
  </section>

  <!-- CTA Banner (Dark Gallery Block) -->
  <section class="bg-charcoal text-white rounded-2xl p-8 sm:p-16 text-center space-y-6 border border-zinc-800">
    <div class="space-y-6">
      <h2 class="font-serif text-3xl sm:text-4xl font-bold tracking-tight max-w-xl mx-auto leading-tight">
        Construa a cultura nacional com as próprias mãos
      </h2>
      <p class="text-zinc-400 text-sm sm:text-base max-w-lg mx-auto leading-relaxed">
        Crie seu portfólio profissional hoje com 30 dias de teste gratuito e conecte-se com contratantes de todo o Brasil.
      </p>
      <div class="flex flex-col sm:flex-row justify-center items-center gap-3 pt-4">
        <%= link_to new_user_registration_path(plan: :trial), class: "w-full sm:w-auto min-h-11 inline-flex items-center justify-center bg-brand hover:bg-brand-hover text-white px-6 py-3 rounded-lg font-medium transition-colors text-base cursor-pointer shadow-xs focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2 focus-visible:ring-offset-charcoal" do %>
          Cadastrar meu portfólio (30 dias grátis)
        <% end %>
