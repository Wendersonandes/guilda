<% content_for :no_sidebar, true %>

<div class="max-w-5xl mx-auto py-8 sm:py-16 space-y-16 sm:space-y-24">
  
  <!-- Hero Section -->
  <section class="text-center space-y-6 pt-4">
    <div class="inline-flex items-center gap-2 px-3 py-1 border border-stone-border rounded-full bg-white text-xs font-mono tracking-widest text-brand uppercase">
      [ Guilda / Artes Visuais ]
    </div>
    
    <h1 class="font-serif text-4xl sm:text-6xl text-charcoal font-bold tracking-tight leading-tight max-w-4xl mx-auto">
      Conectando o trabalho invisível das artes visuais
    </h1>
    
    <p class="text-base sm:text-xl text-zinc-650 max-w-2xl mx-auto font-sans leading-relaxed">
      A plataforma padrão de trabalho para artistas, expógrafos, produtores e fornecedores no Brasil. Publique seu portfólio, monte equipes e gerencie contratações sem ruído de redes sociais.
    </p>

    <div class="flex flex-col sm:flex-row justify-center items-center gap-3 pt-4">
      <%= link_to new_user_registration_path, class: "w-full sm:w-auto flex items-center justify-center gap-2 bg-brand hover:bg-brand-hover text-white px-6 py-3 rounded-lg font-medium transition-colors shadow-sm text-base cursor-pointer" do %>
        <i data-lucide="user-plus" class="w-5 h-5"></i>
        <span>Cadastrar Portfólio</span>
      <% end %>
      <%= link_to new_user_session_path, class: "w-full sm:w-auto flex items-center justify-center gap-2 bg-white hover:bg-stone-50 text-charcoal border border-stone-border px-6 py-3 rounded-lg font-medium transition-colors text-base cursor-pointer" do %>
        <i data-lucide="log-in" class="w-5 h-5"></i>
        <span>Entrar na Plataforma</span>
      <% end %>
    </div>
  </section>

  <!-- Stats Grid -->
  <section class="border-y border-stone-border py-8 bg-white/50 rounded-xl">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center divide-y md:divide-y-0 md:divide-x divide-stone-border">
      <div class="space-y-1 py-4 md:py-0">
        <div class="font-serif text-3xl sm:text-4xl font-bold text-charcoal">9+</div>
        <div class="text-xs uppercase tracking-widest text-zinc-500 font-mono font-semibold">Categorias de Serviços</div>
      </div>
      <div class="space-y-1 py-4 md:py-0">
        <div class="font-serif text-3xl sm:text-4xl font-bold text-charcoal">
          <%= @profiles_count > 0 ? "#{@profiles_count}+" : "120+" %>
        </div>
        <div class="text-xs uppercase tracking-widest text-zinc-500 font-mono font-semibold">Profissionais Cadastrados</div>
      </div>
      <div class="space-y-1 py-4 md:py-0">
        <div class="font-serif text-3xl sm:text-4xl font-bold text-charcoal">100%</div>
        <div class="text-xs uppercase tracking-widest text-zinc-500 font-mono font-semibold">Foco em Artes Visuais</div>
      </div>
    </div>
  </section>

  <!-- Two-Column Audiences -->
  <section class="grid grid-cols-1 md:grid-cols-2 gap-8 sm:gap-12">
    <!-- Artistas & Contratantes -->
    <div class="p-8 bg-white border border-stone-border rounded-xl flex flex-col justify-between space-y-6">
      <div class="space-y-4">
        <div class="text-xs font-mono text-brand font-semibold uppercase tracking-wider">[ 01. Artistas e Contratantes ]</div>
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-charcoal">Monte equipes locais em poucos cliques</h2>
        <p class="text-sm sm:text-base text-zinc-650 leading-relaxed">
          Encontre fornecedores de confiança de forma cirúrgica. Se você aprovou um edital em outro estado ou precisa de suporte técnico para sua próxima exposição, a Guilda conecta você aos profissionais certos.
        </p>
        <ul class="space-y-2.5 pt-2">
          <li class="flex items-start gap-2.5 text-sm text-zinc-750">
            <i data-lucide="check" class="w-4 h-4 text-brand mt-0.5 shrink-0"></i>
            <span>Busca especializada por localização (cidade e estado)</span>
          </li>
          <li class="flex items-start gap-2.5 text-sm text-zinc-750">
            <i data-lucide="check" class="w-4 h-4 text-brand mt-0.5 shrink-0"></i>
            <span>Encontre expógrafos, montadores, transportadores e contadores</span>
          </li>
          <li class="flex items-start gap-2.5 text-sm text-zinc-750">
            <i data-lucide="check" class="w-4 h-4 text-brand mt-0.5 shrink-0"></i>
            <span>Sistema integrado de recomendações e feedbacks da comunidade</span>
          </li>
        </ul>
      </div>
      <div class="pt-4">
        <%= link_to new_user_registration_path, class: "inline-flex items-center gap-1.5 text-sm font-semibold text-brand hover:text-brand-hover transition-colors group" do %>
          <span>Buscar profissionais</span>
          <i data-lucide="arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform"></i>
        <% end %>
      </div>
    </div>

    <!-- Fornecedores & Profissionais -->
    <div class="p-8 bg-white border border-stone-border rounded-xl flex flex-col justify-between space-y-6">
      <div class="space-y-4">
        <div class="text-xs font-mono text-brand font-semibold uppercase tracking-wider">[ 02. Profissionais e Fornecedores ]</div>
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-charcoal">Destaque seu portfólio profissional</h2>
        <p class="text-sm sm:text-base text-zinc-650 leading-relaxed">
          Chega de redes sociais poluídas. Tenha um portfólio limpo e focado, projetado especificamente para as necessidades técnicas do mercado de artes. Receba recomendações e expanda sua clientela.
        </p>
        <ul class="space-y-2.5 pt-2">
          <li class="flex items-start gap-2.5 text-sm text-zinc-750">
            <i data-lucide="check" class="w-4 h-4 text-brand mt-0.5 shrink-0"></i>
            <span>Portfólio minimalista e elegante com foco nas imagens do seu trabalho</span>
          </li>
          <li class="flex items-start gap-2.5 text-sm text-zinc-750">
            <i data-lucide="check" class="w-4 h-4 text-brand mt-0.5 shrink-0"></i>
            <span>Seja encontrado por museus, galerias e artistas produtores</span>
          </li>
          <li class="flex items-start gap-2.5 text-sm text-zinc-750">
            <i data-lucide="check" class="w-4 h-4 text-brand mt-0.5 shrink-0"></i>
            <span>Plano de assinatura simples apenas para fornecedores cadastrados</span>
          </li>
        </ul>
      </div>
      <div class="pt-4">
        <%= link_to new_user_registration_path, class: "inline-flex items-center gap-1.5 text-sm font-semibold text-brand hover:text-brand-hover transition-colors group" do %>
          <span>Cadastrar-se como fornecedor</span>
          <i data-lucide="arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform"></i>
        <% end %>
      </div>
    </div>
  </section>

  <!-- Occupations Grid -->
  <section class="space-y-8">
    <div class="text-center space-y-3">
      <div class="text-xs font-mono text-brand font-semibold uppercase tracking-widest">[ Especialidades Culturais ]</div>
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-charcoal">Encontre o profissional exato</h2>
      <p class="text-sm sm:text-base text-zinc-500 max-w-xl mx-auto">
        A Guilda atende a todas as demandas cruciais da cadeia de produção cultural e expositiva de artes visuais.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <% 
        icon_mapping = {
          "Escrita de Projetos" => "pen-tool",
          "Expografia" => "layers",
          "Prestação de Contas" => "file-spreadsheet",
          "Montador de Exposições" => "hammer",
          "Transporte de Obras" => "truck",
          "Design de Portfólio" => "image",
          "Produção de Exposições" => "component",
          "Produtora Cultural" => "briefcase",
          "Assessoria de Comunicação" => "megaphone"
        }
      %>
      <% (@occupations || []).each do |occupation| %>
        <% icon_name = icon_mapping[occupation["name"]] || "star" %>
        <div class="p-6 bg-white border border-stone-border rounded-xl hover:shadow-md transition-shadow duration-250 flex flex-col gap-4">
          <div class="w-10 h-10 rounded-lg bg-gallery flex items-center justify-center text-brand shrink-0">
            <i data-lucide="<%= icon_name %>" class="w-5 h-5"></i>
          </div>
          <div class="space-y-2">
            <h3 class="font-serif font-bold text-lg text-charcoal"><%= occupation["name"] %></h3>
            <p class="text-xs sm:text-sm text-zinc-650 leading-relaxed"><%= occupation["description"] %></p>
          </div>
        </div>
      <% end %>
    </div>
  </section>

  <!-- Real Use Cases (Invisible Craft Concept) -->
  <section class="p-8 sm:p-12 bg-white border border-stone-border rounded-xl space-y-8">
    <div class="space-y-3">
      <div class="text-xs font-mono text-brand font-semibold uppercase tracking-widest">[ O Trabalho Invisível ]</div>
      <h2 class="font-serif text-3xl font-bold text-charcoal">Cenários do dia a dia no setor de artes</h2>
      <p class="text-sm sm:text-base text-zinc-650 max-w-2xl leading-relaxed">
        Cada exposição de sucesso depende de dezenas de profissionais cujos esforços permanecem invisíveis para o público geral. A Guilda existe para dar visibilidade e profissionalizar essa infraestrutura.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-2 divide-y md:divide-y-0 md:divide-x divide-stone-border">
      <div class="space-y-2 md:pr-4 py-4 md:py-0">
        <h4 class="font-serif font-bold text-base text-charcoal">Montagem de equipe regional</h4>
        <p class="text-xs sm:text-sm text-zinc-650 leading-relaxed">
          Artista aprovado em edital em outro estado precisa montar equipe local (expógrafo, montador, transporte) do zero, sem conhecer profissionais locais. Encontre e conecte-se com a comunidade local instantaneamente.
        </p>
      </div>
      <div class="space-y-2 md:px-6 py-4 md:py-0">
        <h4 class="font-serif font-bold text-base text-charcoal">Escrita de projetos & burocracia</h4>
        <p class="text-xs sm:text-sm text-zinc-650 leading-relaxed">
          Artistas com ideias brilhantes mas sem tempo ou expertise para redigir propostas para Editais Públicos ou gerenciar prestações de contas complexas. Conecte-se com produtores e contadores especializados.
        </p>
      </div>
      <div class="space-y-2 md:pl-6 py-4 md:py-0">
        <h4 class="font-serif font-bold text-base text-charcoal">Logística e Documentação</h4>
        <p class="text-xs sm:text-sm text-zinc-650 leading-relaxed">
          Necessidade de Carta de Anuência de outros profissionais para cumprir requisitos de editais, ou transporte Fine Art com embalagem e manuseio seguro de acervos. Facilidade em contatar prestadores experientes.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA Banner (Premium dark block for fine art feel) -->
  <section class="bg-charcoal text-white rounded-2xl p-8 sm:p-16 text-center space-y-6 border border-zinc-800 shadow-xl relative overflow-hidden">
    <div class="absolute inset-0 opacity-5 pointer-events-none" style="background-image: radial-gradient(circle at 50% 50%, white 1px, transparent 1px); background-size: 24px 24px;"></div>
    
    <div class="relative z-10 space-y-6">
      <h2 class="font-serif text-3xl sm:text-4xl font-bold tracking-tight max-w-xl mx-auto leading-tight">
        Faça parte da infraestrutura das Artes Visuais no Brasil
      </h2>
      <p class="text-zinc-400 text-sm sm:text-base max-w-lg mx-auto">
        Junte-se a centenas de artistas, curadores, produtores e fornecedores técnicos que já utilizam a Guilda para viabilizar projetos culturais.
      </p>
      <div class="flex flex-col sm:flex-row justify-center items-center gap-3 pt-4">
        <%= link_to new_user_registration_path, class: "w-full sm:w-auto bg-brand hover:bg-brand-hover text-white px-6 py-3 rounded-lg font-medium transition-colors text-base cursor-pointer" do %>
          Criar minha conta
        <% end %>
        <%= link_to new_user_session_path, class: "w-full sm:w-auto bg-zinc-800 hover:bg-zinc-700 text-white border border-zinc-700 hover:border-zinc-600 px-6 py-3 rounded-lg font-medium transition-colors text-base cursor-pointer" do %>
          Acessar plataforma
        <% end %>
      </div>
    </div>
  </section>

</div>
