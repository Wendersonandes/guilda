<%= content_for :title, t(".title") %>

<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-serif font-bold text-charcoal tracking-tight"><%= t(".title") %></h1>
  <%= link_to new_my_project_path, class: "inline-flex items-center gap-1.5 text-xs bg-charcoal hover:bg-zinc-800 text-white font-medium px-3.5 py-2 rounded-lg transition-colors shadow-sm cursor-pointer" do %>
    <i data-lucide="plus" class="w-4 h-4"></i>
    <span><%= t(".new") %></span>
  <% end %>
</div>

<% if @projects.any? %>
  <div data-controller="sortable" data-sortable-url-value="<%= reorder_my_projects_path %>" class="space-y-3">
    <% @projects.each do |project| %>
      <div data-id="<%= project.id %>" class="flex items-center gap-3 bg-white rounded-lg border border-stone-border p-3">
        <i data-lucide="grip-vertical" class="w-4 h-4 text-zinc-300 cursor-grab flex-shrink-0"></i>

        <div class="w-12 h-12 rounded-md overflow-hidden bg-stone-100 border border-stone-border flex-shrink-0">
          <% cover = project.cover_or_first %>
          <% if cover&.attached? %>
            <%= image_tag cover.variant(:thumb), class: "w-full h-full object-cover" %>
          <% end %>
        </div>

        <div class="flex-1 min-w-0">
          <p class="text-sm font-semibold text-charcoal truncate"><%= project.title %></p>
          <span class="inline-block mt-1 text-[10px] font-medium px-1.5 py-0.5 rounded bg-stone-100 text-zinc-600 border border-stone-200"><%= project.visibility_label %></span>
        </div>

        <div class="flex items-center gap-3 flex-shrink-0">
          <%= link_to project_path(project), target: "_blank", rel: "noopener", class: "text-zinc-400 hover:text-brand transition-colors", title: project.title do %>
            <i data-lucide="external-link" class="w-4 h-4"></i>
          <% end %>
          <%= link_to t(".edit"), edit_my_project_path(project), class: "text-xs font-semibold text-zinc-600 hover:text-charcoal transition-colors" %>
          <%= button_to my_project_path(project), method: :delete, data: { turbo_confirm: t(".delete_confirm") }, class: "text-zinc-400 hover:text-red-600 bg-transparent border-0 cursor-pointer p-0 transition-colors" do %>
            <i data-lucide="trash-2" class="w-4 h-4"></i>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="text-center text-zinc-500 py-16 bg-white rounded-lg border border-stone-border p-8 shadow-sm">
    <div class="w-12 h-12 bg-stone-50 rounded-full flex items-center justify-center mx-auto mb-3 border border-stone-100">
      <i data-lucide="folder-open" class="w-6 h-6 text-zinc-400"></i>
    </div>
    <p class="text-sm"><%= t(".empty") %></p>
  </div>
<% end %>
