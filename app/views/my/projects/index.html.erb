<% content_for :no_sidebar, true %>
<%= content_for :title, t(".title") %>

<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
  <!-- Main Column: Projects List -->
  <div class="lg:col-span-8 space-y-6 min-w-0">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-2 border-b border-stone-border">
      <div class="space-y-1">
        <div class="flex items-center gap-3">
          <h1 class="text-2xl sm:text-3xl font-serif font-bold text-charcoal tracking-tight"><%= t(".title") %></h1>
          <% if @projects.any? %>
            <span class="inline-flex items-center text-xs font-medium px-2.5 py-0.5 rounded-full bg-stone-100 text-zinc-700 border border-stone-border">
              <%= t(".count", count: @projects.size) %>
            </span>
          <% end %>
        </div>
        <p class="text-sm text-zinc-500 leading-relaxed"><%= t(".subtitle") %></p>
      </div>

      <%= link_to new_my_project_path, class: "inline-flex items-center justify-center gap-2 text-sm bg-charcoal hover:bg-zinc-800 text-white font-medium px-4 py-2.5 rounded-lg transition-colors cursor-pointer self-start sm:self-auto min-h-[44px] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-charcoal focus-visible:ring-offset-2 shrink-0" do %>
        <i data-lucide="plus" aria-hidden="true" class="w-4 h-4"></i>
        <span><%= t(".new") %></span>
      <% end %>
    </div>

    <% if @projects.any? %>
      <div class="space-y-2">
        <ul role="list"
            data-controller="sortable"
            data-sortable-url-value="<%= reorder_my_projects_path %>"
            data-sortable-handle-value="[data-sortable-handle]"
            class="space-y-3">
          <div class="sr-only" aria-live="polite" data-sortable-target="status"></div>

          <% @projects.each do |project| %>
            <li data-id="<%= project.id %>" class="group flex items-center gap-3.5 bg-white rounded-lg border border-stone-border p-3.5 sm:p-4 hover:border-stone-400/80 transition-colors">
              <button type="button"
                      data-sortable-handle
                      data-action="keydown->sortable#handleKeydown"
                      aria-label="<%= t('.reorder_handle', title: project.title) %>"
                      title="<%= t('.reorder_hint') %>"
                      class="w-9 h-9 -ml-1 inline-flex items-center justify-center rounded-md text-zinc-400 hover:text-charcoal hover:bg-stone-100 cursor-grab active:cursor-grabbing focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-charcoal touch-none flex-shrink-0 transition-colors">
                <i data-lucide="grip-vertical" aria-hidden="true" class="w-4 h-4"></i>
              </button>

              <div class="w-14 h-14 rounded-md overflow-hidden bg-stone-100 border border-stone-border flex-shrink-0 flex items-center justify-center">
                <% cover = project.cover_or_first %>
                <% if cover&.attached? %>
                  <%= image_tag cover.variant(:thumb), alt: "", loading: "lazy", decoding: "async", class: "w-full h-full object-cover select-none pointer-events-none" %>
                <% else %>
                  <i data-lucide="image" aria-hidden="true" class="w-5 h-5 text-zinc-400"></i>
                <% end %>
              </div>

              <div class="flex-1 min-w-0">
                <h2 class="text-sm font-semibold text-charcoal truncate">
                  <%= link_to project.title, edit_my_project_path(project), class: "hover:text-brand focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-charcoal focus-visible:ring-offset-1 rounded transition-colors" %>
                </h2>
                <div class="mt-1.5 flex items-center gap-2.5 flex-wrap">
                  <% if project.visibility_public? %>
                    <span class="inline-flex items-center gap-1.5 text-xs font-medium px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-600" aria-hidden="true"></span>
                      <%= project.visibility_label %>
                    </span>
                  <% else %>
                    <span class="inline-flex items-center gap-1.5 text-xs font-medium px-2 py-0.5 rounded-full bg-stone-100 text-zinc-600 border border-stone-200">
                      <span class="w-1.5 h-1.5 rounded-full bg-zinc-400" aria-hidden="true"></span>
                      <%= project.visibility_label %>
                    </span>
                  <% end %>
                  <span class="text-xs text-zinc-500">
                    <%= t("projects.project.gallery_count", count: project.project_images.size) %>
                  </span>
                </div>
              </div>

              <div class="flex items-center gap-1 sm:gap-1.5 flex-shrink-0">
                <%= link_to project_path(project),
                            target: "_blank",
                            rel: "noopener",
                            class: "inline-flex items-center justify-center w-9 h-9 rounded-md text-zinc-500 hover:text-charcoal hover:bg-stone-100 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-charcoal",
                            aria: { label: "#{t('.view_public')}: #{project.title}" },
                            title: t(".view_public") do %>
                  <i data-lucide="external-link" aria-hidden="true" class="w-4 h-4"></i>
                <% end %>

                <%= link_to edit_my_project_path(project),
                            class: "inline-flex items-center justify-center px-3 h-9 rounded-md text-xs font-semibold text-zinc-700 hover:text-charcoal hover:bg-stone-100 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-charcoal" do %>
                  <span><%= t(".edit") %></span>
                <% end %>

                <%= button_to my_project_path(project),
                              method: :delete,
                              data: { turbo_confirm: t(".delete_confirm", title: project.title) },
                              class: "inline-flex items-center justify-center w-9 h-9 rounded-md text-zinc-500 hover:text-red-600 hover:bg-red-50 transition-colors cursor-pointer bg-transparent border-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-600",
                              aria: { label: "#{t('.delete')} #{project.title}" },
                              title: t(".delete") do %>
                  <i data-lucide="trash-2" aria-hidden="true" class="w-4 h-4"></i>
                <% end %>
              </div>
            </li>
          <% end %>
        </ul>
      </div>
    <% else %>
      <div class="text-center text-zinc-500 px-6 py-16 bg-white rounded-lg border border-stone-border">
        <div class="w-12 h-12 bg-stone-50 rounded-full flex items-center justify-center mx-auto mb-3 border border-stone-200">
          <i data-lucide="folder-open" aria-hidden="true" class="w-6 h-6 text-zinc-400"></i>
        </div>
        <h2 class="text-base font-semibold text-charcoal mb-1"><%= t(".empty_title") %></h2>
        <p class="text-sm text-zinc-500 max-w-sm mx-auto mb-5"><%= t(".empty") %></p>
        <%= link_to new_my_project_path, class: "inline-flex items-center gap-2 text-sm bg-charcoal hover:bg-zinc-800 text-white font-medium px-4 py-2.5 rounded-lg transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-charcoal focus-visible:ring-offset-2 min-h-[44px]" do %>
          <i data-lucide="plus" aria-hidden="true" class="w-4 h-4"></i>
          <span><%= t(".empty_cta") %></span>
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- Right Sidebar Column (Desktop) -->
  <aside class="hidden lg:block lg:col-span-4 min-w-0">
    <%= render "shared/right_sidebar" %>
  </aside>
</div>
