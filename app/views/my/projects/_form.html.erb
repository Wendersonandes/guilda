<%# locals: (project:) %>
<%
  gallery_slots = Project::MAX_IMAGES - project.project_images.size
%>
<%= form_with model: [ :my, project ], class: "bg-white rounded-lg border border-stone-border p-6 space-y-5" do |f| %>
  <% if project.errors.any? %>
    <div data-controller="flash"
         data-flash-timeout-value="5000"
         data-action="mouseenter->flash#pause mouseleave->flash#resume"
         class="flex items-start justify-between gap-3 bg-red-50 border border-red-200 text-red-700 p-4 rounded-lg text-sm shadow-sm transition-all duration-300 ease-out"
         role="alert">
      <div class="space-y-1 min-w-0">
        <div class="font-semibold flex items-center gap-1.5">
          <i data-lucide="alert-circle" class="w-4 h-4 text-red-600 flex-shrink-0"></i>
          <span><%= t("errors.messages.not_saved", count: project.errors.count, resource: project.class.model_name.human.downcase, default: "Verifique os erros abaixo:") %></span>
        </div>
        <% project.errors.full_messages.each do |msg| %>
          <div class="pl-5 text-xs"><%= msg %></div>
        <% end %>
      </div>
      <button type="button"
              data-action="flash#dismiss"
              class="p-1 -mr-1 rounded-md text-red-500 hover:text-red-700 hover:bg-red-100 transition-colors cursor-pointer flex-shrink-0"
              aria-label="<%= t('common.close', default: 'Fechar') %>">
        <i data-lucide="x" class="w-3.5 h-3.5"></i>
      </button>
    </div>
  <% end %>

  <div class="space-y-1">
    <%= f.label :title, t(".title"), class: "block text-sm font-medium text-charcoal" %>
    <%= f.text_field :title, class: "w-full rounded-lg border border-stone-300 px-3 py-2 text-sm bg-white text-charcoal placeholder-zinc-400 focus:outline-none focus:ring-1 focus:ring-charcoal focus:border-charcoal" %>
  </div>

  <div class="space-y-1">
    <%= f.label :visibility, t(".visibility"), class: "block text-sm font-medium text-charcoal" %>
    <%= f.select :visibility,
          Project.visibilities.keys.map { |key| [ t("projects.visibilities.#{key}"), key ] },
          {}, class: "w-full rounded-lg border border-stone-300 px-3 py-2 text-sm bg-white text-charcoal focus:outline-none focus:ring-1 focus:ring-charcoal focus:border-charcoal" %>
  </div>

  <div class="space-y-1">
    <%= f.label :about, t(".about"), class: "block text-sm font-medium text-charcoal" %>
    <%= f.rich_text_area :about, preset: "project", class: "lexxy-content block w-full rounded-lg border border-stone-300 bg-white px-3 py-2 text-sm text-charcoal" %>
  </div>

  <%= render "shared/image_upload_field",
        form: f, attribute: :cover, attachment: project.cover,
        label: t(".cover"), preview_classes: "w-16 h-12 rounded" %>

  <div class="space-y-2">
    <div class="flex items-center justify-between">
      <label class="block text-sm font-semibold text-charcoal"><%= t(".gallery") %></label>
      <span class="text-xs text-zinc-500"><%= t(".gallery_slots_hint", count: gallery_slots, default: t(".gallery_upload_hint", count: gallery_slots)) %></span>
    </div>

    <% if gallery_slots.positive? %>
      <label for="project_gallery"
             data-controller="dropzone"
             data-action="dragover->dropzone#dragOver dragleave->dropzone#dragLeave drop->dropzone#drop"
             class="relative flex flex-col items-center justify-center p-6 sm:p-8 rounded-lg border-2 border-dashed border-stone-200 hover:border-charcoal bg-stone-50/50 hover:bg-stone-50 cursor-pointer transition-all group text-center">
        <div class="w-10 h-10 rounded-full bg-white border border-stone-200 flex items-center justify-center text-zinc-500 group-hover:text-charcoal group-hover:border-stone-400 transition-colors mb-3 shadow-xs">
          <i data-lucide="upload-cloud" class="w-5 h-5"></i>
        </div>
        <p class="text-sm font-medium text-charcoal group-hover:text-brand transition-colors"><%= t(".dropzone_title") %></p>
        <p class="text-xs text-zinc-400 mt-1"><%= t(".dropzone_subtitle") %></p>
        <span class="inline-flex items-center gap-1.5 mt-3 px-3 py-1.5 rounded-md text-xs font-medium bg-white text-charcoal border border-stone-200 shadow-xs group-hover:border-stone-300">
          <i data-lucide="plus" class="w-3.5 h-3.5"></i>
          <%= t(".dropzone_button") %>
        </span>

        <p data-dropzone-target="status" class="hidden mt-3 text-xs font-medium text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-full border border-emerald-200/60"></p>

        <%= file_field_tag "project[gallery_signed_ids][]", id: "project_gallery", multiple: true, direct_upload: true,
              accept: "image/png,image/jpeg,image/webp",
              data: { dropzone_target: "input", action: "change->dropzone#fileChanged" },
              class: "sr-only" %>
      </label>
    <% else %>
      <div class="p-4 rounded-lg bg-stone-50 border border-stone-200 text-center text-xs text-zinc-500">
        <%= t(".gallery_full") %>
      </div>
    <% end %>
  </div>

  <div class="flex items-center justify-between border-t border-stone-100 pt-5">
    <%= link_to t(".cancel"), my_projects_path, class: "text-sm font-medium text-zinc-500 hover:text-charcoal transition-colors" %>
    <%= f.submit t(".save"), class: "bg-charcoal hover:bg-zinc-800 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors cursor-pointer" %>
  </div>
<% end %>

<% if project.persisted? && project.project_images.any? %>
  <% images = project.project_images %>
  <div class="bg-white rounded-lg border border-stone-border p-6 space-y-4 mt-6">
    <div class="flex items-center justify-between">
      <h3 class="text-sm font-semibold text-charcoal"><%= t(".gallery") %></h3>
      <span class="text-xs text-zinc-500"><%= t(".gallery_hint") %></span>
    </div>

    <div data-controller="sortable" data-sortable-url-value="<%= reorder_my_project_images_path(project) %>" class="grid grid-cols-3 gap-3">
      <% images.each do |image| %>
        <div data-id="<%= image.id %>" class="relative group rounded-lg overflow-hidden border border-stone-border">
          <%= image_tag image.image.variant(:thumb), class: "w-full h-24 object-cover" %>
          <div class="absolute inset-x-0 bottom-0 flex items-center justify-between bg-black/50 px-2 py-1 opacity-0 group-hover:opacity-100 transition-opacity">
            <%= button_to cover_my_project_image_path(project, image), method: :post, title: t(".set_cover"), class: "text-white/90 hover:text-white bg-transparent border-0 p-0 cursor-pointer" do %>
              <i data-lucide="star" class="w-3.5 h-3.5"></i>
            <% end %>
            <%= button_to my_project_image_path(project, image), method: :delete, data: { turbo_confirm: t(".remove_confirm") }, class: "text-white/90 hover:text-white bg-transparent border-0 p-0 cursor-pointer" do %>
              <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
