<%# locals: (project:) %>
<%#
  Single-page new-project form. Every field is visible at once; the live preview beside it
  stays in sync through the project-preview targets.
%>
<%
  scope = "my.projects.wizard"
  gallery_slots = Project::MAX_IMAGES - project.project_images.size
  can_publish = current_actor&.can?(:publish, :project)
  public_checked = can_publish && (project.new_record? && !project.errors.any? ? true : project.visibility_public?)
  submit_disabled = project.new_record? || project.title.blank? || project.project_images.empty?
  publish_button_text = project.persisted? ? t("my.projects.edit.save_changes", default: "Salvar alterações") : t("#{scope}.publish")
  draft_button_text = t("#{scope}.save_draft")
%>
<%= form_with model: [ :my, project ], class: "space-y-3 lg:space-y-0 lg:flex lg:flex-col lg:h-full lg:min-h-0" do |f| %>
  <% if project.errors.any? %>
    <div class="lg:mb-3 lg:flex-none">
      <div data-controller="flash"
           data-flash-timeout-value="5000"
           data-action="mouseenter->flash#pause mouseleave->flash#resume"
           class="flex items-start justify-between gap-3 bg-red-50 border border-red-200 text-red-700 p-3.5 rounded-lg text-sm transition-all duration-300 ease-out"
           role="alert">
        <div class="space-y-1 min-w-0">
          <div class="font-semibold flex items-center gap-1.5 text-xs">
            <i data-lucide="alert-circle" class="w-4 h-4 text-red-600 flex-shrink-0"></i>
            <span><%= t("errors.messages.not_saved", count: project.errors.count, resource: project.class.model_name.human.downcase, default: "Verifique os erros abaixo:") %></span>
          </div>
          <% project.errors.full_messages.each do |msg| %>
            <div class="pl-5 text-xs"><%= msg %></div>
          <% end %>
        </div>
        <button type="button"
                data-action="flash#dismiss"
                class="p-1 -mr-1 rounded-md text-red-500 hover:text-red-700 hover:bg-red-100 transition-colors cursor-pointer flex-shrink-0"
                aria-label="<%= t('common.close', default: 'Fechar') %>">
          <i data-lucide="x" class="w-3.5 h-3.5"></i>
        </button>
      </div>
    </div>
  <% end %>

  <div class="bg-white rounded-lg border border-stone-border flex flex-col lg:flex-1 lg:min-h-0" data-single-project-form>
    <!-- Scrollable content inside the card -->
    <div class="lg:flex-1 lg:min-h-0 lg:overflow-y-auto divide-y divide-stone-100 rounded-t-lg">
      <!-- Information -->
      <section class="p-5 space-y-3.5" aria-labelledby="single-form-info">
        <div class="flex items-center justify-between">
          <h2 id="single-form-info" class="text-xs font-semibold uppercase tracking-wider text-charcoal"><%= t("#{scope}.step_info") %></h2>
          <span class="text-[11px] text-zinc-400">Campos obrigatórios marcados com *</span>
        </div>

        <div class="space-y-1">
          <%= f.label :title, class: "block text-xs font-medium text-charcoal" do %>
            <span><%= t("#{scope}.project_title") %></span>
            <span class="text-red-500 font-semibold" aria-hidden="true">*</span>
          <% end %>
          <%= f.text_field :title,
                required: true,
                placeholder: "Ex: Cenografia da Exposição Territórios Invisíveis",
                data: { project_preview_target: "titleInput", action: "input->project-preview#titleChanged" },
                class: "w-full rounded-lg border border-stone-300 px-3 py-2 text-sm bg-white text-charcoal placeholder-zinc-400 focus:outline-none focus:ring-1 focus:ring-charcoal focus:border-charcoal transition-colors" %>
        </div>

        <div class="space-y-1">
          <div class="flex items-center justify-between">
            <%= f.label :about, t("#{scope}.about"), class: "block text-xs font-medium text-charcoal" %>
            <span class="text-[11px] text-zinc-400 font-normal">Opcional</span>
          </div>
          <%= f.rich_text_area :about, preset: "project", class: "lexxy-content block w-full rounded-lg border border-stone-300 bg-white px-3 py-2 text-sm text-charcoal min-h-[110px]" %>
          <p class="text-[11px] text-zinc-400 leading-normal max-w-prose"><%= t("#{scope}.about_hint") %></p>
        </div>
      </section>

      <!-- Gallery & cover -->
      <section class="p-5 space-y-3.5" aria-labelledby="single-form-gallery">
        <div class="flex items-center justify-between gap-4">
          <div class="flex items-center gap-1.5">
            <h2 id="single-form-gallery" class="text-xs font-semibold uppercase tracking-wider text-charcoal"><%= t("#{scope}.gallery") %></h2>
            <span class="text-red-500 font-semibold" aria-hidden="true">*</span>
          </div>
          <span data-project-preview-target="slotCount" class="text-[11px] text-zinc-500 font-medium">
            <%= t("#{scope}.gallery_hint", count: gallery_slots) %>
          </span>
        </div>

        <div class="space-y-3">
          <% if gallery_slots.positive? %>
            <label for="project_gallery"
                   data-project-preview-target="dropzone"
                   data-controller="dropzone"
                   data-action="dragover->dropzone#dragOver dragleave->dropzone#dragLeave drop->dropzone#drop"
                   class="relative flex items-center gap-3.5 min-h-[7.5rem] px-3.5 py-6 rounded-lg border-2 border-dashed border-stone-200 hover:border-charcoal bg-stone-50/50 hover:bg-stone-50 cursor-pointer transition-all group text-left">
              <div class="w-8 h-8 rounded-full bg-white border border-stone-200 flex items-center justify-center text-zinc-400 group-hover:text-charcoal group-hover:border-stone-400 transition-colors flex-shrink-0 shadow-xs">
                <i data-lucide="upload-cloud" class="w-4 h-4"></i>
              </div>
              <div class="min-w-0 flex-1">
                <p class="text-xs font-medium text-charcoal group-hover:underline"><%= t("#{scope}.dropzone_title") %></p>
                <p class="text-[11px] text-zinc-400 mt-0.5">Obrigatório pelo menos 1 imagem · até 5 MB cada (PNG, JPEG ou WebP)</p>
              </div>

              <%= file_field_tag "project[gallery_signed_ids][]", id: "project_gallery", multiple: true, direct_upload: true,
                    accept: "image/png,image/jpeg,image/webp",
                    data: { project_preview_target: "galleryInput", dropzone_target: "input", action: "change->project-preview#galleryChanged" },
                    class: "sr-only" %>
            </label>

            <p data-project-preview-target="galleryError" class="hidden text-xs text-red-600 flex items-center gap-1.5">
              <i data-lucide="alert-circle" class="w-3.5 h-3.5 flex-shrink-0"></i>
              <span><%= t("#{scope}.gallery_required_error") %></span>
            </p>
          <% else %>
            <div class="p-3 rounded-lg bg-stone-50 border border-stone-200 text-center text-xs text-zinc-500">
              <%= t("#{scope}.gallery_full") %>
            </div>
          <% end %>

          <%= hidden_field_tag "project[cover_index]", "",
                data: { project_preview_target: "coverIndexInput", cover_label: t("#{scope}.set_cover") } %>
          <%= hidden_field_tag "project[cover_image_id]", "",
                data: { project_preview_target: "coverImageIdInput" } %>
          <%= hidden_field_tag "project[image_order]", "",
                data: { project_preview_target: "imageOrderInput" } %>

          <div class="space-y-2">
            <div data-project-preview-target="galleryInstructions"
                 class="<%= (project.persisted? && project.project_images.any?) ? 'flex' : 'hidden flex' %> items-center justify-between text-xs text-zinc-500 pt-1">
              <span class="text-xs text-zinc-500 flex items-center gap-1.5">
                <i data-lucide="star" class="w-3.5 h-3.5 text-zinc-500 flex-shrink-0"></i>
                <span><%= t("#{scope}.cover_hint") %></span>
              </span>
              <span class="text-[11px] text-zinc-400 flex items-center gap-1 flex-shrink-0">
                <i data-lucide="move" class="w-3 h-3"></i>
                <%= t("#{scope}.reorder_hint") %>
              </span>
            </div>

            <div data-project-preview-target="thumbnails"
                 data-controller="sortable"
                 <% if project.persisted? %>
                   data-sortable-url-value="<%= reorder_my_project_images_path(project) %>"
                 <% end %>
                 data-sortable-filter-value="button, a"
                 data-action="sortable:end->project-preview#galleryReordered"
                 class="grid grid-cols-3 sm:grid-cols-4 gap-2.5">
              <% if project.persisted? && project.project_images.any? %>
                <% project.project_images.each do |image| %>
                  <% is_cover = project.cover.attached? && project.cover.blob_id == image.image.blob_id %>
                  <div data-id="<%= image.id %>"
                       data-existing-id="<%= image.id %>"
                       data-is-cover="<%= is_cover ? 'true' : 'false' %>"
                       class="relative group rounded-lg overflow-hidden border <%= is_cover ? 'border-charcoal ring-2 ring-charcoal shadow-sm' : 'border-stone-border hover:border-stone-400' %> cursor-move transition-all select-none">
                    <%= image_tag image.image.variant(:thumb), class: "w-full h-24 object-cover select-none pointer-events-none" %>

                    <span data-cover-badge
                          class="absolute top-1.5 left-1.5 inline-flex items-center gap-1 bg-charcoal text-white text-[10px] font-semibold px-2 py-0.5 rounded shadow-sm select-none <%= 'hidden' unless is_cover %>"
                          style="<%= 'display: none;' unless is_cover %>">
                      <i data-lucide="star" class="w-3 h-3 fill-amber-400 text-amber-400"></i>
                      <span>Capa</span>
                    </span>

                    <button type="button"
                            data-action="project-preview#selectCover"
                            data-existing-id="<%= image.id %>"
                            data-cover-button
                            title="<%= t('my.projects.wizard.set_cover', default: 'Definir como capa') %>"
                            aria-label="Definir imagem como capa do projeto"
                            class="absolute top-1.5 left-1.5 inline-flex items-center justify-center w-7 h-7 rounded-full bg-black/60 text-white/90 hover:text-white hover:bg-charcoal transition-colors cursor-pointer shadow-sm focus:outline-none focus:ring-2 focus:ring-white <%= 'hidden' if is_cover %>"
                            style="<%= 'display: none;' if is_cover %>">
                      <i data-lucide="star" class="w-3.5 h-3.5"></i>
                    </button>

                    <% if project.project_images.size > 1 %>
                      <%= link_to my_project_image_path(project, image), data: { turbo_method: :delete, turbo_confirm: t("my.projects.form.remove_confirm", default: "Tem certeza que deseja remover esta imagem?") },
                            title: t("my.projects.form.remove_image", default: "Remover imagem"),
                            aria: { label: "Remover imagem da galeria" },
                            class: "absolute top-1.5 right-1.5 inline-flex items-center justify-center w-7 h-7 rounded-full bg-black/60 text-white/90 hover:text-white hover:bg-red-600 transition-colors cursor-pointer shadow-sm focus:outline-none focus:ring-2 focus:ring-white" do %>
                        <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                      <% end %>
                    <% else %>
                      <span class="absolute top-1.5 right-1.5 inline-flex items-center justify-center w-7 h-7 rounded-full bg-black/30 text-white/40 cursor-not-allowed shadow-sm"
                            title="O projeto precisa ter pelo menos uma imagem">
                        <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                      </span>
                    <% end %>
                  </div>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      </section>

      <% if can_publish %>
        <%= f.hidden_field :visibility, value: (public_checked ? "public" : "draft"), data: { project_preview_target: "visibilityInput" } %>
      <% else %>
        <%= f.hidden_field :visibility, value: "draft", data: { project_preview_target: "visibilityInput" } %>
        <%= hidden_field_tag :after_save, "", data: { project_preview_target: "afterSaveInput" } %>

        <!-- Publish & Professional Account Upgrade Callout -->
        <section class="p-5 space-y-3" aria-labelledby="single-form-publish">
          <div class="flex items-center justify-between gap-2">
            <h2 id="single-form-publish" class="text-xs font-semibold uppercase tracking-wider text-charcoal"><%= t("#{scope}.publish_title") %></h2>
            <span class="inline-flex items-center gap-1 text-[11px] font-medium text-zinc-600 bg-stone-100 px-2.5 py-0.5 rounded-full border border-stone-200">
              <i data-lucide="lock" class="w-3 h-3 text-zinc-500" aria-hidden="true"></i>
              <span><%= t("#{scope}.draft_label") %></span>
            </span>
          </div>

          <div class="rounded-lg border border-stone-200 bg-stone-50/70 p-4 space-y-3" data-testid="professional-upgrade-callout">
            <div class="flex items-start gap-3">
              <div class="w-8 h-8 rounded-lg bg-brand/10 border border-brand/20 flex items-center justify-center text-brand flex-shrink-0 mt-0.5">
                <i data-lucide="sparkles" class="w-4 h-4" aria-hidden="true"></i>
              </div>
              <div class="space-y-1 min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="text-xs sm:text-sm font-semibold text-charcoal">
                    <%= t("#{scope}.upgrade_callout_title") %>
                  </h3>
                  <span class="inline-flex items-center text-[10px] font-semibold uppercase tracking-wider bg-brand/10 text-brand px-2 py-0.5 rounded-full">
                    <%= t("#{scope}.upgrade_trial_badge") %>
                  </span>
                </div>
                <p class="text-xs text-zinc-600 leading-relaxed">
                  <%= t("#{scope}.upgrade_callout_body") %>
                </p>
              </div>
            </div>

            <div class="flex flex-wrap items-center justify-between gap-3 pt-2.5 border-t border-stone-200/80 sm:pl-11">
              <span class="text-[11px] text-zinc-500 flex items-center gap-1.5">
                <i data-lucide="shield-check" class="w-3.5 h-3.5 text-emerald-600 flex-shrink-0" aria-hidden="true"></i>
                <span><%= t("#{scope}.upgrade_safe_draft_hint") %></span>
              </span>
              <button type="button"
                      data-action="click->project-preview#openUpgradeModal"
                      data-testid="open-upgrade-modal-button"
                      class="inline-flex items-center gap-1.5 text-xs font-semibold text-brand hover:text-brand-hover transition-colors cursor-pointer group focus:outline-none focus:ring-2 focus:ring-brand focus:ring-offset-1 rounded">
                <span><%= t("#{scope}.upgrade_callout_cta") %></span>
                <i data-lucide="arrow-right" class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" aria-hidden="true"></i>
              </button>
            </div>
          </div>
        </section>
      <% end %>
    </div>

    <!-- Docked actions: Cancel on left, Submit on right -->
    <div class="flex-none px-5 py-3 flex items-center justify-between gap-4 bg-stone-50/70 border-t border-stone-200 rounded-b-lg">
      <%= link_to t("my.projects.new.cancel"), my_projects_path,
            class: "text-sm font-medium text-zinc-500 hover:text-charcoal transition-colors py-1.5" %>

      <% if can_publish %>
        <div class="relative inline-flex"
             data-controller="dropdown"
             data-action="click@window->dropdown#hideOnClickOutside keydown.esc@window->dropdown#hideOnEscape">
          <button type="submit"
                  <%= "disabled" if submit_disabled %>
                  data-project-preview-target="submitButton mainSubmitButton"
                  data-publish-text="<%= publish_button_text %>"
                  data-draft-text="<%= draft_button_text %>"
                  data-action="click->project-preview#clearAfterSave"
                  class="inline-flex items-center gap-2 bg-charcoal hover:bg-zinc-800 text-white px-4 py-2 rounded-l-lg text-sm font-medium transition-colors cursor-pointer shadow-sm focus:outline-none focus:ring-2 focus:ring-charcoal focus:ring-offset-1 disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:bg-charcoal">
            <i data-lucide="globe"
               data-project-preview-target="mainIconPublic"
               class="w-4 h-4 flex-shrink-0 <%= 'hidden' unless public_checked %>" aria-hidden="true"></i>
            <i data-lucide="lock"
               data-project-preview-target="mainIconDraft"
               class="w-4 h-4 flex-shrink-0 <%= 'hidden' if public_checked %>" aria-hidden="true"></i>
            <span data-project-preview-target="submitButtonText"><%= public_checked ? publish_button_text : draft_button_text %></span>
          </button>

          <button type="button"
                  data-dropdown-target="button"
                  data-project-preview-target="submitButton"
                  data-action="dropdown#toggle"
                  <%= "disabled" if submit_disabled %>
                  aria-haspopup="true"
                  aria-expanded="false"
                  aria-label="<%= t("#{scope}.more_save_options") %>"
                  title="<%= t("#{scope}.more_save_options") %>"
                  class="bg-charcoal hover:bg-zinc-800 text-white px-2.5 py-2 rounded-r-lg border-l border-zinc-700 text-sm font-medium transition-colors cursor-pointer shadow-sm focus:outline-none focus:ring-2 focus:ring-charcoal focus:ring-offset-1 disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:bg-charcoal inline-flex items-center justify-center">
            <i data-lucide="chevron-up" class="w-4 h-4" aria-hidden="true"></i>
          </button>

          <div data-dropdown-target="menu"
               role="menu"
               class="hidden absolute bottom-full right-0 mb-2 w-72 rounded-xl border border-stone-200 bg-white p-1.5 shadow-lg z-30">
            <button type="submit"
                    role="menuitem"
                    data-visibility="public"
                    data-action="click->dropdown#close click->project-preview#selectVisibilityAndSubmit"
                    data-project-preview-target="submitButton dropdownOptionPublic"
                    <%= "disabled" if submit_disabled %>
                    class="w-full text-left flex items-start gap-2.5 p-2.5 rounded-lg hover:bg-stone-50 transition-colors cursor-pointer group disabled:opacity-50 disabled:cursor-not-allowed">
              <div class="w-7 h-7 rounded-md bg-stone-100 group-hover:bg-charcoal group-hover:text-white text-charcoal flex items-center justify-center flex-shrink-0 mt-0.5 transition-colors">
                <i data-lucide="globe" class="w-3.5 h-3.5" aria-hidden="true"></i>
              </div>
              <div class="min-w-0 flex-1">
                <div class="flex items-center justify-between gap-1">
                  <p class="text-xs font-semibold text-charcoal"><%= publish_button_text %></p>
                  <i data-lucide="check" data-project-preview-target="publicCheckIcon" class="w-3.5 h-3.5 text-charcoal <%= 'hidden' unless public_checked %>" aria-hidden="true"></i>
                </div>
                <p class="text-[11px] text-zinc-500 leading-snug mt-0.5"><%= t("#{scope}.public_hint") %></p>
              </div>
            </button>

            <button type="submit"
                    role="menuitem"
                    data-visibility="draft"
                    data-action="click->dropdown#close click->project-preview#selectVisibilityAndSubmit"
                    data-project-preview-target="submitButton dropdownOptionDraft"
                    <%= "disabled" if submit_disabled %>
                    class="w-full text-left flex items-start gap-2.5 p-2.5 rounded-lg hover:bg-stone-50 transition-colors cursor-pointer group disabled:opacity-50 disabled:cursor-not-allowed">
              <div class="w-7 h-7 rounded-md bg-stone-100 group-hover:bg-charcoal group-hover:text-white text-zinc-600 flex items-center justify-center flex-shrink-0 mt-0.5 transition-colors">
                <i data-lucide="lock" class="w-3.5 h-3.5" aria-hidden="true"></i>
              </div>
              <div class="min-w-0 flex-1">
                <div class="flex items-center justify-between gap-1">
                  <p class="text-xs font-semibold text-charcoal"><%= draft_button_text %></p>
                  <i data-lucide="check" data-project-preview-target="draftCheckIcon" class="w-3.5 h-3.5 text-charcoal <%= 'hidden' if public_checked %>" aria-hidden="true"></i>
                </div>
                <p class="text-[11px] text-zinc-500 leading-snug mt-0.5"><%= t("#{scope}.draft_hint") %></p>
              </div>
            </button>
          </div>
        </div>
      <% else %>
        <div class="relative inline-flex"
             data-controller="dropdown"
             data-action="click@window->dropdown#hideOnClickOutside keydown.esc@window->dropdown#hideOnEscape">
          <%= f.submit draft_button_text,
                disabled: submit_disabled,
                data: {
                  project_preview_target: "submitButton",
                  publish_text: draft_button_text,
                  draft_text: draft_button_text,
                  action: "click->project-preview#clearAfterSave"
                },
                class: "bg-charcoal hover:bg-zinc-800 text-white px-4 py-2 rounded-l-lg text-sm font-medium transition-colors cursor-pointer shadow-sm focus:outline-none focus:ring-2 focus:ring-charcoal focus:ring-offset-1 disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:bg-charcoal" %>

          <button type="button"
                  data-dropdown-target="button"
                  data-project-preview-target="submitButton"
                  data-action="dropdown#toggle"
                  <%= "disabled" if submit_disabled %>
                  aria-haspopup="true"
                  aria-expanded="false"
                  aria-label="<%= t("#{scope}.more_save_options") %>"
                  title="<%= t("#{scope}.more_save_options") %>"
                  class="bg-charcoal hover:bg-zinc-800 text-white px-2.5 py-2 rounded-r-lg border-l border-zinc-700 text-sm font-medium transition-colors cursor-pointer shadow-sm focus:outline-none focus:ring-2 focus:ring-charcoal focus:ring-offset-1 disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:bg-charcoal inline-flex items-center justify-center">
            <i data-lucide="chevron-up" class="w-4 h-4" aria-hidden="true"></i>
          </button>

          <div data-dropdown-target="menu"
               role="menu"
               class="hidden absolute bottom-full right-0 mb-2 w-72 rounded-xl border border-stone-200 bg-white p-1.5 shadow-lg z-30">
            <button type="button"
                    role="menuitem"
                    data-action="click->dropdown#close click->project-preview#openUpgradeModal"
                    class="w-full text-left flex items-start gap-2.5 p-2.5 rounded-lg hover:bg-stone-50 transition-colors cursor-pointer group">
              <div class="w-7 h-7 rounded-md bg-brand/10 text-brand flex items-center justify-center flex-shrink-0 mt-0.5">
                <i data-lucide="sparkles" class="w-3.5 h-3.5" aria-hidden="true"></i>
              </div>
              <div class="min-w-0 flex-1">
                <p class="text-xs font-semibold text-charcoal group-hover:text-brand transition-colors"><%= t("#{scope}.save_and_upgrade_option") %></p>
                <p class="text-[11px] text-zinc-500 leading-snug mt-0.5"><%= t("#{scope}.save_and_upgrade_hint") %></p>
              </div>
            </button>

            <button type="submit"
                    role="menuitem"
                    data-action="click->dropdown#close click->project-preview#clearAfterSave"
                    class="w-full text-left flex items-start gap-2.5 p-2.5 rounded-lg hover:bg-stone-50 transition-colors cursor-pointer">
              <div class="w-7 h-7 rounded-md bg-stone-100 text-zinc-600 flex items-center justify-center flex-shrink-0 mt-0.5">
                <i data-lucide="lock" class="w-3.5 h-3.5" aria-hidden="true"></i>
              </div>
              <div class="min-w-0 flex-1">
                <p class="text-xs font-semibold text-charcoal"><%= t("#{scope}.save_only_draft_option") %></p>
                <p class="text-[11px] text-zinc-500 leading-snug mt-0.5"><%= t("#{scope}.save_only_draft_hint") %></p>
              </div>
            </button>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <% unless can_publish %>
    <!-- Plan Selection Modal (saves draft first before redirecting to Stripe Checkout) -->
    <div data-project-preview-target="upgradeModal"
         data-testid="upgrade-plans-modal"
         role="dialog"
         aria-modal="true"
         aria-labelledby="upgrade-modal-title"
         class="hidden fixed inset-0 z-[60] flex items-center justify-center p-4 bg-charcoal/60 backdrop-blur-xs">
      <div class="bg-white rounded-xl border border-stone-border shadow-md max-w-2xl w-full max-h-[90vh] overflow-y-auto p-6 sm:p-7 space-y-5">
        <!-- Modal Header -->
        <div class="flex items-start justify-between gap-4">
          <div class="space-y-1.5">
            <span class="inline-flex items-center gap-1.5 text-[11px] font-medium tracking-wide text-zinc-800 bg-stone-100 border border-stone-200 px-2.5 py-0.5 rounded-full">
              <i data-lucide="sparkles" class="w-3 h-3 text-brand" aria-hidden="true"></i>
              <span><%= t("#{scope}.upgrade_modal_badge") %></span>
            </span>
            <h2 id="upgrade-modal-title" class="font-serif text-xl sm:text-2xl font-bold text-charcoal">
              <%= t("#{scope}.upgrade_modal_title") %>
            </h2>
            <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed">
              <%= t("#{scope}.upgrade_modal_subtitle") %>
            </p>
          </div>
          <button type="button"
                  data-action="click->project-preview#closeUpgradeModal"
                  aria-label="<%= t('common.close', default: 'Fechar') %>"
                  class="w-11 h-11 -mr-2 -mt-2 rounded-lg flex items-center justify-center text-zinc-500 hover:text-charcoal hover:bg-stone-100 transition-colors cursor-pointer flex-shrink-0 focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-charcoal">
            <i data-lucide="x" class="w-5 h-5" aria-hidden="true"></i>
          </button>
        </div>

        <!-- Draft Preservation Status Banner -->
        <div data-project-preview-target="modalDraftReady"
             class="flex items-center gap-2.5 rounded-lg bg-emerald-50 border border-emerald-200/80 px-3.5 py-2.5 text-xs text-emerald-800">
          <i data-lucide="shield-check" class="w-4 h-4 text-emerald-600 flex-shrink-0" aria-hidden="true"></i>
          <span><%= t("#{scope}.upgrade_modal_draft_ready") %></span>
        </div>

        <div data-project-preview-target="modalDraftIncomplete"
             class="hidden flex items-center gap-2.5 rounded-lg bg-amber-50 border border-amber-200/80 px-3.5 py-2.5 text-xs text-amber-800">
          <i data-lucide="info" class="w-4 h-4 text-amber-600 flex-shrink-0" aria-hidden="true"></i>
          <span><%= t("#{scope}.upgrade_modal_draft_incomplete") %></span>
        </div>

        <div data-project-preview-target="modalDraftUntouched"
             class="hidden flex items-center gap-2.5 rounded-lg bg-stone-100 border border-stone-200 px-3.5 py-2.5 text-xs text-zinc-700">
          <i data-lucide="lock" class="w-4 h-4 text-zinc-500 flex-shrink-0" aria-hidden="true"></i>
          <span><%= t("#{scope}.upgrade_modal_untouched") %></span>
        </div>

        <!-- Plans Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 items-stretch pt-1">
          <!-- Annual Plan (Recommended) -->
          <div class="p-5 bg-white border border-brand rounded-xl flex flex-col justify-between space-y-5 relative shadow-xs">
            <div class="absolute -top-2.5 left-4 bg-brand text-white text-[10px] uppercase tracking-wider px-2.5 py-0.5 rounded-full font-semibold">
              Melhor Custo-Benefício
            </div>
            <div class="space-y-3">
              <div>
                <div class="text-[11px] uppercase tracking-wider text-brand font-semibold">Assinatura Anual</div>
                <h3 class="font-serif text-lg font-bold text-charcoal">Profissional Anual</h3>
              </div>
              <div class="space-y-0.5">
                <div class="flex items-baseline gap-1">
                  <span class="font-serif text-3xl font-bold text-charcoal">R$ 300</span>
                  <span class="text-xs text-zinc-500">/ano</span>
                </div>
                <span class="text-[11px] text-brand font-medium block">Equivalente a R$ 25/mês (economize 2 meses)</span>
              </div>
              <ul class="space-y-1.5 pt-1 text-xs text-zinc-700">
                <li class="flex items-center gap-2">
                  <i data-lucide="check" class="w-3.5 h-3.5 text-brand shrink-0" aria-hidden="true"></i>
                  <span>Portfólio público permanente</span>
                </li>
                <li class="flex items-center gap-2">
                  <i data-lucide="check" class="w-3.5 h-3.5 text-brand shrink-0" aria-hidden="true"></i>
                  <span>Destaque contínuo nas buscas regionais</span>
                </li>
                <li class="flex items-center gap-2">
                  <i data-lucide="check" class="w-3.5 h-3.5 text-brand shrink-0" aria-hidden="true"></i>
                  <span>Link profissional limpo para propostas</span>
                </li>
              </ul>
            </div>

            <button type="submit"
                    name="after_save"
                    value="annual"
                    data-plan="annual"
                    data-action="click->project-preview#selectPlanAndSubmit"
                    data-testid="modal-subscribe-annual"
                    class="w-full min-h-11 inline-flex items-center justify-center gap-1.5 text-center bg-brand hover:bg-brand-hover text-white py-2.5 px-4 rounded-lg font-medium text-xs sm:text-sm transition-colors shadow-xs cursor-pointer focus:outline-none focus:ring-2 focus:ring-brand focus:ring-offset-2">
              <span><%= t("#{scope}.upgrade_modal_annual_cta") %></span>
              <i data-lucide="arrow-right" class="w-3.5 h-3.5" aria-hidden="true"></i>
            </button>
          </div>

          <!-- Monthly Plan -->
          <div class="p-5 bg-white border border-stone-border rounded-xl flex flex-col justify-between space-y-5">
            <div class="space-y-3">
              <div>
                <div class="text-[11px] uppercase tracking-wider text-zinc-500 font-semibold">Assinatura Mensal</div>
                <h3 class="font-serif text-lg font-bold text-charcoal">Profissional Mensal</h3>
              </div>
              <div class="space-y-0.5">
                <div class="flex items-baseline gap-1">
                  <span class="font-serif text-3xl font-bold text-charcoal">R$ 30</span>
                  <span class="text-xs text-zinc-500">/mês</span>
                </div>
                <span class="text-[11px] text-zinc-500 block">Cobrança mês a mês sem fidelidade</span>
              </div>
              <ul class="space-y-1.5 pt-1 text-xs text-zinc-700">
                <li class="flex items-center gap-2">
                  <i data-lucide="check" class="w-3.5 h-3.5 text-zinc-500 shrink-0" aria-hidden="true"></i>
                  <span>Todas as ferramentas de portfólio</span>
                </li>
                <li class="flex items-center gap-2">
                  <i data-lucide="check" class="w-3.5 h-3.5 text-zinc-500 shrink-0" aria-hidden="true"></i>
                  <span>Presença no diretório de busca</span>
                </li>
                <li class="flex items-center gap-2">
                  <i data-lucide="check" class="w-3.5 h-3.5 text-zinc-500 shrink-0" aria-hidden="true"></i>
                  <span>Canais de contato direto disponíveis</span>
                </li>
              </ul>
            </div>

            <button type="submit"
                    name="after_save"
                    value="monthly"
                    data-plan="monthly"
                    data-action="click->project-preview#selectPlanAndSubmit"
                    data-testid="modal-subscribe-monthly"
                    class="w-full min-h-11 inline-flex items-center justify-center gap-1.5 text-center bg-charcoal hover:bg-zinc-800 text-white py-2.5 px-4 rounded-lg font-medium text-xs sm:text-sm transition-colors cursor-pointer focus:outline-none focus:ring-2 focus:ring-charcoal focus:ring-offset-2">
              <span><%= t("#{scope}.upgrade_modal_monthly_cta") %></span>
              <i data-lucide="arrow-right" class="w-3.5 h-3.5" aria-hidden="true"></i>
            </button>
          </div>
        </div>

        <!-- Modal Footer -->
        <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-3 border-t border-stone-200 text-xs text-zinc-500">
          <span><%= t("#{scope}.upgrade_modal_cancel_anytime") %></span>
          <button type="button"
                  data-action="click->project-preview#closeUpgradeModal"
                  class="min-h-10 sm:min-h-9 inline-flex items-center font-medium text-xs text-zinc-600 hover:text-charcoal transition-colors cursor-pointer py-2 px-3 rounded-lg focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-charcoal">
            <%= t("#{scope}.upgrade_modal_continue_free") %>
          </button>
        </div>
      </div>
    </div>
  <% end %>
<% end %>
