<%# locals: (project:) %>
<%
  steps = [ t(".step_info"), t(".step_gallery"), t(".step_publish") ]
  gallery_slots = Project::MAX_IMAGES - project.project_images.size
%>
<%= form_with model: [ :my, project ], class: "space-y-6" do |f| %>
  <% if project.errors.any? %>
    <div data-controller="flash"
         data-flash-timeout-value="5000"
         data-action="mouseenter->flash#pause mouseleave->flash#resume"
         class="flex items-start justify-between gap-3 bg-red-50 border border-red-200 text-red-700 p-4 rounded-lg text-sm shadow-sm transition-all duration-300 ease-out"
         role="alert">
      <div class="space-y-1 min-w-0">
        <div class="font-semibold flex items-center gap-1.5">
          <i data-lucide="alert-circle" class="w-4 h-4 text-red-600 flex-shrink-0"></i>
          <span><%= t("errors.messages.not_saved", count: project.errors.count, resource: project.class.model_name.human.downcase, default: "Verifique os erros abaixo:") %></span>
        </div>
        <% project.errors.full_messages.each do |msg| %>
          <div class="pl-5 text-xs"><%= msg %></div>
        <% end %>
      </div>
      <button type="button"
              data-action="flash#dismiss"
              class="p-1 -mr-1 rounded-md text-red-500 hover:text-red-700 hover:bg-red-100 transition-colors cursor-pointer flex-shrink-0"
              aria-label="<%= t('common.close', default: 'Fechar') %>">
        <i data-lucide="x" class="w-3.5 h-3.5"></i>
      </button>
    </div>
  <% end %>

  <!-- Stepper Tabs -->
  <div class="border-b border-stone-200 bg-white rounded-t-lg px-6 pt-3">
    <nav class="-mb-px flex gap-6 overflow-x-auto" aria-label="<%= t(".progress_label") %>">
      <% steps.each_with_index do |label, index| %>
        <button type="button"
                data-project-wizard-target="tab"
                data-action="project-wizard#goTo"
                data-index="<%= index %>"
                data-step-title="<%= label %>"
                class="pb-3 text-sm font-medium border-b-2 transition-colors flex items-center gap-2 whitespace-nowrap cursor-pointer <%= index == 0 ? 'border-charcoal text-charcoal font-semibold' : 'border-transparent text-zinc-400' %>">
          <span data-badge class="flex items-center justify-center w-5 h-5 rounded-full text-[10px] font-bold <%= index == 0 ? 'bg-charcoal text-white' : 'bg-stone-100 text-zinc-400' %> transition-colors">
            <%= index + 1 %>
          </span>
          <span><%= label %></span>
        </button>
      <% end %>
    </nav>
  </div>

  <!-- Step 1 — Information -->
  <div data-project-wizard-target="step" class="bg-white rounded-b-lg border border-t-0 border-stone-border p-6 space-y-5">
    <div class="space-y-1.5">
      <%= f.label :title, t(".project_title"), class: "block text-sm font-semibold text-charcoal" %>
      <%= f.text_field :title,
            placeholder: "Ex: Cenografia da Exposição Territórios Invisíveis",
            data: { project_preview_target: "titleInput", action: "input->project-preview#titleChanged keydown.enter->project-wizard#preventEnter" },
            class: "w-full rounded-lg border border-stone-300 px-3.5 py-2.5 text-sm bg-white text-charcoal placeholder-zinc-400 focus:outline-none focus:ring-1 focus:ring-charcoal focus:border-charcoal" %>
    </div>

    <div class="space-y-1.5">
      <%= f.label :about, t(".about"), class: "block text-sm font-semibold text-charcoal" %>
      <%= f.rich_text_area :about, preset: "project", class: "lexxy-content block w-full rounded-lg border border-stone-300 bg-white px-3.5 py-2.5 text-sm text-charcoal min-h-[160px]" %>
      <p class="text-xs text-zinc-500 leading-relaxed"><%= t(".about_hint") %></p>
    </div>
  </div>

  <!-- Step 2 — Gallery & cover -->
  <div data-project-wizard-target="step" class="hidden bg-white rounded-b-lg border border-t-0 border-stone-border p-6 space-y-5">
    <div class="space-y-3">
      <div>
        <label class="block text-sm font-semibold text-charcoal mb-0.5"><%= t(".gallery") %></label>
        <p class="text-xs text-zinc-500"><%= t(".gallery_hint", count: gallery_slots) %></p>
      </div>

      <% if gallery_slots.positive? %>
        <label for="project_gallery"
               data-controller="dropzone"
               data-action="dragover->dropzone#dragOver dragleave->dropzone#dragLeave drop->dropzone#drop"
               class="relative flex flex-col items-center justify-center p-6 sm:p-8 rounded-lg border-2 border-dashed border-stone-200 hover:border-charcoal bg-stone-50/50 hover:bg-stone-50 cursor-pointer transition-all group text-center">
          <div class="w-10 h-10 rounded-full bg-white border border-stone-200 flex items-center justify-center text-zinc-500 group-hover:text-charcoal group-hover:border-stone-400 transition-colors mb-3 shadow-xs">
            <i data-lucide="upload-cloud" class="w-5 h-5"></i>
          </div>
          <p class="text-sm font-medium text-charcoal group-hover:text-brand transition-colors"><%= t(".dropzone_title") %></p>
          <p class="text-xs text-zinc-400 mt-1"><%= t(".dropzone_subtitle") %></p>
          <span class="inline-flex items-center gap-1.5 mt-3 px-3 py-1.5 rounded-md text-xs font-medium bg-white text-charcoal border border-stone-200 shadow-xs group-hover:border-stone-300">
            <i data-lucide="plus" class="w-3.5 h-3.5"></i>
            <%= t(".dropzone_button") %>
          </span>

          <%= file_field_tag "project[gallery_signed_ids][]", id: "project_gallery", multiple: true, direct_upload: true,
                accept: "image/png,image/jpeg,image/webp",
                data: { project_preview_target: "galleryInput", dropzone_target: "input", action: "change->project-preview#galleryChanged" },
                class: "sr-only" %>
        </label>
      <% else %>
        <div class="p-4 rounded-lg bg-stone-50 border border-stone-200 text-center text-xs text-zinc-500">
          <%= t(".gallery_full") %>
        </div>
      <% end %>
    </div>

    <%= hidden_field_tag "project[cover_index]", "",
          data: { project_preview_target: "coverIndexInput", cover_label: t(".set_cover") } %>

    <div class="space-y-3 pt-1">
      <div class="flex items-center justify-between border-b border-stone-100 pb-2">
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-zinc-500"><%= t(".cover_label") %></p>
          <p class="text-xs text-zinc-400"><%= t(".cover_hint") %></p>
        </div>
        <span class="text-[11px] text-zinc-400 flex items-center gap-1">
          <i data-lucide="move" class="w-3.5 h-3.5"></i>
          <%= t(".reorder_hint") %>
        </span>
      </div>

      <p data-project-preview-target="galleryEmpty" class="text-xs text-zinc-400 italic py-4 text-center bg-stone-50/50 rounded-lg border border-dashed border-stone-200"><%= t(".no_images") %></p>
      <div data-project-preview-target="thumbnails"
           data-controller="sortable"
           data-sortable-filter-value="button"
           data-action="sortable:end->project-preview#galleryReordered"
           class="grid grid-cols-2 sm:grid-cols-3 gap-3"></div>
    </div>
  </div>

  <!-- Step 3 — Publish -->
  <div data-project-wizard-target="step" class="hidden bg-white rounded-b-lg border border-t-0 border-stone-border p-6 space-y-5">
    <div class="space-y-1">
      <h3 class="text-sm font-semibold text-charcoal"><%= t(".publish_title") %></h3>
      <p class="text-xs text-zinc-500"><%= t(".publish_intro") %></p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5" role="radiogroup" aria-label="<%= t('.publish_title') %>">
      <label class="relative flex flex-col justify-between p-4 rounded-lg border border-stone-200 cursor-pointer transition-all hover:border-stone-400 has-[:checked]:border-charcoal has-[:checked]:ring-1 has-[:checked]:ring-charcoal has-[:checked]:bg-stone-50/50 group">
        <%= f.radio_button :visibility, "public", checked: true, class: "sr-only peer" %>
        <div class="space-y-1.5">
          <div class="flex items-center justify-between">
            <span class="text-sm font-semibold text-charcoal flex items-center gap-1.5">
              <i data-lucide="globe" class="w-4 h-4 text-brand"></i>
              <span><%= t(".public_label") %></span>
            </span>
            <span class="w-4 h-4 rounded-full border border-stone-300 peer-checked:border-charcoal peer-checked:bg-charcoal flex items-center justify-center transition-colors">
              <span class="w-1.5 h-1.5 rounded-full bg-white opacity-0 peer-checked:opacity-100 transition-opacity"></span>
            </span>
          </div>
          <p class="text-xs text-zinc-500 leading-relaxed"><%= t(".public_hint") %></p>
        </div>
      </label>

      <label class="relative flex flex-col justify-between p-4 rounded-lg border border-stone-200 cursor-pointer transition-all hover:border-stone-400 has-[:checked]:border-charcoal has-[:checked]:ring-1 has-[:checked]:ring-charcoal has-[:checked]:bg-stone-50/50 group">
        <%= f.radio_button :visibility, "draft", class: "sr-only peer" %>
        <div class="space-y-1.5">
          <div class="flex items-center justify-between">
            <span class="text-sm font-semibold text-charcoal flex items-center gap-1.5">
              <i data-lucide="lock" class="w-4 h-4 text-zinc-400"></i>
              <span><%= t(".draft_label") %></span>
            </span>
            <span class="w-4 h-4 rounded-full border border-stone-300 peer-checked:border-charcoal peer-checked:bg-charcoal flex items-center justify-center transition-colors">
              <span class="w-1.5 h-1.5 rounded-full bg-white opacity-0 peer-checked:opacity-100 transition-opacity"></span>
            </span>
          </div>
          <p class="text-xs text-zinc-500 leading-relaxed"><%= t(".draft_hint") %></p>
        </div>
      </label>
    </div>
  </div>

  <!-- Fixed Bottom Navigation Bar (aligned with wizard column) -->
  <div class="fixed bottom-0 inset-x-0 z-40 bg-white/95 backdrop-blur-xs border-t border-stone-200 py-3.5 px-5 shadow-[0_-4px_16px_rgba(0,0,0,0.03)] pb-[max(0.875rem,env(safe-area-inset-bottom))]">
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
      <!-- Wizard Column Actions (aligned directly under the form) -->
      <div class="flex items-center justify-between gap-4 lg:pr-3">
        <button type="button"
                data-project-wizard-target="previousButton"
                data-action="project-wizard#previous"
                class="hidden inline-flex items-center gap-1.5 text-sm font-medium text-zinc-600 hover:text-charcoal hover:bg-stone-100 px-3.5 py-2 rounded-lg transition-colors cursor-pointer">
          <i data-lucide="arrow-left" class="w-4 h-4"></i>
          <span><%= t(".previous") %></span>
        </button>

        <div class="hidden sm:flex items-center gap-2 text-xs text-zinc-500 font-medium select-none" data-project-wizard-target="stepIndicator">
          <span>Etapa 1 de <%= steps.size %>: <%= steps[0] %></span>
        </div>

        <div class="flex items-center gap-3 ml-auto">
          <button type="button"
                  data-project-wizard-target="nextButton"
                  data-action="project-wizard#next"
                  class="inline-flex items-center gap-1.5 bg-charcoal hover:bg-zinc-800 text-white px-5 py-2.5 rounded-lg text-sm font-medium transition-colors cursor-pointer shadow-sm">
            <span><%= t(".next") %></span>
            <i data-lucide="arrow-right" class="w-4 h-4"></i>
          </button>

          <div data-project-wizard-target="submitActions" class="hidden">
            <%= f.submit t(".save_project"),
                         class: "bg-charcoal hover:bg-zinc-800 text-white px-6 py-2.5 rounded-lg text-sm font-medium transition-colors cursor-pointer shadow-sm" %>
          </div>
        </div>
      </div>

      <!-- Preview Column spacer (keeps the preview half clean and calm) -->
      <div class="hidden lg:block"></div>
    </div>
  </div>
<% end %>
